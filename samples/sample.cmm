// C-- sample
/* block comment */
int square(int n) {
    return n * n;
}

void main() {
    int total = 0;
    float ratio = 2.5;
    bool done = false;
    char mark = 0;
    for (int i = 0; i < 10; i = i + 1) {
        if (i > 5) {
            break;
        } else {
            total = total + square(i);
            continue;
        }
    }
    while (total > 1_000) {
        total = total - 100;
    }
    print("total is ", total);
}
