# formula_test.deor
# Exercises the spreadsheet formula evaluator through
# spreadsheet_evaluate_formula: arithmetic, precedence, cell references and
# the #ERR / #REF / #DIV/0 results.

import "lib/string.deor"
import "lib/convert.deor"
import "lib/math.deor"
import "lib/list.deor" where T = string
import "lib/string_extension.deor"
import "lib/list.deor" where T = float
import "src/spreadsheet/calculation/spreadsheet_display_row/spreadsheet_evaluate_formula/formula_resolve/formula_operand.deor"
import "src/spreadsheet/calculation/spreadsheet_display_row/spreadsheet_evaluate_formula/formula_resolve/read_token_as_sign_or_number.deor"
import "src/spreadsheet/calculation/spreadsheet_display_row/spreadsheet_evaluate_formula/formula_resolve/read_token_as_operator_between_numbers.deor"
import "src/spreadsheet/calculation/spreadsheet_display_row/spreadsheet_evaluate_formula/formula_resolve/formula_group.deor"
import "src/spreadsheet/calculation/spreadsheet_display_row/spreadsheet_evaluate_formula/formula_combine/apply_level_operator_or_save_for_later.deor"
import "src/spreadsheet/calculation/spreadsheet_display_row/spreadsheet_evaluate_formula/formula_resolve.deor"
import "src/spreadsheet/calculation/spreadsheet_display_row/spreadsheet_evaluate_formula/formula_tokens.deor"
import "src/spreadsheet/calculation/spreadsheet_display_row/spreadsheet_evaluate_formula/formula_combine.deor"
import "src/spreadsheet/calculation/spreadsheet_display_row/spreadsheet_evaluate_formula.deor"

fn string eval_no_cells(string formula)
	floatList left_values = empty
	return spreadsheet_evaluate_formula(formula, left_values)

fn void test_addition()
	print(eval_no_cells("=1+2"))

fn void test_multiplication_before_addition()
	print(eval_no_cells("=2+3*4"))

fn void test_parentheses_override_precedence()
	print(eval_no_cells("=(2+3)*4"))

fn void test_divide_by_zero()
	print(eval_no_cells("=1/0"))

fn void test_garbage_is_an_error()
	print(eval_no_cells("=1+"))

fn void test_negative_applies_after_power()
	print(eval_no_cells("=-2^2"))

fn void test_cell_reference()
	float five = 5.0
	floatList left_values = [five]
	formula as "=c1*2"
	print(spreadsheet_evaluate_formula(formula, left_values))

fn void test_missing_cell_reference()
	float five = 5.0
	floatList left_values = [five]
	formula as "=c3"
	print(spreadsheet_evaluate_formula(formula, left_values))

fn void main()
	test_addition()
	test_multiplication_before_addition()
	test_parentheses_override_precedence()
	test_divide_by_zero()
	test_garbage_is_an_error()
	test_negative_applies_after_power()
	test_cell_reference()
	test_missing_cell_reference()

# expect:
# 3
# 14
# 20
# #DIV/0
# #ERR
# -4
# 10
# #REF
