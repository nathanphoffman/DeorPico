# string_extension_test.deor
# Exercises lib/string_extension.deor: word lookup at a cursor.

import "lib/string.deor"
import "lib/string_extension.deor"

fn void test_word_at_inside_word()
	line_a as "foo_bar baz"
	int two = 2
	int eight = 8
	print(s_word_at(line_a, two))
	print(s_word_at(line_a, eight))

fn void test_word_at_stops_at_punctuation()
	line_b as "foo(bar)"
	int three = 3
	print(s_word_at(line_b, three))

fn void test_word_at_cursor_after_word()
	line_c as "foo bar"
	int three = 3
	print(s_word_at(line_c, three))

fn void test_word_at_blank_line()
	line_d as "   "
	int one = 1
	print(s_word_at(line_d, one))

fn void main()
	test_word_at_inside_word()
	test_word_at_stops_at_punctuation()
	test_word_at_cursor_after_word()
	test_word_at_blank_line()

# expect:
# foo_bar
# baz
# foo
# foo
#
