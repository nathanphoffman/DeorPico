# Syntax highlighter.
#
# The tokenizer -- scope stack, tag scoping, sub-grammars, token assembly --
# lives in Deor below. What stays in Rust is the regex layer and a couple of
# byte-level string primitives Deor has no way to express: compiled regexes
# are exactly what `raw` exists for (see the spec's Types page), and regex
# match offsets are byte offsets, which Deor's char-based s_substring cannot
# safely index with.
#
# The current line being scanned is parked inside the handle rather than
# passed to each shim. Deor clones every argument at the call site, so a
# `string line` parameter on a function called a few hundred times per line
# would copy the whole line each time.

raw Highlighter

rust
	// Rc<RefCell<..>> rather than Arc<Mutex<..>>: the tokenizer calls back in
	// several times per scan position, and an uncontended mutex lock is still
	// ~20ns of pure overhead on the render path. The highlighter is created
	// and used entirely inside the render loop (see main.deor's
	// init_highlight_state) and never crosses a thread.
	struct HlState {
		regexes: Vec<regex::Regex>,
		// The host grammar's rules, and one further rule list per sub-grammar.
		rules: Vec<HlRule>,
		sub_meta: Vec<SubMeta>,
		sub_rules: Vec<Vec<HlRule>>,
		// Where xs_add_* appends: -1 = the host list, i = sub_rules[i]. Set by
		// xs_sub_begin, cleared by xs_sub_end -- that is what lets an existing
		// grammar macro (highlights_yaml) be replayed verbatim into a
		// sub-grammar instead of being duplicated there.
		target: i64,
		// line_state[row] is the scope stack in effect at the START of that
		// row -- populated by a full-file scan in xs_run so xs_line can color
		// an arbitrary row on its own without re-scanning everything before it.
		line_state: Vec<Vec<Frame>>,
		line: String,
		tab_width: i64,
		jsx_expr: bool,
	}

	#[derive(Clone)]
	struct Highlighter(std::rc::Rc<std::cell::RefCell<HlState>>);

	// A bare tag pattern like `</?[A-Za-z][A-Za-z0-9_.]*` is genuinely
	// ambiguous in TS/TSX source: `Array<string>` and `useState<Foo>()` match
	// it just as well as an actual JSX tag does, and the regex crate has no
	// lookbehind to rule those out directly. Instead the match is required to
	// be glued onto one of a handful of "an expression can start here"
	// characters (or the start of the line) -- something a generic's opening
	// "<" is never preceded by, since it's always glued to the preceding
	// identifier/call/keyword instead. The prefix is matched but not part of
	// capture group 1, so callers only see the tag's own span.
	//
	// This guard is only used for *entering* tag scanning from ordinary code
	// (Code/CodeChild/Expr/InTag). Once already inside JSX text there's no
	// generic-vs-tag ambiguity left to resolve, so tag detection there uses
	// the plain, unguarded pattern.
	fn build_guarded_tag_pattern(pattern: &str) -> String {
		format!(r#"(?:^|[\s(){{}}\[\],;:?=&|!~+])({})"#, pattern)
	}

# ---------------------------------------------------------------------------
# Types
# ---------------------------------------------------------------------------

# Token colors, interned at rule-registration time. Rules carry a ColorId
# rather than a color name so that HlRule holds nothing but enums, ints and
# bools -- cloning a rule list (which Deor does on every call that takes one)
# is then a flat memcpy with no string allocations.
enum ColorId
	NoColor
	KeywordHue
	StringHue
	CommentHue
	NumberHue
	TypeHue
	FunctionHue
	MacroHue
	InvalidHue
	HeadingHue
	QuoteHue
	BoldHue
	ItalicHue
	StrikeHue
	ImageHue
	LinkHue
	MathHue
	BlockHue
	BreakHue
	ListHue

# A rule is tried in registration order. At any given scan position the match
# with the earliest start wins; ties go to whichever rule was registered first
# -- this is what lets a rule like "call site" beat a later, broader "type"
# rule on the same text.
#
# TagRule is a variant of KeywordRule used only by markup grammars (tsx/jsx/
# vue/html/astro) registered through xs_add_tag; it also enables tag scoping.
# KeywordCapRule colors only capture group 1 of its pattern: the regex crate
# has no lookbehind, so a rule that may only fire after some preceding
# character -- yaml's "{ key:" / ", key:" inside a flow mapping -- has to match
# that character too, and this keeps it out of the colored span.
enum RuleKind
	KeywordRule
	KeywordCapRule
	BoundedRule
	TagRule

# Per-row scope stack for markup grammars. CodeFrame is the permanent floor
# (index 0), never popped -- everything else nests on top of it.
#
#   CodeFrame       ordinary scanning with the full rule list (the only state
#                   for every grammar that never registers a tag rule)
#   CodeChildFrame  like CodeFrame but poppable -- <script>/<style> bodies, so
#                   they keep full code highlighting instead of going inert
#   TextFrame       inside a tag's children (JSX/HTML text) -- no rule other
#                   than a tag start, a text-reentrant bounded start, or (when
#                   jsx_expr is on) a bare '{' applies here, which is what
#                   keeps stray quotes/apostrophes/capitalized words in prose
#                   from being read as code
#   InTagFrame      inside "<Name ...", scanning attributes, watching for the
#                   tag's own unescaped '>' or '/>'
#   ExprFrame       inside a JSX `{...}` expression entered from text;
#                   expr_depth tracks unmatched '{' so nested object literals
#                   don't pop it early
#   BoundedFrame    inside a bounded region (string/comment/mustache/...),
#                   frame_idx is the rule index within the active rule list
#   SubFrame        inside a sub-grammar region (yaml frontmatter in a .md
#                   file); frame_idx indexes the sub-grammar list, and scanning
#                   continues with that sub-grammar's own rules
enum FrameKind
	CodeFrame
	CodeChildFrame
	TextFrame
	InTagFrame
	ExprFrame
	BoundedFrame
	SubFrame

# What won the match contest at a scan position.
enum HitKind
	HitNone
	HitKeyword
	HitBounded
	HitTag
	HitBrace
	HitCloseAngle
	HitBraceOpen
	HitBraceClose
	HitSubOpen
	HitSubClose

struct RxMatch
	bool rx_found
	int rx_start
	int rx_stop

struct BytePos
	bool byte_found
	int byte_idx

struct SubRef
	bool sub_active
	int sub_slot

struct HlRule
	RuleKind rule_kind
	ColorId rule_color
	int main_rx
	int stop_rx
	int guard_rx
	bool escapable
	bool text_reentrant

shape ruleList = list of HlRule

# A sub-grammar is a second, complete rule list that takes over inside a
# delimited region. YAML frontmatter in a markdown file is the motivating
# case, but nothing here is specific to it. first_row_only exists because a
# markdown frontmatter fence is only a fence on line 1 -- the identical "---"
# further down a document is a horizontal rule or a setext heading underline,
# and must not open a bogus region.
struct SubMeta
	ColorId sub_color
	int sub_start_rx
	int sub_stop_rx
	bool first_row_only

shape subMetaList = list of SubMeta

struct Frame
	FrameKind frame_kind
	bool tag_closing
	string tag_name
	int expr_depth
	int frame_idx

shape frameList = list of Frame
shape frameListList = list of frameList

struct Token
	string tok_text
	ColorId tok_color

shape tokenList = list of Token

struct TokenizeResult
	tokenList out_tokens
	frameList out_stack

struct Best
	HitKind hit_kind
	int hit_start
	int hit_stop
	int hit_rule
	int hit_sub

struct HlConfig
	int cfg_tab_width
	bool cfg_jsx_expr

# Deor caps a function at three parameters, so the tokenizer's per-line and
# per-position context travel as structs.
#
# Grammar is everything hl_tokenize_line needs for one line; Spot is the
# per-position part. Spot is all scalars, so it is free to clone -- which
# matters, because Deor clones every argument at the call site and the match
# helpers are called a few times per scan position. For the same reason each
# helper takes only the list it actually reads: handing the rule list to the
# sub-grammar probes, which never look at it, cost an allocation per probe.
struct Grammar
	ruleList gr_host
	subMetaList gr_subs
	int gr_row
	int gr_len
	bool gr_jsx
	bool gr_tokens

struct Spot
	int spot_pos
	int spot_row
	bool spot_jsx
	bool spot_in_tag
	bool spot_in_expr
	bool spot_in_code
	bool spot_in_sub
	int spot_sub

struct StopSpec
	int stop_slot
	bool stop_escapable
	int stop_from

struct BoundedSpec
	string name
	string start
	string stop

# ---------------------------------------------------------------------------
# Rust shims -- the regex layer and byte-level string access
# ---------------------------------------------------------------------------

fn Highlighter xs_make(int tab_width)
	rust
		Highlighter(std::rc::Rc::new(std::cell::RefCell::new(HlState {
			regexes: Vec::new(),
			rules: Vec::new(),
			sub_meta: Vec::new(),
			sub_rules: Vec::new(),
			target: -1,
			line_state: Vec::new(),
			line: String::new(),
			tab_width: tab_width,
			jsx_expr: false,
		})))

# Compiles a pattern into the handle's regex bank and returns its slot.
fn int hl_rx_add(Highlighter hlt, string pattern)
	rust
		{
			let re = regex::Regex::new(pattern.as_str()).unwrap();
			let mut st = hlt.0.borrow_mut();
			st.regexes.push(re);
			(st.regexes.len() - 1) as i64
		}

# The guarded form of a tag pattern -- see build_guarded_tag_pattern.
fn int hl_rx_add_guarded(Highlighter hlt, string pattern)
	rust
		{
			let guarded = build_guarded_tag_pattern(pattern.as_str());
			let re = regex::Regex::new(guarded.as_str()).unwrap();
			let mut st = hlt.0.borrow_mut();
			st.regexes.push(re);
			(st.regexes.len() - 1) as i64
		}

# Earliest match of a bank regex at or after `pos` in the parked line.
fn RxMatch hl_rx_find(Highlighter hlt, int slot, int pos)
	rust
		{
			let st = hlt.0.borrow();
			let start = pos as usize;
			if start > st.line.len() {
				RxMatch { rx_found: false, rx_start: 0, rx_stop: 0 }
			} else {
				match st.regexes[slot as usize].find_at(st.line.as_str(), start) {
					Some(m) => RxMatch { rx_found: true, rx_start: m.start() as i64, rx_stop: m.end() as i64 },
					None => RxMatch { rx_found: false, rx_start: 0, rx_stop: 0 },
				}
			}
		}

# Same, but reports only capture group 1's span -- used by KeywordCapRule and
# by the guarded tag patterns.
fn RxMatch hl_rx_group(Highlighter hlt, int slot, int pos)
	rust
		{
			let st = hlt.0.borrow();
			let start = pos as usize;
			if start > st.line.len() {
				RxMatch { rx_found: false, rx_start: 0, rx_stop: 0 }
			} else {
				match st.regexes[slot as usize].captures_at(st.line.as_str(), start).and_then(|c| c.get(1)) {
					Some(g) => RxMatch { rx_found: true, rx_start: g.start() as i64, rx_stop: g.end() as i64 },
					None => RxMatch { rx_found: false, rx_start: 0, rx_stop: 0 },
				}
			}
		}

fn RxMatch hl_no_match()
	rust
		RxMatch { rx_found: false, rx_start: 0, rx_stop: 0 }

# Parks the line every subsequent shim call reads, and returns its byte length.
fn int hl_set_line(Highlighter hlt, string line)
	rust
		{
			let mut st = hlt.0.borrow_mut();
			st.line = line;
			st.line.len() as i64
		}

fn string hl_slice(Highlighter hlt, int start, int stop)
	rust
		{
			let st = hlt.0.borrow();
			st.line[(start as usize)..(stop as usize)].to_string()
		}

fn BytePos hl_find_byte(Highlighter hlt, string needle, int from)
	rust
		{
			let st = hlt.0.borrow();
			let start = from as usize;
			let hit = if start <= st.line.len() { st.line[start..].find(needle.as_str()) } else { None };
			match hit {
				Some(rel) => BytePos { byte_found: true, byte_idx: (start + rel) as i64 },
				None => BytePos { byte_found: false, byte_idx: 0 },
			}
		}

fn bool hl_byte_is(Highlighter hlt, int idx, string chr)
	rust
		{
			let st = hlt.0.borrow();
			let bytes = st.line.as_bytes();
			let at = idx as usize;
			at < bytes.len() && !chr.is_empty() && bytes[at] == chr.as_bytes()[0]
		}

# Tabs are expanded to real tab stops (not a flat N spaces) so the highlighted
# output stays in the same column space s_visual_col assumes when it maps
# cursor/click positions -- see src/consts.deor's TAB_WIDTH. Kept in Rust: a
# Deor version would have to allocate a String per character.
fn string hl_expand_tabs(string line, int tab_width)
	rust
		{
			let width = tab_width as usize;
			let mut out = String::with_capacity(line.len());
			let mut col: usize = 0;
			for ch in line.chars() {
				if ch == '\t' {
					let next_col = (col / width + 1) * width;
					for _ in col..next_col {
						out.push(' ');
					}
					col = next_col;
				} else {
					out.push(ch);
					col += 1;
				}
			}
			out
		}

# Appends to whichever rule list xs_sub_begin/xs_sub_end has made current.
fn Highlighter hl_add_rule(Highlighter hlt, HlRule rule)
	rust
		{
			{
				let mut st = hlt.0.borrow_mut();
				let target = st.target;
				if target < 0 {
					st.rules.push(rule);
				} else {
					st.sub_rules[target as usize].push(rule);
				}
			}
			hlt
		}

# Registers a sub-grammar and makes it the current append target.
fn Highlighter hl_add_sub(Highlighter hlt, SubMeta meta)
	rust
		{
			{
				let mut st = hlt.0.borrow_mut();
				st.sub_meta.push(meta);
				st.sub_rules.push(Vec::new());
				st.target = (st.sub_meta.len() - 1) as i64;
			}
			hlt
		}

fn Highlighter hl_clear_target(Highlighter hlt)
	rust
		{
			hlt.0.borrow_mut().target = -1;
			hlt
		}

fn Highlighter hl_enable_jsx(Highlighter hlt)
	rust
		{
			hlt.0.borrow_mut().jsx_expr = true;
			hlt
		}

fn ruleList hl_host_rules(Highlighter hlt)
	rust
		hlt.0.borrow().rules.clone()

fn ruleList hl_sub_rules(Highlighter hlt, int slot)
	rust
		hlt.0.borrow().sub_rules[slot as usize].clone()

fn subMetaList hl_sub_metas(Highlighter hlt)
	rust
		hlt.0.borrow().sub_meta.clone()

fn HlConfig hl_config(Highlighter hlt)
	rust
		{
			let st = hlt.0.borrow();
			HlConfig { cfg_tab_width: st.tab_width, cfg_jsx_expr: st.jsx_expr }
		}

fn frameList hl_state_at(Highlighter hlt, int row)
	rust
		{
			let st = hlt.0.borrow();
			match st.line_state.get(row as usize) {
				Some(frames) => frames.clone(),
				None => vec![Frame {
					frame_kind: FrameKind::CodeFrame,
					tag_closing: false,
					tag_name: String::new(),
					expr_depth: 0,
					frame_idx: 0,
				}],
			}
		}

fn Highlighter hl_state_store(Highlighter hlt, frameListList states)
	rust
		{
			hlt.0.borrow_mut().line_state = states;
			hlt
		}

# Deor string literals have no \x1b escape (see the spec's Strings page), so
# the escape byte itself comes from here; which color goes with which token is
# decided in Deor by hl_color_code.
fn string hl_ansi(string body)
	rust
		format!("\x1b[{}m", body)

# ---------------------------------------------------------------------------
# Colors
# ---------------------------------------------------------------------------

# Grammar files register rules with a color *name*; this interns it once, at
# registration time, so the tokenizer never carries strings around.
fn ColorId hl_color_id(string name)
	keyword_name as "keyword"
	string_name as "string"
	comment_name as "comment"
	number_name as "number"
	type_name as "type"
	function_name as "function"
	macro_name as "macro_name"
	invalid_name as "invalid"
	heading_name as "heading"
	quote_name as "quote"
	bold_name as "bold"
	italic_name as "italic"
	strike_name as "strikethrough"
	image_name as "image"
	link_name as "link"
	math_name as "math"
	block_name as "block"
	break_name as "linebreak"
	list_name as "list"

	ColorId out = NoColor
	if name is keyword_name
		out = KeywordHue
	else if name is string_name
		out = StringHue
	else if name is comment_name
		out = CommentHue
	else if name is number_name
		out = NumberHue
	else if name is type_name
		out = TypeHue
	else if name is function_name
		out = FunctionHue
	else if name is macro_name
		out = MacroHue
	else if name is invalid_name
		out = InvalidHue
	else if name is heading_name
		out = HeadingHue
	else if name is quote_name
		out = QuoteHue
	else if name is bold_name
		out = BoldHue
	else if name is italic_name
		out = ItalicHue
	else if name is strike_name
		out = StrikeHue
	else if name is image_name
		out = ImageHue
	else if name is link_name
		out = LinkHue
	else if name is math_name
		out = MathHue
	else if name is block_name
		out = BlockHue
	else if name is break_name
		out = BreakHue
	else if name is list_name
		out = ListHue
	return out

# Matches VS Code's default "Dark+" theme token colors (truecolor, not the
# 16-color ANSI palette) so highlighting looks the same as the VS Code editor.
fn string hl_color_code(ColorId color)
	empty_code as ""
	keyword_body as "38;2;198;120;221"
	string_body as "38;2;206;145;120"
	comment_body as "38;2;106;153;85"
	number_body as "38;2;181;206;168"
	type_body as "38;2;78;201;176"
	function_body as "38;2;156;220;254"
	macro_body as "38;2;125;176;203"
	invalid_body as "38;2;244;71;71"
	heading_body as "1;38;2;86;156;214"
	quote_body as "3;38;2;106;153;85"
	bold_body as "1"
	italic_body as "3"
	strike_body as "9"
	link_body as "4;38;2;86;156;214"

	string body = empty_code
	if color is KeywordHue
		body = keyword_body
	else if color is StringHue
		body = string_body
	else if color is CommentHue
		body = comment_body
	else if color is NumberHue
		body = number_body
	else if color is TypeHue
		body = type_body
	else if color is FunctionHue
		body = function_body
	else if color is MacroHue
		body = macro_body
	else if color is InvalidHue
		body = invalid_body
	else if color is HeadingHue
		body = heading_body
	else if color is QuoteHue
		body = quote_body
	else if color is BoldHue
		body = bold_body
	else if color is ItalicHue
		body = italic_body
	else if color is StrikeHue
		body = strike_body
	else if color is ImageHue
		body = type_body
	else if color is LinkHue
		body = link_body
	else if color is MathHue
		body = number_body
	else if color is BlockHue
		body = string_body
	else if color is BreakHue
		body = comment_body
	else if color is ListHue
		body = keyword_body

	if body is empty_code
		return empty_code
	string code = hl_ansi(body)
	return code

