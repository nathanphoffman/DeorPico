# Frame constructors
# ---------------------------------------------------------------------------

fn Frame hl_frame_code()
	FrameKind frame_kind = CodeFrame
	bool tag_closing = false
	string tag_name = ""
	int expr_depth = 0
	int frame_idx = 0
	Frame out = (frame_kind, tag_closing, tag_name, expr_depth, frame_idx)
	return out

fn Frame hl_frame_child()
	FrameKind frame_kind = CodeChildFrame
	bool tag_closing = false
	string tag_name = ""
	int expr_depth = 0
	int frame_idx = 0
	Frame out = (frame_kind, tag_closing, tag_name, expr_depth, frame_idx)
	return out

fn Frame hl_frame_text()
	FrameKind frame_kind = TextFrame
	bool tag_closing = false
	string tag_name = ""
	int expr_depth = 0
	int frame_idx = 0
	Frame out = (frame_kind, tag_closing, tag_name, expr_depth, frame_idx)
	return out

fn Frame hl_frame_tag(bool closing, string name)
	FrameKind frame_kind = InTagFrame
	bool tag_closing = closing
	string tag_name = name
	int expr_depth = 0
	int frame_idx = 0
	Frame out = (frame_kind, tag_closing, tag_name, expr_depth, frame_idx)
	return out

fn Frame hl_frame_expr(int depth)
	FrameKind frame_kind = ExprFrame
	bool tag_closing = false
	string tag_name = ""
	int expr_depth = depth
	int frame_idx = 0
	Frame out = (frame_kind, tag_closing, tag_name, expr_depth, frame_idx)
	return out

fn Frame hl_frame_bounded(int slot)
	FrameKind frame_kind = BoundedFrame
	bool tag_closing = false
	string tag_name = ""
	int expr_depth = 0
	int frame_idx = slot
	Frame out = (frame_kind, tag_closing, tag_name, expr_depth, frame_idx)
	return out

fn Frame hl_frame_sub(int slot)
	FrameKind frame_kind = SubFrame
	bool tag_closing = false
	string tag_name = ""
	int expr_depth = 0
	int frame_idx = slot
	Frame out = (frame_kind, tag_closing, tag_name, expr_depth, frame_idx)
	return out

# ---------------------------------------------------------------------------
# Scanning helpers
# ---------------------------------------------------------------------------

# The sub-grammar in effect for a scope stack: the nearest enclosing SubFrame
# wins, otherwise the host grammar. A SubFrame is only ever popped by its own
# stop pattern, so every frame nested above one belongs to that sub-grammar --
# including bounded frames, whose stored rule index is relative to whichever
# list opened them.
fn SubRef hl_active_sub(frameList stack)
	bool sub_active = false
	int sub_slot = 0
	int count = len(stack)
	for back in range(count)
		int probe_idx = count - back
		probe_idx = probe_idx - 1
		Frame probe = stack at probe_idx
		(frame_kind, frame_idx) in probe
		if frame_kind is SubFrame
			sub_active = true
			sub_slot = frame_idx
			break
	SubRef out = (sub_active, sub_slot)
	return out

# True when the byte at `pos` is preceded by an odd number of backslashes --
# the same convention as backslash-escaped string literals.
fn bool hl_is_escaped(Highlighter hlt, int pos)
	backslash as "\\"
	int count = 0
	int idx = pos
	for if idx > 0
		int prev = idx - 1
		bool is_slash = hl_byte_is(hlt, prev, backslash)
		if is_slash is false
			break
		count = count + 1
		idx = prev
	int rem = count % 2
	bool odd = rem is 1
	return odd

# Earliest non-escaped occurrence of a bounded region's stop pattern at or
# after `from`. Escaped occurrences are skipped over.
fn RxMatch hl_find_stop(Highlighter hlt, StopSpec spec)
	(stop_slot, stop_escapable, stop_from) in spec
	RxMatch out = hl_no_match()
	int scan = stop_from
	for if true
		RxMatch hit = hl_rx_find(hlt, stop_slot, scan)
		(rx_found, rx_start, rx_stop) in hit
		if rx_found is false
			break
		bool skip = false
		if stop_escapable
			skip = hl_is_escaped(hlt, rx_start)
		if skip
			scan = rx_start + 1
			continue
		out = hit
		break
	return out

# "<Foo" / "</Foo" -> "foo" -- used to tell an opening tag from a closing one
# and, for opening tags, to special-case <script>/<style> bodies so they keep
# full code highlighting instead of going inert as markup text.
fn string hl_tag_body_lower(string matched)
	close_prefix as "</"
	bool is_closing = s_starts_with(matched, close_prefix)
	int start_at = 1
	if is_closing
		start_at = 2
	int stop_at = len(matched)
	string body = s_substring(matched, start_at, stop_at)
	string lowered = s_to_lower(body)
	return lowered

# HTML elements that never have children or a closing tag.
fn bool hl_is_void_tag(string name)
	void_list as "area,base,br,col,embed,hr,img,input,link,meta,param,source,track,wbr"
	comma as ","
	stringList void_tags = s_split(void_list, comma)
	int count = len(void_tags)
	for idx in range(count)
		string void_tag = void_tags at idx
		if name is void_tag
			return true
	return false

# Deliberately restricted candidate set: JSX/HTML text is not code, so nothing
# here runs the general keyword list -- that's exactly what let stray
# apostrophes/quotes and capitalized prose words get misread as code before.
fn Best hl_best_text(Highlighter hlt, ruleList rules, Spot spot)
	(spot_pos, spot_jsx) in spot
	bool found_any = false
	HitKind win_kind = HitNone
	int win_start = 0
	int win_stop = 0
	int win_rule = 0

	int count = len(rules)
	for idx in range(count)
		HlRule rule = rules at idx
		(rule_kind, main_rx, text_reentrant) in rule
		bool eligible = false
		if rule_kind is TagRule
			eligible = true
		else if rule_kind is BoundedRule
			eligible = text_reentrant
		if eligible
			RxMatch hit = hl_rx_find(hlt, main_rx, spot_pos)
			(rx_found, rx_start, rx_stop) in hit
			if rx_found
				bool better = false
				if found_any is false
					better = true
				else if rx_start < win_start
					better = true
				if better
					found_any = true
					win_start = rx_start
					win_stop = rx_stop
					win_rule = idx
					if rule_kind is TagRule
						win_kind = HitTag
					else
						win_kind = HitBounded

	if spot_jsx
		open_brace as "{"
		BytePos brace = hl_find_byte(hlt, open_brace, spot_pos)
		(byte_found, byte_idx) in brace
		if byte_found
			bool better = false
			if found_any is false
				better = true
			else if byte_idx < win_start
				better = true
			if better
				found_any = true
				win_kind = HitBrace
				win_start = byte_idx
				win_stop = byte_idx + 1

	HitKind hit_kind = win_kind
	int hit_start = win_start
	int hit_stop = win_stop
	int hit_rule = win_rule
	int hit_sub = 0
	Best out = (hit_kind, hit_start, hit_stop, hit_rule, hit_sub)
	return out

# CodeFrame, CodeChildFrame, InTagFrame, ExprFrame and SubFrame all scan with
# the full rule list -- InTagFrame additionally watches for the tag's own '>',
# ExprFrame additionally tracks bare '{'/'}' depth.
fn Best hl_best_code(Highlighter hlt, ruleList rules, Spot spot)
	(spot_pos, spot_jsx, spot_in_tag, spot_in_expr) in spot
	bool found_any = false
	HitKind win_kind = HitNone
	int win_start = 0
	int win_stop = 0
	int win_rule = 0

	int count = len(rules)
	for idx in range(count)
		HlRule rule = rules at idx
		(rule_kind, main_rx, guard_rx) in rule
		RxMatch hit = hl_no_match()
		if rule_kind is KeywordCapRule
			hit = hl_rx_group(hlt, main_rx, spot_pos)
		else if rule_kind is TagRule
			hit = hl_rx_group(hlt, guard_rx, spot_pos)
		else
			hit = hl_rx_find(hlt, main_rx, spot_pos)
		(rx_found, rx_start, rx_stop) in hit
		if rx_found
			bool better = false
			if found_any is false
				better = true
			else if rx_start < win_start
				better = true
			if better
				found_any = true
				win_start = rx_start
				win_stop = rx_stop
				win_rule = idx
				if rule_kind is BoundedRule
					win_kind = HitBounded
				else if rule_kind is TagRule
					win_kind = HitTag
				else
					win_kind = HitKeyword

	if spot_in_tag
		close_angle as ">"
		BytePos angle = hl_find_byte(hlt, close_angle, spot_pos)
		(byte_found, byte_idx) in angle
		if byte_found
			bool better = false
			if found_any is false
				better = true
			else if byte_idx < win_start
				better = true
			if better
				found_any = true
				win_kind = HitCloseAngle
				win_start = byte_idx
				win_stop = byte_idx + 1

	if spot_in_expr
		open_brace as "{"
		close_brace as "}"
		BytePos opened = hl_find_byte(hlt, open_brace, spot_pos)
		BytePos closed = hl_find_byte(hlt, close_brace, spot_pos)
		(byte_found, byte_idx) in opened
		bool brace_found = byte_found
		int brace_at = byte_idx
		bool brace_open = true
		(byte_found, byte_idx) in closed
		if byte_found
			if brace_found is false
				brace_found = true
				brace_at = byte_idx
				brace_open = false
			else if byte_idx < brace_at
				brace_at = byte_idx
				brace_open = false
		if brace_found
			bool better = false
			if found_any is false
				better = true
			else if brace_at < win_start
				better = true
			if better
				found_any = true
				win_start = brace_at
				win_stop = brace_at + 1
				if brace_open
					win_kind = HitBraceOpen
				else
					win_kind = HitBraceClose

	# a JSX attribute value like onClick={() => go()} -- step into it as an
	# expression so its "=>" isn't mistaken for the tag's closing ">"
	if spot_in_tag
		if spot_jsx
			open_brace as "{"
			BytePos opened = hl_find_byte(hlt, open_brace, spot_pos)
			(byte_found, byte_idx) in opened
			if byte_found
				bool better = false
				if found_any is false
					better = true
				else if byte_idx < win_start
					better = true
				if better
					found_any = true
					win_kind = HitBraceOpen
					win_start = byte_idx
					win_stop = byte_idx + 1

	HitKind hit_kind = win_kind
	int hit_start = win_start
	int hit_stop = win_stop
	int hit_rule = win_rule
	int hit_sub = 0
	Best out = (hit_kind, hit_start, hit_stop, hit_rule, hit_sub)
	return out

# Entering a sub-grammar is only possible from the host grammar's own top
# level -- not from inside a tag, an expression, or another sub-grammar.
# Returns HitNone when no region opens here.
fn Best hl_sub_open_hit(Highlighter hlt, subMetaList subs, Spot spot)
	(spot_pos, spot_row, spot_in_code) in spot

	bool found_any = false
	int win_start = 0
	int win_stop = 0
	int win_sub = 0

	if spot_in_code
		int count = len(subs)
		for idx in range(count)
			SubMeta meta = subs at idx
			(sub_start_rx, first_row_only) in meta
			bool skip = false
			if first_row_only
				if spot_row is not 0
					skip = true
			if skip is false
				RxMatch hit = hl_rx_find(hlt, sub_start_rx, spot_pos)
				(rx_found, rx_start, rx_stop) in hit
				if rx_found
					bool better = false
					if found_any is false
						better = true
					else if rx_start < win_start
						better = true
					if better
						found_any = true
						win_start = rx_start
						win_stop = rx_stop
						win_sub = idx

	HitKind hit_kind = HitNone
	if found_any
		hit_kind = HitSubOpen
	int hit_start = win_start
	int hit_stop = win_stop
	int hit_rule = 0
	int hit_sub = win_sub
	Best out = (hit_kind, hit_start, hit_stop, hit_rule, hit_sub)
	return out

# The open region's closing fence. Returns HitNone when it isn't here.
fn Best hl_sub_close_hit(Highlighter hlt, subMetaList subs, Spot spot)
	(spot_pos, spot_in_sub, spot_sub) in spot

	HitKind hit_kind = HitNone
	int hit_start = 0
	int hit_stop = 0
	int hit_rule = 0
	int hit_sub = spot_sub

	if spot_in_sub
		SubMeta meta = subs at spot_sub
		(sub_stop_rx) in meta
		RxMatch hit = hl_rx_find(hlt, sub_stop_rx, spot_pos)
		(rx_found, rx_start, rx_stop) in hit
		if rx_found
			hit_kind = HitSubClose
			hit_start = rx_start
			hit_stop = rx_stop

	Best out = (hit_kind, hit_start, hit_stop, hit_rule, hit_sub)
	return out

# Whichever of two candidates starts earlier, with `base` keeping ties -- the
# tokenizer's usual first-registered-wins rule.
fn Best hl_pick_earlier(Best base, Best other)
	(hit_kind, hit_start, hit_stop, hit_rule, hit_sub) in other
	HitKind other_kind = hit_kind
	int other_start = hit_start
	(hit_kind, hit_start, hit_stop, hit_rule, hit_sub) in base
	if other_kind is HitNone
		return base
	if hit_kind is HitNone
		return other
	if other_start < hit_start
		return other
	return base

# Same, but `other` also wins an exact tie. A sub-grammar's closing fence has
# to outrank anything its own rules matched at the same position, so that a
# grammar carrying a rule for the fence text -- yaml's "---" document marker,
# which is exactly the markdown frontmatter terminator -- can't swallow the
# close and run on to the end of the file.
fn Best hl_pick_at_or_earlier(Best base, Best other)
	(hit_kind, hit_start, hit_stop, hit_rule, hit_sub) in other
	HitKind other_kind = hit_kind
	int other_start = hit_start
	(hit_kind, hit_start, hit_stop, hit_rule, hit_sub) in base
	if other_kind is HitNone
		return base
	if hit_kind is HitNone
		return other
	if other_start <= hit_start
		return other
	return base

# ---------------------------------------------------------------------------
# The tokenizer
# ---------------------------------------------------------------------------

# Tokenizes one already-tab-expanded line, given whatever scope stack (if any)
# was left open by the previous line. Returns the colored spans plus the stack
# left open at the end of this line.
#
# For any grammar that never registers a tag rule, the stack never grows past
# its permanent CodeFrame floor and this behaves like a flat keyword/bounded
# scan -- the branching below only matters for markup grammars that opt into
# tag scoping via xs_add_tag/xs_enable_jsx_expr, and for grammars with a
# sub-grammar region.
fn TokenizeResult hl_tokenize_line(Highlighter hlt, Grammar gram, frameList start_stack)
	(gr_host, gr_subs, gr_row, gr_len, gr_jsx, gr_tokens) in gram

	tokenList out_tokens = empty
	frameList out_stack = start_stack
	int stack_size = len(out_stack)
	if stack_size is 0
		Frame floor_frame = hl_frame_code()
		out_stack at end = floor_frame

	SubRef opening_ref = hl_active_sub(out_stack)
	(sub_active, sub_slot) in opening_ref
	bool cur_in_sub = sub_active
	int cur_sub = sub_slot

	ruleList active = gr_host
	if cur_in_sub
		active = hl_sub_rules(hlt, cur_sub)

	int pos = 0
	for if pos < gr_len
		int top_idx = len(out_stack) - 1
		Frame top = out_stack at top_idx
		(frame_kind, tag_closing, tag_name, expr_depth, frame_idx) in top

		if frame_kind is BoundedFrame
			HlRule open_rule = active at frame_idx
			(rule_color, stop_rx, escapable) in open_rule
			int stop_slot = stop_rx
			bool stop_escapable = escapable
			int stop_from = pos
			StopSpec stop_spec = (stop_slot, stop_escapable, stop_from)
			RxMatch stop_hit = hl_find_stop(hlt, stop_spec)
			(rx_found, rx_start, rx_stop) in stop_hit
			int span_end = gr_len
			if rx_found
				span_end = rx_stop
			if gr_tokens
				string tok_text = hl_slice(hlt, pos, span_end)
				ColorId tok_color = rule_color
				Token tok = (tok_text, tok_color)
				out_tokens at end = tok
			pos = span_end
			if rx_found
				out_stack remove at top_idx

		else if frame_kind is TextFrame
			int spot_pos = pos
			int spot_row = gr_row
			bool spot_jsx = gr_jsx
			bool spot_in_tag = false
			bool spot_in_expr = false
			bool spot_in_code = false
			bool spot_in_sub = cur_in_sub
			int spot_sub = cur_sub
			Spot spot = (spot_pos, spot_row, spot_jsx, spot_in_tag, spot_in_expr, spot_in_code, spot_in_sub, spot_sub)
			Best best = hl_best_text(hlt, active, spot)
			(hit_kind, hit_start, hit_stop, hit_rule, hit_sub) in best

			if hit_kind is HitNone
				if gr_tokens
					string tok_text = hl_slice(hlt, pos, gr_len)
					ColorId tok_color = NoColor
					Token tok = (tok_text, tok_color)
					out_tokens at end = tok
				pos = gr_len
			else
				if hit_start > pos
					if gr_tokens
						string tok_text = hl_slice(hlt, pos, hit_start)
						ColorId tok_color = NoColor
						Token tok = (tok_text, tok_color)
						out_tokens at end = tok

				if hit_kind is HitTag
					string matched = hl_slice(hlt, hit_start, hit_stop)
					# a fragment ("<>" / "</>") matches with its ">" -- give
					# that back so the InTagFrame below closes on it normally
					fragment_close as ">"
					if s_ends_with(matched, fragment_close)
						hit_stop = hit_stop - 1
						matched = hl_slice(hlt, hit_start, hit_stop)
					close_prefix as "</"
					bool is_closing = s_starts_with(matched, close_prefix)
					string body_name = hl_tag_body_lower(matched)
					HlRule tag_rule = active at hit_rule
					(rule_color) in tag_rule
					if gr_tokens
						string tok_text = matched
						ColorId tok_color = rule_color
						Token tok = (tok_text, tok_color)
						out_tokens at end = tok
					Frame tag_frame = hl_frame_tag(is_closing, body_name)
					out_stack at end = tag_frame
					pos = hit_stop

				else if hit_kind is HitBounded
					HlRule bounded_rule = active at hit_rule
					(rule_color, stop_rx, escapable) in bounded_rule
					int stop_slot = stop_rx
					bool stop_escapable = escapable
					int stop_from = hit_stop
					StopSpec stop_spec = (stop_slot, stop_escapable, stop_from)
					RxMatch stop_hit = hl_find_stop(hlt, stop_spec)
					(rx_found, rx_start, rx_stop) in stop_hit
					int span_end = gr_len
					if rx_found
						span_end = rx_stop
					if gr_tokens
						string tok_text = hl_slice(hlt, hit_start, span_end)
						ColorId tok_color = rule_color
						Token tok = (tok_text, tok_color)
						out_tokens at end = tok
					pos = span_end
					if rx_found is false
						Frame bounded_frame = hl_frame_bounded(hit_rule)
						out_stack at end = bounded_frame

				else
					if gr_tokens
						string tok_text = hl_slice(hlt, hit_start, hit_stop)
						ColorId tok_color = NoColor
						Token tok = (tok_text, tok_color)
						out_tokens at end = tok
					int first_depth = 1
					Frame expr_frame = hl_frame_expr(first_depth)
					out_stack at end = expr_frame
					pos = hit_stop

		else
			int spot_pos = pos
			int spot_row = gr_row
			bool spot_jsx = gr_jsx
			bool spot_in_tag = false
			if frame_kind is InTagFrame
				spot_in_tag = true
			bool spot_in_expr = false
			if frame_kind is ExprFrame
				spot_in_expr = true
			bool spot_in_code = false
			if frame_kind is CodeFrame
				spot_in_code = true
			bool spot_in_sub = cur_in_sub
			int spot_sub = cur_sub
			Spot spot = (spot_pos, spot_row, spot_jsx, spot_in_tag, spot_in_expr, spot_in_code, spot_in_sub, spot_sub)

			Best scanned = hl_best_code(hlt, active, spot)
			Best opener = hl_sub_open_hit(hlt, gr_subs, spot)
			Best merged = hl_pick_earlier(scanned, opener)
			Best closer = hl_sub_close_hit(hlt, gr_subs, spot)
			Best best = hl_pick_at_or_earlier(merged, closer)
			(hit_kind, hit_start, hit_stop, hit_rule, hit_sub) in best

			if hit_kind is HitNone
				if gr_tokens
					string tok_text = hl_slice(hlt, pos, gr_len)
					ColorId tok_color = NoColor
					Token tok = (tok_text, tok_color)
					out_tokens at end = tok
				pos = gr_len
			else
				if hit_start > pos
					if gr_tokens
						string tok_text = hl_slice(hlt, pos, hit_start)
						ColorId tok_color = NoColor
						Token tok = (tok_text, tok_color)
						out_tokens at end = tok

				if hit_kind is HitSubOpen
					SubMeta opened_meta = gr_subs at hit_sub
					(sub_color) in opened_meta
					if gr_tokens
						string tok_text = hl_slice(hlt, hit_start, hit_stop)
						ColorId tok_color = sub_color
						Token tok = (tok_text, tok_color)
						out_tokens at end = tok
					pos = hit_stop
					Frame sub_frame = hl_frame_sub(hit_sub)
					out_stack at end = sub_frame
					cur_in_sub = true
					cur_sub = hit_sub
					active = hl_sub_rules(hlt, hit_sub)

				else if hit_kind is HitSubClose
					SubMeta closed_meta = gr_subs at cur_sub
					(sub_color) in closed_meta
					if gr_tokens
						string tok_text = hl_slice(hlt, hit_start, hit_stop)
						ColorId tok_color = sub_color
						Token tok = (tok_text, tok_color)
						out_tokens at end = tok
					pos = hit_stop
					int sub_top = len(out_stack) - 1
					out_stack remove at sub_top
					cur_in_sub = false
					cur_sub = 0
					active = hl_host_rules(hlt)

				else if hit_kind is HitKeyword
					HlRule word_rule = active at hit_rule
					(rule_color) in word_rule
					if gr_tokens
						string tok_text = hl_slice(hlt, hit_start, hit_stop)
						ColorId tok_color = rule_color
						Token tok = (tok_text, tok_color)
						out_tokens at end = tok
					pos = hit_stop

				else if hit_kind is HitBounded
					HlRule bounded_rule = active at hit_rule
					(rule_color, stop_rx, escapable) in bounded_rule
					int stop_slot = stop_rx
					bool stop_escapable = escapable
					int stop_from = hit_stop
					StopSpec stop_spec = (stop_slot, stop_escapable, stop_from)
					RxMatch stop_hit = hl_find_stop(hlt, stop_spec)
					(rx_found, rx_start, rx_stop) in stop_hit
					int span_end = gr_len
					if rx_found
						span_end = rx_stop
					if gr_tokens
						string tok_text = hl_slice(hlt, hit_start, span_end)
						ColorId tok_color = rule_color
						Token tok = (tok_text, tok_color)
						out_tokens at end = tok
					pos = span_end
					if rx_found is false
						Frame bounded_frame = hl_frame_bounded(hit_rule)
						out_stack at end = bounded_frame

				else if hit_kind is HitTag
					string matched = hl_slice(hlt, hit_start, hit_stop)
					# a fragment ("<>" / "</>") matches with its ">" -- give
					# that back so the InTagFrame below closes on it normally
					fragment_close as ">"
					if s_ends_with(matched, fragment_close)
						hit_stop = hit_stop - 1
						matched = hl_slice(hlt, hit_start, hit_stop)
					close_prefix as "</"
					bool is_closing = s_starts_with(matched, close_prefix)
					string body_name = hl_tag_body_lower(matched)
					HlRule tag_rule = active at hit_rule
					(rule_color) in tag_rule
					if gr_tokens
						string tok_text = matched
						ColorId tok_color = rule_color
						Token tok = (tok_text, tok_color)
						out_tokens at end = tok
					Frame tag_frame = hl_frame_tag(is_closing, body_name)
					out_stack at end = tag_frame
					pos = hit_stop

				else if hit_kind is HitCloseAngle
					if gr_tokens
						string tok_text = hl_slice(hlt, hit_start, hit_stop)
						ColorId tok_color = NoColor
						Token tok = (tok_text, tok_color)
						out_tokens at end = tok
					pos = hit_stop
					slash as "/"
					bool self_close = false
					if hit_start > 0
						int before = hit_start - 1
						self_close = hl_byte_is(hlt, before, slash)
					int tag_top = len(out_stack) - 1
					out_stack remove at tag_top
					if tag_closing
						# a real closing tag also ends the text/code-child
						# scope it belongs to -- never pop the permanent floor
						int depth_now = len(out_stack)
						if depth_now > 1
							int drop_idx = depth_now - 1
							out_stack remove at drop_idx
						SubRef after_pop = hl_active_sub(out_stack)
						(sub_active, sub_slot) in after_pop
						cur_in_sub = sub_active
						cur_sub = sub_slot
						active = hl_host_rules(hlt)
						if cur_in_sub
							active = hl_sub_rules(hlt, cur_sub)
					else if self_close is false
						# a self-closing tag has no children of its own --
						# only a real opening tag enters a new scope
						script_tag as "script"
						style_tag as "style"
						bool is_script = tag_name is script_tag
						bool is_style = tag_name is style_tag
						# HTML void elements (<br>, <img>, ...) never get a
						# closing tag either. Not applied to JSX, where they
						# must self-close and <Input> may be a component.
						bool is_void = false
						if gr_jsx is false
							is_void = hl_is_void_tag(tag_name)
						if is_void is false
							Frame child_frame = hl_frame_text()
							if is_script
								child_frame = hl_frame_child()
							else if is_style
								child_frame = hl_frame_child()
							out_stack at end = child_frame

				else if hit_kind is HitBraceOpen
					if gr_tokens
						string tok_text = hl_slice(hlt, hit_start, hit_stop)
						ColorId tok_color = NoColor
						Token tok = (tok_text, tok_color)
						out_tokens at end = tok
					pos = hit_stop
					int expr_top = len(out_stack) - 1
					Frame expr_frame = out_stack at expr_top
					(frame_kind, expr_depth) in expr_frame
					if frame_kind is ExprFrame
						int deeper = expr_depth + 1
						Frame updated = hl_frame_expr(deeper)
						out_stack at expr_top = updated
					else
						# opened from inside a tag's attributes -- nests on
						# top of the InTagFrame and pops back to it at "}"
						int attr_depth = 1
						Frame attr_expr = hl_frame_expr(attr_depth)
						out_stack at end = attr_expr

				else
					if gr_tokens
						string tok_text = hl_slice(hlt, hit_start, hit_stop)
						ColorId tok_color = NoColor
						Token tok = (tok_text, tok_color)
						out_tokens at end = tok
					pos = hit_stop
					int expr_top = len(out_stack) - 1
					Frame expr_frame = out_stack at expr_top
					(frame_kind, expr_depth) in expr_frame
					if frame_kind is ExprFrame
						int shallower = expr_depth - 1
						if shallower is 0
							out_stack remove at expr_top
						else
							Frame updated = hl_frame_expr(shallower)
							out_stack at expr_top = updated

	TokenizeResult result = (out_tokens, out_stack)
	return result

# ---------------------------------------------------------------------------
# Rule registration
# ---------------------------------------------------------------------------

fn Highlighter xs_add_keyword(Highlighter hlt, string name, string pattern)
	RuleKind rule_kind = KeywordRule
	ColorId rule_color = hl_color_id(name)
	int main_rx = hl_rx_add(hlt, pattern)
	int stop_rx = 0
	int guard_rx = 0
	bool escapable = false
	bool text_reentrant = false
	HlRule rule = (rule_kind, rule_color, main_rx, stop_rx, guard_rx, escapable, text_reentrant)

	return hl_add_rule(hlt, rule)

# Like xs_add_keyword, but only capture group 1 of the pattern is colored and
# consumed; anything the pattern matched before that group is left as plain
# text. The regex crate has no lookbehind, so this is how a rule expresses
# "only match here when preceded by X" without swallowing the X -- e.g. yaml's
# flow-mapping keys, which are only keys when they follow a "{" or a ",".
fn Highlighter xs_add_keyword_group(Highlighter hlt, string name, string pattern)
	RuleKind rule_kind = KeywordCapRule
	ColorId rule_color = hl_color_id(name)
	int main_rx = hl_rx_add(hlt, pattern)
	int stop_rx = 0
	int guard_rx = 0
	bool escapable = false
	bool text_reentrant = false
	HlRule rule = (rule_kind, rule_color, main_rx, stop_rx, guard_rx, escapable, text_reentrant)
	return hl_add_rule(hlt, rule)

fn Highlighter xs_add_bounded(Highlighter hlt, BoundedSpec spec, bool escapable)
	(name, start, stop) in spec
	RuleKind rule_kind = BoundedRule
	ColorId rule_color = hl_color_id(name)
	int main_rx = hl_rx_add(hlt, start)
	int stop_rx = hl_rx_add(hlt, stop)
	int guard_rx = 0
	bool text_reentrant = false
	HlRule rule = (rule_kind, rule_color, main_rx, stop_rx, guard_rx, escapable, text_reentrant)
	return hl_add_rule(hlt, rule)

# Like xs_add_bounded, but the region is also reachable from inside JSX/HTML
# text -- e.g. Vue's "{{ mustache }}" interpolation or an "<!-- -->" comment
# written directly in markup, as opposed to a JS string or comment, which must
# never open from inside plain text (that's the bug the scope stack exists to
# fix -- see hl_tokenize_line).
fn Highlighter xs_add_bounded_text(Highlighter hlt, BoundedSpec spec, bool escapable)
	(name, start, stop) in spec
	RuleKind rule_kind = BoundedRule
	ColorId rule_color = hl_color_id(name)
	int main_rx = hl_rx_add(hlt, start)
	int stop_rx = hl_rx_add(hlt, stop)
	int guard_rx = 0
	bool text_reentrant = true
	HlRule rule = (rule_kind, rule_color, main_rx, stop_rx, guard_rx, escapable, text_reentrant)
	return hl_add_rule(hlt, rule)

# Registers a tag rule (e.g. "</?[A-Za-z][A-Za-z0-9_.]*") for a markup
# grammar. Unlike xs_add_keyword this also enables tag scoping: a match pushes
# an InTagFrame that swallows the tag's attributes and, once its closing '>'
# is found, opens (or closes) a text scope for the tag's children.
fn Highlighter xs_add_tag(Highlighter hlt, string name, string pattern)
	RuleKind rule_kind = TagRule
	ColorId rule_color = hl_color_id(name)
	int main_rx = hl_rx_add(hlt, pattern)
	int stop_rx = 0
	int guard_rx = hl_rx_add_guarded(hlt, pattern)
	bool escapable = false
	bool text_reentrant = false
	HlRule rule = (rule_kind, rule_color, main_rx, stop_rx, guard_rx, escapable, text_reentrant)
	return hl_add_rule(hlt, rule)

# Opens a sub-grammar: a region, delimited by spec.start/spec.stop, whose
# contents are scanned with their own complete rule list rather than the host
# grammar's. Every xs_add_* call between here and the matching xs_sub_end goes
# into that list, so an existing grammar macro can simply be replayed inside:
#
#     highlighter = xs_sub_begin(highlighter, fm_spec, first_row_only)
#     macro_run highlights_yaml
#     highlighter = xs_sub_end(highlighter)
#
# spec.name colors the delimiter lines themselves. first_row_only restricts
# the opener to row 0 of the file, which is what distinguishes a markdown
# frontmatter fence from the horizontal rule that "---" means anywhere else.
fn Highlighter xs_sub_begin(Highlighter hlt, BoundedSpec spec, bool first_row_only)
	(name, start, stop) in spec
	ColorId sub_color = hl_color_id(name)
	int sub_start_rx = hl_rx_add(hlt, start)
	int sub_stop_rx = hl_rx_add(hlt, stop)
	SubMeta meta = (sub_color, sub_start_rx, sub_stop_rx, first_row_only)
	return hl_add_sub(hlt, meta)

# Closes the region opened by xs_sub_begin -- subsequent xs_add_* calls go
# back to the host grammar's own rule list.
fn Highlighter xs_sub_end(Highlighter hlt)
	return hl_clear_target(hlt)

# Lets a bare '{' inside JSX/TSX text start an embedded expression, which
# resumes full code scanning until its matching '}'. Only call this for
# grammars whose text content can hold `{expr}` -- tsx/jsx/astro. Vue's
# mustache interpolation uses `{{ }}` (a text-reentrant bounded rule instead),
# and html has no embedded-expression syntax at all.
fn Highlighter xs_enable_jsx_expr(Highlighter hlt)
	return hl_enable_jsx(hlt)

# ---------------------------------------------------------------------------
# Driving the highlighter
# ---------------------------------------------------------------------------

# Full-file scan: records the scope stack in effect at the start of every row
# so xs_line can later color an arbitrary row on its own without re-scanning
# everything before it.
fn Highlighter xs_run(Highlighter hlt, stringList lines)
	HlConfig config = hl_config(hlt)
	(cfg_tab_width, cfg_jsx_expr) in config
	ruleList gr_host = hl_host_rules(hlt)
	subMetaList gr_subs = hl_sub_metas(hlt)
	bool gr_jsx = cfg_jsx_expr

	# The full-file scan only needs each row's end-of-row scope stack.
	bool gr_tokens = false

	frameList stack = empty
	Frame floor_frame = hl_frame_code()
	stack at end = floor_frame

	frameListList states = empty
	int count = len(lines)
	for row in range(count)
		states at end = stack
		string line = lines at row
		string expanded = hl_expand_tabs(line, cfg_tab_width)
		int gr_len = hl_set_line(hlt, expanded)
		int gr_row = row
		Grammar gram = (gr_host, gr_subs, gr_row, gr_len, gr_jsx, gr_tokens)
		TokenizeResult scanned = hl_tokenize_line(hlt, gram, stack)
		(out_stack) in scanned
		stack = out_stack

	return hl_state_store(hlt, states)

# Colors a single row, starting from the scope stack xs_run recorded for it.
fn string xs_line(Highlighter hlt, int row, string line)
	HlConfig config = hl_config(hlt)
	(cfg_tab_width, cfg_jsx_expr) in config
	ruleList gr_host = hl_host_rules(hlt)
	subMetaList gr_subs = hl_sub_metas(hlt)
	bool gr_jsx = cfg_jsx_expr
	int gr_row = row

	string expanded = hl_expand_tabs(line, cfg_tab_width)
	int gr_len = hl_set_line(hlt, expanded)
	frameList start_stack = hl_state_at(hlt, row)
	bool gr_tokens = true
	Grammar gram = (gr_host, gr_subs, gr_row, gr_len, gr_jsx, gr_tokens)
	TokenizeResult scanned = hl_tokenize_line(hlt, gram, start_stack)
	(out_tokens) in scanned

	reset_body as "0"
	empty_code as ""
	string reset = hl_ansi(reset_body)
	stringList parts = empty
	for tok in out_tokens
		(tok_text, tok_color) in tok
		string code = hl_color_code(tok_color)
		if code is empty_code
			parts at end = tok_text
		else
			parts at end = code
			parts at end = tok_text
			parts at end = reset

	string out = s_join(parts)
	return out
