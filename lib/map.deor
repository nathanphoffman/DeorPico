raw StringMap

shape stringList = list of string

rust
	#[derive(Clone, Debug)]
	struct StringMap(std::sync::Arc<std::sync::Mutex<std::collections::HashMap<String, String>>>);

	// Two maps are "equal" only if they are the very same shared map --
	// comparing contents would mean locking and walking every entry, and
	// the only reason this exists is so state structs holding one can derive PartialEq.
	impl PartialEq for StringMap {
		fn eq(&self, other: &Self) -> bool {
			std::sync::Arc::ptr_eq(&self.0, &other.0)
		}
	}

fn StringMap h_make()
	rust
		StringMap(std::sync::Arc::new(std::sync::Mutex::new(std::collections::HashMap::new())))

fn StringMap h_set(StringMap map, string key, string val)
	rust
		{ map.0.lock().unwrap().insert(key, val); map }

fn string h_get(StringMap map, string key)
	rust
		map.0.lock().unwrap().get(&key).cloned().unwrap_or_default()

fn bool h_has(StringMap map, string key)
	rust
		map.0.lock().unwrap().contains_key(&key)

fn StringMap h_remove(StringMap map, string key)
	rust
		{ map.0.lock().unwrap().remove(&key); map }

fn int h_size(StringMap map)
	rust
		map.0.lock().unwrap().len() as i64

fn stringList h_keys(StringMap map)
	rust
		map.0.lock().unwrap().keys().cloned().collect()

fn stringList h_values(StringMap map)
	rust
