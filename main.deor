import "imports.deor"

# Parses argv into a LaunchArgs (filename/initial_dir/lint_command/lint_regex)
# and opens the editor, producing the initial `state`. unsafe_macro because
# `filename` and `state` need to outlive this call for main() to use.
unsafe_macro parse_launch_args
	(first, second, third, input_list) in args()
	string filename = ""
	string initial_dir = "."
	if first is not ""
		if f_is_dir(first)
			initial_dir = first
		else
			initial_dir = f_dirname(first)
			filename = first
	if second is not ""
		initial_dir = second

	string lint_command = third
	string lint_regex = ""
	if len(input_list) > 3
		lint_regex = input_list at 3

	LaunchArgs launch = (filename, initial_dir, lint_command, lint_regex)
	AppState state = editor_open(launch)

# Without this, a panic mid-render (e.g. a bad byte index into a UTF-8
# line) kills the process while the terminal is still in raw/alt-screen
# mode, which looks like a full lockup instead of a crash with a
# visible message.
macro install_panic_crash_handler
	rust
		{
			let default_hook = std::panic::take_hook();
			std::panic::set_hook(Box::new(move |info| {
				xt_raw_off();
				default_hook(info);
			}));
		}

	xt_raw_on()

# Seeds the highlighter state that render_frame's "did the file change"
# check compares against on the first frame. unsafe_macro because these
# four variables need to outlive this call for render_frame to mutate.
unsafe_macro init_highlight_state
	string current_file = filename
	string ext = resolve_highlight_ext(current_file)
	Highlighter highlighter = initialize_highlighter(ext)
	stringList last_highlighted_lines = empty

# Resets the highlighter (and its cache of already-colored lines) when the
# active file changes, so render_frame's re-tokenize step below re-runs
# against the new file instead of comparing it to the old one's cache.
macro refresh_highlighter_for_file_change
	if filename is not current_file
		current_file = s_join([filename])
		ext = resolve_highlight_ext(current_file)
		highlighter = initialize_highlighter(ext)
		stringList cleared_highlighted_lines = empty
		last_highlighted_lines = cleared_highlighted_lines

# Raw lines, before tab-expansion, so the on-screen cursor/selection columns
# can be derived to match what the syntax highlighter does to the displayed text below.
# unsafe_macro because cursor_visual_col/sel_anchor_visual_col need to
# outlive this call for draw_frame to use.
unsafe_macro compute_cursor_visual_columns
	string raw_cursor_line = lines at cursor_row
	int cursor_visual_col = s_visual_col(raw_cursor_line, cursor_col, TAB_WIDTH)

	string raw_anchor_line = lines at sel_anchor_row
	int sel_anchor_visual_col = s_visual_col(raw_anchor_line, sel_anchor_col, TAB_WIDTH)

# Re-tokenizing the whole file on every keystroke (including plain cursor
# movement) is what made big files crawl -- only redo it when the content
# actually changed since the last frame.
macro rehighlight_if_dirty
	if lines is not last_highlighted_lines
		macro_run rehighlight_changed_rows
		stringList lines_snapshot = lines
		last_highlighted_lines = move lines_snapshot

# Re-scans only the rows an edit can have changed (see
# highlight_incremental.deor) -- the same result as xs_run over the whole
# file. Compares `lines` with last_highlighted_lines (the text the recorded
# stacks were computed from) in place, without copying either.
macro rehighlight_changed_rows
	int first_changed_row = 0
	int new_tail_start = 0
	int old_tail_start = 0
	rust
		{
			let old_rows = &last_highlighted_lines;
			let new_rows = &lines;
			let shortest = old_rows.len().min(new_rows.len());
			let mut same_head = 0;
			while same_head < shortest && old_rows[same_head] == new_rows[same_head] {
				same_head += 1;
			}
			let mut same_tail = 0;
			while same_tail < shortest - same_head && old_rows[old_rows.len() - 1 - same_tail] == new_rows[new_rows.len() - 1 - same_tail] {
				same_tail += 1;
			}
			first_changed_row = same_head as i64;
			new_tail_start = (new_rows.len() - same_tail) as i64;
			old_tail_start = (old_rows.len() - same_tail) as i64;
		}

	# Lines added past the old end have no recorded start stack of their own
	# -- redo the old last row, whose end stack they start from.
	if first_changed_row >= len(last_highlighted_lines) and first_changed_row > 0
		first_changed_row = len(last_highlighted_lines) - 1

	HlConfig scan_config = hl_config(highlighter)
	(cfg_tab_width, cfg_jsx_expr) in scan_config
	ruleList gr_host = hl_host_rules(highlighter)
	subMetaList gr_subs = hl_sub_metas(highlighter)
	bool gr_jsx = cfg_jsx_expr
	bool gr_tokens = false

	frameListList old_tail = hl_state_take_from(highlighter, first_changed_row)
	frameList stack = empty
	if len(old_tail) > 0
		stack = old_tail at 0
	else
		Frame floor_frame = hl_frame_code()
		stack at end = floor_frame

	int row_count = len(lines)
	int row = first_changed_row
	for if row < row_count
		highlighter = hl_state_push(highlighter, stack)
		string scan_line = lines at row
		string expanded = hl_expand_tabs(scan_line, cfg_tab_width)
		int gr_len = hl_set_line(highlighter, expanded)
		int gr_row = row
		Grammar gram = (gr_host, gr_subs, gr_row, gr_len, gr_jsx, gr_tokens)
		TokenizeResult scanned = hl_tokenize_line(highlighter, gram, stack)
		(out_stack) in scanned
		stack = out_stack
		row = row + 1

		# Past the edit, once the stack matches what was recorded for this
		# row before, every later row's recorded stack is still right.
		if row >= new_tail_start and row < row_count
			int old_row = old_tail_start + (row - new_tail_start)
			int tail_idx = old_row - first_changed_row
			if tail_idx < len(old_tail)
				frameList old_stack = old_tail at tail_idx
				if hl_frames_equal(stack, old_stack)
					highlighter = hl_state_append_from(highlighter, old_tail, tail_idx)
					break

# Draws whatever the current screen is. Expects the unpack_app_state locals;
# leaves `state` repacked when it returns.
macro draw_frame
	bool sheet_showing = spreadsheet_active and spreadsheet_view_active
	if commit_prompt_open
		macro_run repack_app_state
		commit_prompt_render(state)
	else if diffing
		# Undo history isn't read while drawing (see the normal path below).
		stringList raw_window = empty
		int window_start = 0
		UndoState saved_undo = move undo
		UndoHistory undo_history = new_undo_history()
		UndoHistory redo_history = new_undo_history()
		UndoState undo = move (undo_history, redo_history)
		RenderStash stash = move (raw_window, window_start, saved_undo)
		macro_run repack_app_state
		editor_render_diff(state)
		state = restore_after_render(move state, move stash)
	else if too_large
		macro_run repack_app_state
		editor_render_too_large(state, current_file)
	else if sheet_showing
		macro_run repack_app_state
		spreadsheet_render(state)
	else
		# Only color the rows that can actually be on screen this frame
		# (an over-estimate of view_rows, cheap and always safe) instead
		# of the whole file.
		TermSize term_size = xt_size()
		(rows) in term_size
		int total_line_count = len(lines)
		int start_row = scroll_row
		int end_row = scroll_row + rows
		if end_row > total_line_count
			end_row = total_line_count
		HighlightRange highlight_bounds = (start_row, end_row)

		# The draw copy of `lines` gets colored in place, so the real text
		# of those rows is set aside and put back afterwards. Undo history
		# is never read while drawing -- it's set aside too, and the draw
		# copy gets an empty one.
		stringList raw_window = empty
		for row_idx in range(start_row, end_row)
			raw_window at end = lines at row_idx
		int window_start = start_row
		UndoState saved_undo = move undo
		UndoHistory undo_history = new_undo_history()
		UndoHistory redo_history = new_undo_history()
		UndoState undo = move (undo_history, redo_history)
		RenderStash stash = move (raw_window, window_start, saved_undo)

		lines = get_highlighted_lines_range(move lines, highlighter, highlight_bounds)
		macro_run repack_app_state
		state = editor_render(move state, cursor_visual_col, sel_anchor_visual_col)
		state = restore_after_render(move state, move stash)

# Recomputes scroll, re-highlights if the buffer changed, and draws the
# current frame. Pulled out of main()'s loop so it can be called once before
# the first key is read (initial paint) and again only once per drained
# batch of input inside the loop, rather than once per individual event.
macro render_frame
	unsafe_macro_run use_consts

	state = editor_scroll(move state)
	unsafe_macro_run unpack_app_state
	(diffing) in diff
	(sel_anchor_row, sel_anchor_col) in selection
	(commit_prompt_open) in commit_prompt
	(spreadsheet_active, spreadsheet_view_active) in spreadsheet

	macro_run refresh_highlighter_for_file_change
	unsafe_macro_run compute_cursor_visual_columns
	macro_run rehighlight_if_dirty
	macro_run draw_frame

fn void main()

	unsafe_macro_run parse_launch_args
	macro_run install_panic_crash_handler
	unsafe_macro_run init_highlight_state

	macro_run render_frame

	for if true
		KeyEvent raw_key = xt_read_key()
		KeyEvent key = editor_translate_key(raw_key)
		(kind) in key

		# Only a lint job in flight can make a synthetic "tick" (see
		# xt_read_key's poll timeout) change anything visible -- it may
		# finish and post a notice (see apply_lint_poll_impl). An idle tick
		# with nothing running is a guaranteed no-op, so skip paying for a
		# render on it instead of redrawing the whole screen 6-7x/second
		# while the user isn't typing.
		#
		# `state` is taken apart by `move` to read these few flags -- reading
		# them with `(main_panel) in state` would copy the whole file and
		# undo history on every key.
		move (browser, main_panel, spreadsheet, commit_prompt, done, notice, error) in state
		(lint) in main_panel
		(lint_running) in lint
		bool was_lint_running = lint_running
		(commit_prompt_open) in commit_prompt
		(spreadsheet_active) in spreadsheet
		AppState loop_state = move (browser, main_panel, spreadsheet, commit_prompt, done, notice, error)
		state = loop_state

		# The commit screen (^L) takes every key while it's open (and the
		# key that opens it -- only worth the full check for those).
		bool prompt_owns_key = false
		if commit_prompt_open or kind is "commit_prompt"
			prompt_owns_key = commit_prompt_owns_key(state, key)
		if prompt_owns_key
			state = commit_prompt_handle_key(move state, key)
		else if spreadsheet_active
			macro_run spreadsheet_main_main
		else
			state = editor_handle_key_for_events(move state, key)
			macro_run spreadsheet_after_text_key
		(done) in state
		if done
			break

		if kind is "tick"
			if was_lint_running is false
				continue

		# Another event is already waiting -- handle it too before paying
		# for a render, so a burst of input (fast typing, a fast mouse
		# drag) collapses into one render for the whole backlog instead of
		# one per event (see xt_has_pending_input).
		if xt_has_pending_input()
			continue

		macro_run render_frame

	xt_raw_off()