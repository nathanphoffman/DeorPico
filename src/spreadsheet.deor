
# ^T -- swaps the main panel between the spreadsheet placeholder and the
# normal text editor for the currently open .csv. No-op on a non-.csv file
# (spreadsheet_active false) since there's nothing to swap to/from.
macro toggle_spreadsheet_view_impl
	if spreadsheet_active
		spreadsheet_view_active = not spreadsheet_view_active

# Keys/mouse while the spreadsheet view is showing (and the sidebar isn't
# focused) -- moves the highlighted cell. Only the app-wide actions that make
# sense without a text buffer run here; cut/paste/undo/etc. would silently
# edit the hidden text buffer behind the sheet, so they're skipped.
macro handle_spreadsheet_mode
	unsafe_macro_run use_consts
	TermSize term_size = xt_size()
	(rows) in term_size
	int view_rows = spreadsheet_view_rows(rows)

	if kind is "quit" or kind is "diff_toggle" or kind is "spreadsheet_view_toggle" or kind is "refresh"
		macro_run handle_global_actions
	else if kind is "up"
		spreadsheet_sel_row = spreadsheet_sel_row - 1
	else if kind is "down"
		spreadsheet_sel_row = spreadsheet_sel_row + 1
	else if kind is "left"
		spreadsheet_sel_col = spreadsheet_sel_col - 1
	else if kind is "right" or kind is "tab"
		spreadsheet_sel_col = spreadsheet_sel_col + 1
	else if kind is "page_up"
		spreadsheet_sel_row = spreadsheet_sel_row - view_rows
	else if kind is "page_down"
		spreadsheet_sel_row = spreadsheet_sel_row + view_rows
	else if kind is "home"
		spreadsheet_sel_col = 0
	else if kind is "mouse_down"
		macro_run mouse_down_editor_impl
	else if kind is "mouse_scroll_up"
		spreadsheet_scroll_row = spreadsheet_scroll_row - SCROLL_WHEEL_AMOUNT
	else if kind is "mouse_scroll_down"
		spreadsheet_scroll_row = spreadsheet_scroll_row + SCROLL_WHEEL_AMOUNT

	macro_run clamp_spreadsheet_selection

	# The wheel scrolls the sheet on its own without dragging the selection
	# along, same as the text editor -- everything else (key moves, clicks)
	# pulls the view back to wherever the selected cell is.
	if kind is "mouse_scroll_up" or kind is "mouse_scroll_down"
		int row_count = len(spreadsheet_rows)
		int max_scroll_row = row_count - view_rows
		if spreadsheet_scroll_row > max_scroll_row
			spreadsheet_scroll_row = max_scroll_row
		if spreadsheet_scroll_row < 0
			spreadsheet_scroll_row = 0
	else if kind is not "tick"
		macro_run scroll_spreadsheet_to_selection

# Keeps the selected cell inside the sheet -- rows can have different cell
# counts, so the column is bounded by the widest row rather than the
# selected row itself (short rows just draw empty cells past their end).
macro clamp_spreadsheet_selection
	int row_count = len(spreadsheet_rows)
	int column_count = spreadsheet_column_count(spreadsheet_rows)
	if spreadsheet_sel_row > row_count - 1
		spreadsheet_sel_row = row_count - 1
	if spreadsheet_sel_row < 0
		spreadsheet_sel_row = 0
	if spreadsheet_sel_col > column_count - 1
		spreadsheet_sel_col = column_count - 1
	if spreadsheet_sel_col < 0
		spreadsheet_sel_col = 0

# Scrolls just far enough that the selected cell is on screen, both
# vertically (rows) and horizontally (whole columns).
macro scroll_spreadsheet_to_selection
	TermSize term_size = xt_size()
	(cols, rows) in term_size
	int view_rows = spreadsheet_view_rows(rows)
	int content_width = spreadsheet_content_width(cols, rows, sidebar_focused)
	int visible_cols = spreadsheet_visible_columns(content_width)

	if spreadsheet_sel_row < spreadsheet_scroll_row
		spreadsheet_scroll_row = spreadsheet_sel_row
	if spreadsheet_sel_row > spreadsheet_scroll_row + view_rows - 1
		spreadsheet_scroll_row = spreadsheet_sel_row - view_rows + 1

	if spreadsheet_sel_col < spreadsheet_scroll_col
		spreadsheet_scroll_col = spreadsheet_sel_col
	if spreadsheet_sel_col > spreadsheet_scroll_col + visible_cols - 1
		spreadsheet_scroll_col = spreadsheet_sel_col - visible_cols + 1

# Selects the cell under a click -- `col` is already content-relative
# (mouse_down_editor_impl subtracts sidebar_width before calling in).
# Clicks on the status/notice rows or below the last data row are ignored.
macro spreadsheet_mouse_down
	unsafe_macro_run use_consts
	TermSize term_size = xt_size()
	(rows) in term_size
	int view_rows = spreadsheet_view_rows(rows)
	int clicked_row = spreadsheet_scroll_row + row
	int row_count = len(spreadsheet_rows)

	# Each cell is drawn as SEPARATOR + cell, so shifting past the leading
	# separator and dividing by the stride gives the column; a click on a
	# separator counts toward the cell to its left.
	int separator_width = len(SPREADSHEET_SEPARATOR)
	int cell_stride = SPREADSHEET_COLUMN_WIDTH + separator_width
	int cell_x = col - separator_width
	int clicked_col = spreadsheet_scroll_col
	if cell_x > 0
		clicked_col = spreadsheet_scroll_col + cell_x / cell_stride

	if row < view_rows and clicked_row < row_count
		spreadsheet_sel_row = clicked_row
		spreadsheet_sel_col = clicked_col

# Which file extensions open into the spreadsheet view instead of the
# normal text editor -- checked both at launch (state_init.deor) and on
# every mid-session file open (load_file_into_buffer in browser/keypress/browse_open.deor).
fn bool f_is_spreadsheet_ext(string ext)
	if ext is "csv"
		return true
	return false

# Whole-file parse, one line per row -- see csv_split_line for how each
# line is split into cells. A quoted field spanning multiple lines isn't
# supported yet (each line is still parsed on its own).
fn csvRowList csv_parse_rows(string path)
	stringList file_lines = f_lines(path)
	csvRowList rows = empty
	for line in file_lines
		stringList cells = csv_split_line(line)
		rows at end = cells
	return rows

# Splits one CSV line into cells: commas separate cells unless inside
# double quotes, the quotes themselves are dropped, and a doubled quote
# ("") inside a quoted cell is a literal " character.
fn stringList csv_split_line(string line)
	const string QUOTE = "\""
	const string COMMA = ","
	stringList line_chars = s_chars(line)
	int char_count = len(line_chars)

	stringList cells = empty
	string current = ""
	bool in_quotes = false
	bool skip_next = false
	for idx in range(char_count)
		if skip_next
			skip_next = false
		else
			string chr = line_chars at idx
			if in_quotes
				if chr is QUOTE
					int next_idx = idx + 1
					string next_chr = ""
					if next_idx < char_count
						next_chr = line_chars at next_idx
					if next_chr is QUOTE
						current = s_join([current, QUOTE])
						skip_next = true
					else
						in_quotes = false
				else
					current = s_join([current, chr])
			else if chr is QUOTE
				in_quotes = true
			else if chr is COMMA
				cells at end = current
				current = ""
			else
				current = s_join([current, chr])
	cells at end = current
	return cells

# Cell count of the widest row -- how many columns the sheet has.
fn int spreadsheet_column_count(csvRowList rows)
	int widest = 0
	for row_cells in rows
		int cell_count = len(row_cells)
		if cell_count > widest
			widest = cell_count
	return widest

# Screen rows available for sheet rows -- the spreadsheet view has no
# minimap, lint popup or search bar, just the status and notice lines.
fn int spreadsheet_view_rows(int rows)
	bool has_minimap = false
	bool lint_output_visible = false
	bool search_active = false
	int reserved_rows = editor_reserved_rows(has_minimap, lint_output_visible, search_active)
	return editor_view_rows(rows, reserved_rows)

# Screen columns right of the sidebar -- shared by the renderer and the
# scroll/mouse macros so they agree on what's actually drawn.
fn int spreadsheet_content_width(int cols, int rows, bool sidebar_focused)
	bool show_line_numbers = false
	bool lint_output_visible = false
	bool search_active = false
	int total_line_count = 0
	stringList diff_lines = empty
	EditorLayoutInput layout_input = (rows, cols, total_line_count, show_line_numbers, lint_output_visible, diff_lines, sidebar_focused, search_active)
	EditorLayout layout = compute_editor_layout(layout_input)
	(sidebar_width) in layout
	int content_width = cols - sidebar_width
	if content_width < 1
		content_width = 1
	return content_width

# How many whole cells fit in content_width (at least 1, so a very narrow
# terminal still scrolls one column at a time).
fn int spreadsheet_visible_columns(int content_width)
	unsafe_macro_run use_consts
	int separator_width = len(SPREADSHEET_SEPARATOR)
	int cell_stride = SPREADSHEET_COLUMN_WIDTH + separator_width
	int visible_cols = (content_width - separator_width) / cell_stride
	if visible_cols < 1
		visible_cols = 1
	return visible_cols
