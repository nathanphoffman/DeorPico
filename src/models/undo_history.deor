# Patch that turns `base` into `target`: the lines of `target` that sit
# between the lines the two have in common at the start and the end.
fn UndoPatch undo_make_patch(stringList target, stringList base)
	rust
		{
			let max_common = target.len().min(base.len());
			let mut prefix = 0;
			while prefix < max_common && target[prefix] == base[prefix] {
				prefix += 1;
			}
			let mut suffix = 0;
			while suffix < max_common - prefix && target[target.len() - 1 - suffix] == base[base.len() - 1 - suffix] {
				suffix += 1;
			}
			UndoPatch {
				patch_start: prefix as i64,
				patch_removed: target[prefix..target.len() - suffix].to_vec(),
				patch_added_len: (base.len() - prefix - suffix) as i64,
				patch_cursor_row: 0,
				patch_cursor_col: 0,
			}
		}

# `base` with the patch applied (see UndoPatch).
fn stringList undo_apply_patch(stringList base, UndoPatch patch)
	rust
		{
			let start = patch.patch_start as usize;
			let end = start + patch.patch_added_len as usize;
			let mut result: Vec<String> = Vec::with_capacity(base.len() - (end - start) + patch.patch_removed.len());
			result.extend_from_slice(&base[..start]);
			result.extend(patch.patch_removed.iter().cloned());
			result.extend_from_slice(&base[end..]);
			result
		}

fn UndoHistory new_undo_history()
	patchList history_patches = empty
	stringList history_top_lines = empty
	int history_top_row = 0
	int history_top_col = 0
	bool history_has_top = false
	UndoHistory history = move (history_patches, history_top_lines, history_top_row, history_top_col, history_has_top)
	return history

# Adds `point` as the newest entry. The entry that was newest until now is
# squashed down to a patch against it.
fn UndoHistory undo_history_push(UndoHistory history, UndoPoint point)
	move (history_patches, history_top_lines, history_top_row, history_top_col, history_has_top) in history
	move (point_lines, point_row, point_col) in point
	# Re-declared through a local copy -- the transpiler doesn't make an
	# unpacked variable mutable on an `at end` push / `remove at` alone.
	patchList patches_holder = move history_patches
	patchList history_patches = move patches_holder
	if history_has_top
		UndoPatch bare_patch = undo_make_patch(move history_top_lines, point_lines)
		(patch_start, patch_removed, patch_added_len) in bare_patch
		int patch_cursor_row = history_top_row
		int patch_cursor_col = history_top_col
		UndoPatch patch = move (patch_start, patch_removed, patch_added_len, patch_cursor_row, patch_cursor_col)
		history_patches at end = patch
		max_undo_depth as 250
		if len(history_patches) > max_undo_depth
			history_patches remove at 0
	history_top_lines = move point_lines
	history_top_row = point_row
	history_top_col = point_col
	history_has_top = true
	UndoHistory next_history = move (history_patches, history_top_lines, history_top_row, history_top_col, history_has_top)
	return next_history

# Removes and returns the newest entry; the one below it (rebuilt from its
# patch) becomes the newest.
fn UndoPop undo_history_pop(UndoHistory history)
	move (history_patches, history_top_lines, history_top_row, history_top_col, history_has_top) in history
	patchList patches_holder = move history_patches
	patchList history_patches = move patches_holder
	bool popped = history_has_top
	stringList point_lines = move history_top_lines
	int point_row = history_top_row
	int point_col = history_top_col
	stringList next_top_lines = empty
	int next_top_row = 0
	int next_top_col = 0
	bool next_has_top = false
	if popped and len(history_patches) > 0
		int last_idx = len(history_patches) - 1
		UndoPatch patch = history_patches at last_idx
		history_patches remove at last_idx
		(patch_cursor_row, patch_cursor_col) in patch
		next_top_lines = undo_apply_patch(point_lines, patch)
		next_top_row = patch_cursor_row
		next_top_col = patch_cursor_col
		next_has_top = true
	UndoPoint popped_point = move (point_lines, point_row, point_col)
	history_top_lines = move next_top_lines
	history_top_row = next_top_row
	history_top_col = next_top_col
	history_has_top = next_has_top
	UndoHistory popped_history = move (history_patches, history_top_lines, history_top_row, history_top_col, history_has_top)
	UndoPop result = move (popped_history, popped_point, popped)
	return result
