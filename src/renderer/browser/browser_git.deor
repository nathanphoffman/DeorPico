
fn entryList g_sort_entries_by_path(entryList entries)
	rust
		{
			let mut items = entries;
			items.sort_by(|a, b| a.path.to_lowercase().cmp(&b.path.to_lowercase()));
			items
		}

fn entryList g_changed_entries(StringMap git_map)
	stringList paths = h_keys(git_map)

	entryList items = empty

	for path in paths
		string git_status = h_get(git_map, path)

		if git_status is "ignored"
			continue

		string name = f_basename(path)
		bool is_dir = false
		int depth = 0
		bool expanded = false
		FileEntry entry = (name, path, is_dir, depth, expanded, git_status)
		items at end = entry

	return g_sort_entries_by_path(items)

# One sidebar row per past commit: name is the "<hash> <subject>" text shown,
# path holds just the hash (what sidebar_key_activate hands back to
# g_commit_file_entries), and git_status "past" is what paints the row pink.
fn entryList g_commit_entries(string repo_path)
	string raw_text = g_raw_log(repo_path)
	stringList log_lines = g_split_lines(raw_text)

	entryList items = empty

	for line in log_lines
		if line is ""
			continue

		string space = " "
		int space_idx = s_index_of(line, space)
		int zero_idx = 0
		string hash = line

		if space_idx > 0
			hash = s_substring(line, zero_idx, space_idx)

		string name = line
		string path = hash
		bool is_dir = false
		int depth = 0
		bool expanded = false
		string git_status = "past"
		FileEntry entry = (name, path, is_dir, depth, expanded, git_status)
		items at end = entry

	return items

# Files one past commit touched -- git_status is "past_new" / "past_deleted" /
# "past" (everything else) so the rows keep an added/removed hint while all
# staying pink. A rename/copy carries a second (new) path field -- the entry
# points at that one, since that's the file the commit's diff is under.
fn entryList g_commit_file_entries(string repo_path, string commit)
	string raw_text = g_raw_commit_files(repo_path, commit)
	stringList fields = g_split_status_entries(raw_text)
	int field_count = len(fields)
	int zero_idx = 0

	entryList items = empty
	int pos = 0

	for if pos + 1 < field_count
		string code = fields at pos
		string path = fields at (pos + 1)
		string letter = s_char_at(code, zero_idx)
		pos = pos + 2

		if letter is "R" or letter is "C"
			if pos < field_count
				path = fields at pos
				pos = pos + 1

		string name = f_basename(path)
		bool is_dir = false
		int depth = 0
		bool expanded = false
		string git_status = "past"

		if letter is "A"
			git_status = "past_new"
		else if letter is "D"
			git_status = "past_deleted"

		FileEntry entry = (name, path, is_dir, depth, expanded, git_status)
		items at end = entry

	return g_sort_entries_by_path(items)

# Strips a leading "./" so a FileEntry.path (always rooted at the browse
# dir, e.g. "./src/foo.rs") matches the plain-relative paths `git status`
# reports (e.g. "src/foo.rs").
fn string g_relative_path(string path)
	string dot_slash = "./"
	string clean = path

	if s_starts_with(path, dot_slash)
		int strip_len = 2
		int path_len = len(path)
		clean = s_substring(path, strip_len, path_len)

	return clean

# Tags each entry with its git status, looked up by its path relative to
# the browse dir. One exception: an ignored directory holding
# IGNORED_DIR_LIMIT entries or more is left untagged.
fn entryList g_apply_status(entryList entries, StringMap git_map)
	const int IGNORED_DIR_LIMIT = 50
	int ignored_dir_limit = IGNORED_DIR_LIMIT

	entryList result = empty

	for entry in entries
		(path, is_dir) in entry
		string clean = g_relative_path(path)
		string git_status = h_get(git_map, clean)

		if git_status is "ignored" and is_dir
			int entry_count = f_dir_entry_count(path)

			if entry_count >= ignored_dir_limit
				git_status = ""

		FileEntry updated = entry with (git_status)
		result at end = updated

	return result

# "+" flags a brand-new untracked file (git's "??"), "%" flags an unstaged
# edit on a file that's already tracked -- including a staged file with a
# further worktree edit on top ("staged_edited"), since that extra edit is
# always a modification, never a new file, once the path is already tracked.
# A staged file with no further edits gets neither (just plain green).
fn string browser_edit_prefix(string git_status)
	string prefix = ""

	if git_status is "new"
		prefix = "+"
	else if git_status is "edited"
		prefix = "%"
	else if git_status is "staged_edited"
		prefix = "%"
	else if git_status is "staged_renamed"
		prefix = ">"
	else if git_status is "conflict"
		prefix = "!"
	else if git_status is "past_new"
		prefix = "+"
	else if git_status is "past_deleted"
		prefix = "-"

	return prefix
