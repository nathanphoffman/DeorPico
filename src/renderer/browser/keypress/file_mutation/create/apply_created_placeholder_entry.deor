
# Turns the placeholder row into its real entry, then clears the
# name-entry prompt state and re-tags git status now that disk changed.
# Deliberately plain (not macro_block): `path` is left declared here on
# purpose so report_created_entry_result can reuse it for
# load_file_into_buffer right after.
#
# refresh_all_git_status is called by the caller (confirm_create_file,
# ../create_file.deor) right after this runs instead of from in here, for
# the same reason -- confirm_create_file is macro_block so it can absorb
# that call for free.
#
# The reset below is plain assignment, NOT a struct destructure -- `(field)
# in some_struct` always declares a fresh binding (see destructuring.md),
# which would just shadow-and-die instead of updating the caller's real
# creating_file/new_file_name/etc.
unsafe_macro apply_created_placeholder_entry
	FileEntry placeholder_entry = browse_entries at browse_selected
	string name = entry_name
	string path = full_path
	bool is_dir = is_dir_request
	FileEntry real_entry = placeholder_entry with (name, path, is_dir)
	browse_entries at browse_selected = real_entry

	creating_file = false
	renaming_file = false
	new_file_name = ""
	create_parent_dir = ""
	notice = ""
	error = false
