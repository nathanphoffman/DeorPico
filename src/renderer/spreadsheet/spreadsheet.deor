
# Spreadsheet view (opened for .csv files, see f_is_spreadsheet_ext) --
# renders the sidebar exactly like the normal editor view, and one
# spreadsheet_rows row per screen row in the content area, each column
# auto-sized to its data (see spreadsheet_column_widths), all read from
# the sheet's view cache (see sheet_view_cache.deor), scrolled so the
# selected cell stays visible (see scroll_spreadsheet_to_selection). Owns a
# full self-contained render path rather than sharing render_buffer_rows'
# fused loop, same as the diff view does (see editor_render_diff in
# diff_view.deor) -- the two views only ever differ in what goes in the
# content column, and duplicating that column's handful of lines is
# cheaper than threading a third render mode through the already-fragile
# row-fusion loop.
unsafe_macro setup_spreadsheet_view_layout
	TermSize term_size = xt_size()
	(cols, rows) in term_size
	int content_width = spreadsheet_content_width(cols, rows, sidebar_focused)
	int sidebar_width = cols - content_width
	int view_rows = spreadsheet_view_rows(rows)
	intList column_widths = sv_column_widths(spreadsheet_view_cache)

	string screen = ANSI_HOME

# Sidebar column piece for the current row_offset -- identical to the
# normal editor/diff views (see render_sidebar_column in
# render_buffer_rows.deor).
macro render_spreadsheet_sidebar_column
	SidebarRowInput row_input = (browse_entries, git_changes, git_section_rows, root_section_rows, browse_dir, git_section_collapsed, idx, selected_idx, sidebar_width, sidebar_focused, is_top_row, is_bottom_row, creating_file, new_file_name, new_file_cursor, filter_active, filter_matches)
	screen = s_join([screen, sidebar_row_piece(row_input)])

# The full-text popup (Ctrl+click / ^O): the selected cell's text wrapped
# into a bordered box centered over the sheet, titled with that column's
# header. Leaves modal_lines empty while the popup is closed --
# render_spreadsheet_row overlays modal_lines onto the rows it covers.
unsafe_macro setup_spreadsheet_modal
	stringList modal_lines = empty
	int modal_left = 0
	int modal_top = 0
	int modal_box_width = 0
	if spreadsheet_modal_open
		macro_run build_spreadsheet_modal

# The popup shows the cell's exact (unrounded) value -- only the selected
# row is worked out (the header never gets column formulas).
macro build_spreadsheet_modal
	int header_row = 0
	int exact_places = 0 - 1
	stringList sel_row_cells = spreadsheet_rows at spreadsheet_sel_row
	stringList modal_formulas = spreadsheet_column_formulas
	if spreadsheet_sel_row is header_row
		stringList no_formulas = empty
		modal_formulas = move no_formulas
	stringList exact_cells = spreadsheet_display_row(sel_row_cells, exact_places, modal_formulas)
	string modal_text = spreadsheet_cell_in_row(exact_cells, spreadsheet_sel_col)
	string modal_title = spreadsheet_cell_value(spreadsheet_rows, header_row, spreadsheet_sel_col)
	int inner_width = 0
	macro_run fit_modal_width_to_text
	macro_run add_modal_box_lines
	macro_run center_modal_on_sheet

# As narrow as the text needs (but room for the title), no wider than
# SPREADSHEET_MODAL_MAX_WIDTH or the sheet area itself.
macro fit_modal_width_to_text
	const int BORDER_WIDTH = 4
	macro_run widen_modal_for_text_and_title
	macro_run narrow_modal_to_fit_sheet
	modal_box_width = inner_width + BORDER_WIDTH

macro widen_modal_for_text_and_title
	const int MIN_INNER_WIDTH = 20
	int title_width = s_char_count(modal_title) + BORDER_WIDTH
	inner_width = s_char_count(modal_text)
	inner_width = m_max(inner_width, title_width)
	inner_width = m_max(inner_width, MIN_INNER_WIDTH)

macro narrow_modal_to_fit_sheet
	int max_inner_width = SPREADSHEET_MODAL_MAX_WIDTH - BORDER_WIDTH
	int fit_inner_width = content_width - BORDER_WIDTH - 2
	inner_width = m_min(inner_width, max_inner_width)
	inner_width = m_min(inner_width, fit_inner_width)
	if inner_width < 1
		inner_width = 1

macro add_modal_box_lines
	stringList body_lines = spreadsheet_wrap_text(modal_text, inner_width)
	macro_run cut_modal_body_to_screen
	macro_run add_modal_borders_around_body

# Rows past what fits on screen are dropped, with "…" on the last one kept.
macro cut_modal_body_to_screen
	int max_body_lines = view_rows - 2
	int body_count = len(body_lines)
	if body_count > max_body_lines and max_body_lines > 0
		stringList kept_lines = l_string_take(body_lines, max_body_lines)
		int last_kept = max_body_lines - 1
		string last_line = kept_lines at last_kept
		int cut_width = inner_width - 1
		string cut_line = spreadsheet_fit_cell(last_line, cut_width)
		kept_lines at last_kept = s_join([cut_line, "…"])
		body_lines = kept_lines

macro add_modal_borders_around_body
	const string FOOTER = "any key closes"
	bool is_top = true
	string top_border = spreadsheet_modal_border(modal_title, inner_width, is_top)
	is_top = false
	string bottom_border = spreadsheet_modal_border(FOOTER, inner_width, is_top)
	modal_lines at end = top_border
	for body_line in body_lines
		string padded_body = s_pad_right(body_line, inner_width)
		modal_lines at end = s_join(["│ ", padded_body, " │"])
	modal_lines at end = bottom_border

macro center_modal_on_sheet
	int modal_height = len(modal_lines)
	modal_left = (content_width - modal_box_width) / 2
	modal_top = (view_rows - modal_height) / 2
	if modal_top < 0
		modal_top = 0

# Content column piece for the screen row at sheet_offset below the
# settings row -- the cells of spreadsheet_rows at
# (spreadsheet_scroll_row + sheet_offset), starting from
# spreadsheet_scroll_col, each padded to its column's width between
# separators; blank once past the sheet's last row. Built as plain text
# first so truncating/padding to content_width works on character counts,
# then each colored cell's span gets its colors (or the popup's line
# drawn over it) afterward -- the selected cell, a highlighted column's
# numbers (see column_highlights.deor), and, while a .dpv column's formula
# is being edited, every other cell it fills (rows below the header with
# a number to its left).
macro render_spreadsheet_row
	int data_row = spreadsheet_scroll_row + sheet_offset
	intList span_starts = empty
	intList span_stops = empty
	stringList span_ons = empty
	stringList span_offs = empty
	string content = ""
	macro_run add_spreadsheet_row_cells
	content = spreadsheet_fit_line(content, content_width)
	macro_run color_spreadsheet_row
	screen = s_join([screen, content])

# Hidden columns (width 0) are skipped, with SPREADSHEET_HIDDEN_SEPARATOR
# drawn where they were.
macro add_spreadsheet_row_cells
	if data_row < spreadsheet_row_count
		stringList row_cells = sv_display_row(spreadsheet_view_cache, data_row)
		stringList level_row = sv_level_row(spreadsheet_view_cache, data_row)
		int first_col = spreadsheet_scroll_col
		int before_first = first_col - 1
		bool hidden_at_left = spreadsheet_column_is_hidden(spreadsheet_column_hidden, first_col) or spreadsheet_column_is_hidden(spreadsheet_column_hidden, before_first)
		content = s_join([SPREADSHEET_SEPARATOR])
		if hidden_at_left
			content = s_join([SPREADSHEET_HIDDEN_SEPARATOR])
		int content_x = s_char_count(SPREADSHEET_SEPARATOR)
		int start = spreadsheet_scroll_col
		int stop = spreadsheet_column_count_all
		for col_idx in range(start, stop)
			# Drawing stops once past the right edge -- the cell that
			# straddles it still shows its start.
			if content_x >= content_width
				break
			int col_width = column_widths at col_idx
			if col_width > 0
				macro_run add_spreadsheet_cell

# One cell padded to its column's width, then the separator after it --
# the hidden-column one if the next column is hidden.
macro add_spreadsheet_cell
	string cell_content = ""
	macro_run pick_spreadsheet_cell_content
	macro_run mark_cell_colors
	int next_col = col_idx + 1
	string separator = s_join([SPREADSHEET_SEPARATOR])
	if spreadsheet_column_is_hidden(spreadsheet_column_hidden, next_col)
		separator = s_join([SPREADSHEET_HIDDEN_SEPARATOR])
	content = s_join([content, cell_content, separator])
	int separator_width = s_char_count(SPREADSHEET_SEPARATOR)
	content_x = content_x + col_width + separator_width

# The edit text for the cell being typed into, otherwise its shown value
# cut to the column's width.
macro pick_spreadsheet_cell_content
	bool is_edit_cell = spreadsheet_editing and data_row is spreadsheet_sel_row and col_idx is spreadsheet_sel_col
	int cell_count = len(row_cells)
	if is_edit_cell
		cell_content = spreadsheet_edit_display(spreadsheet_edit_buffer, col_width)
	else if col_idx < cell_count
		string raw_cell = row_cells at col_idx
		string formatted_cell = format_cell(row_cells, raw_cell, col_idx)
		cell_content = spreadsheet_fit_cell(formatted_cell, col_width)
	cell_content = s_pad_right(cell_content, col_width)

# Queues this cell's colors, if it has any, for color_spreadsheet_row. A
# highlighted number keeps its color while selected (reverse video turns
# it into the background) or tinted.
macro mark_cell_colors
	string level = spreadsheet_cell_in_row(level_row, col_idx)
	string level_color = spreadsheet_highlight_color(level, esc)
	string span_on = ""
	string span_off = ""
	if data_row is spreadsheet_sel_row and col_idx is spreadsheet_sel_col
		macro_run pick_selected_cell_colors
	else if tint_formula_column and col_idx is spreadsheet_sel_col and data_row > 0
		macro_run tint_cell_if_formula_fills_it
	else if level_color is not ""
		span_on = level_color
		span_off = s_join([ANSI_DEFAULT_FG])
	if span_on is not ""
		span_starts at end = content_x
		span_stops at end = content_x + col_width
		span_ons at end = span_on
		span_offs at end = span_off

# Blue while typing into it (same as the search bar), reverse video while
# it's just selected.
macro pick_selected_cell_colors
	if spreadsheet_editing
		span_on = s_join([ANSI_SEARCH_BAR_BG])
		span_off = s_join([ANSI_DEFAULT_BG])
	else
		span_on = s_join([level_color, ANSI_REVERSE_ON])
		span_off = s_join([ANSI_REVERSE_OFF, ANSI_DEFAULT_FG])

macro tint_cell_if_formula_fills_it
	if spreadsheet_has_number_before(row_cells, col_idx)
		span_on = s_join([ANSI_COLUMN_TINT, level_color])
		span_off = s_join([ANSI_DEFAULT_BG, ANSI_DEFAULT_FG])

# The popup's line drawn over the row if it covers it (skipping the
# cell colors -- the popup has the focus), otherwise the cells queued by
# mark_cell_colors colored. Row 0 is always the header -- bolded, and
# never moved by sorting (see sort_spreadsheet_by_selected_column).
macro color_spreadsheet_row
	int modal_line_idx = sheet_offset - modal_top
	int modal_line_count = len(modal_lines)
	if modal_line_idx >= 0 and modal_line_idx < modal_line_count
		macro_run draw_modal_line_over_row
	else
		macro_run color_queued_spans
	if data_row is 0 and spreadsheet_row_count > 0
		content = s_join([ANSI_BOLD_ON, content, ANSI_BOLD_OFF])

# Wraps each span queued by mark_cell_colors in its on/off codes. Spans
# are in left-to-right order and don't overlap; one starting past the
# right edge is dropped, one straddling it is cut there.
macro color_queued_spans
	string colored = ""
	int written = 0
	int span_count = len(span_starts)
	for span_idx in range(span_count)
		int span_start = span_starts at span_idx
		if span_start >= content_width
			break
		macro_run add_queued_span
	string after_spans = s_substring(content, written, content_width)
	content = s_join([colored, after_spans])

macro add_queued_span
	int full_stop = span_stops at span_idx
	int span_stop = m_min(full_stop, content_width)
	string before_span = s_substring(content, written, span_start)
	string span_text = s_substring(content, span_start, span_stop)
	string span_on = span_ons at span_idx
	string span_off = span_offs at span_idx
	colored = s_join([colored, before_span, span_on, span_text, span_off])
	written = span_stop

macro draw_modal_line_over_row
	int line_start = 0
	string modal_line = modal_lines at modal_line_idx
	int modal_right = modal_left + modal_box_width
	string before_modal = s_substring(content, line_start, modal_left)
	string after_modal = s_substring(content, modal_right, content_width)
	content = s_join([before_modal, ANSI_STATUS_BG, modal_line, ANSI_DEFAULT_BG, after_modal])

# The settings value's colors when selected -- same as a selected cell
# (see pick_selected_cell_colors).
macro color_selected_span
	string span_on = s_join([ANSI_REVERSE_ON])
	string span_off = s_join([ANSI_REVERSE_OFF])
	if spreadsheet_editing
		span_on = s_join([ANSI_SEARCH_BAR_BG])
		span_off = s_join([ANSI_DEFAULT_BG])
	macro_run color_content_span

# Wraps content's characters span_start..span_stop (cut at content_width)
# in span_on / span_off.
macro color_content_span
	int line_start = 0
	int span_end = m_min(span_stop, content_width)
	string before_span = s_substring(content, line_start, span_start)
	string span_text = s_substring(content, span_start, span_end)
	string after_span = s_substring(content, span_end, content_width)
	content = s_join([before_span, span_on, span_text, span_off, after_span])

# The settings row pinned above the sheet -- "Round results to [2  ]
# decimal places", the number selectable and editable like a cell
# (spreadsheet_sel_row -1, see write_edit_into_round_setting).
macro render_spreadsheet_settings_row
	string places_text = c_int_to_string(spreadsheet_round_places)
	if spreadsheet_sel_row < 0 and spreadsheet_editing
		places_text = spreadsheet_edit_display(spreadsheet_edit_buffer, SPREADSHEET_PLACES_WIDTH)
	string content = spreadsheet_settings_text(places_text, spreadsheet_path)
	content = spreadsheet_fit_line(content, content_width)
	if spreadsheet_sel_row < 0
		macro_run color_selected_settings_value
	screen = s_join([screen, content])

# Same colors as a selected sheet cell.
macro color_selected_settings_value
	int span_start = s_char_count(SPREADSHEET_SETTINGS_LABEL)
	int span_stop = span_start + SPREADSHEET_PLACES_WIDTH
	if span_start < content_width
		macro_run color_selected_span

# What the sidebar column needs for every row -- leaked for
# render_spreadsheet_rows.
unsafe_macro setup_spreadsheet_sidebar_rows
	int git_count = len(git_changes)
	int git_section_rows = sidebar_git_section_rows(is_git_repo, git_count, git_section_collapsed)
	int root_section_rows = sidebar_root_section_rows()
	int selected_idx = git_section_rows + root_section_rows + browse_selected
	if sidebar_on_git
		selected_idx = 1 + git_selected
	else if sidebar_on_root
		selected_idx = git_section_rows
	bool filter_active = false
	filterMatchList filter_matches = empty

# Iterates every visible row, appending the sidebar column then the content
# column (the settings row on the first, sheet rows below it), same shape
# as render_buffer_rows' main loop.
macro render_spreadsheet_rows
	int spreadsheet_row_count = len(spreadsheet_rows)
	int spreadsheet_column_count_all = len(column_widths)
	int screen_rows = view_rows + 1
	for row_offset in range(screen_rows)
		macro_run render_spreadsheet_screen_row

macro render_spreadsheet_screen_row
	bool is_top_row = row_offset is 0
	bool is_bottom_row = row_offset is (screen_rows - 1)
	int idx = browse_scroll_row + row_offset
	macro_run render_spreadsheet_sidebar_column
	int sheet_offset = row_offset - 1
	if is_top_row
		macro_run render_spreadsheet_settings_row
	else
		macro_run render_spreadsheet_row
	screen = s_join([screen, ANSI_CRLF])

macro render_spreadsheet_status_and_notice
	macro_run render_spreadsheet_status_line
	macro_run render_spreadsheet_notice_line

macro render_spreadsheet_status_line
	string position_text = spreadsheet_position_text(spreadsheet_sel_row, spreadsheet_sel_col)
	string modified_text = ""
	if dirty
		modified_text = " [modified]"
	string hint_text = "Enter edit  Del clear  Shift+Up/Down sort  Alt+H highlight  Alt+X/U hide/unhide col  Header: Shift+Del/+/_ del/add col  ^O/Ctrl+click full text  ^Z/^Y undo/redo  ^S save  ^T text view"
	macro_run pick_spreadsheet_editing_hint
	string status_line = s_join(["-- ", spreadsheet_path, modified_text, " (spreadsheet) -- ", position_text, " -- ", hint_text])
	status_line = spreadsheet_fit_line(status_line, cols)
	screen = s_join([screen, status_line, ANSI_CRLF])

macro pick_spreadsheet_editing_hint
	if spreadsheet_editing
		hint_text = "editing -- Enter/Tab confirm  Esc cancel"
	if tint_formula_column
		hint_text = "editing the column's formula -- Enter/Tab confirm  Esc cancel  (no leading = makes it a normal column)"

# A .dpv with a formula in a row (see spreadsheet_invalid_dpv_reason) is
# flagged in red whenever nothing else is being said.
macro render_spreadsheet_notice_line
	string notice_text = notice
	string invalid_reason = sv_invalid_reason(spreadsheet_view_cache)
	bool show_invalid = notice_text is "" and invalid_reason is not ""
	if show_invalid
		notice_text = invalid_reason
	notice_text = spreadsheet_fit_line(notice_text, cols)
	if show_invalid
		notice_text = s_join([ANSI_ERROR_BG, notice_text, ANSI_DEFAULT_BG])
	screen = s_join([screen, notice_text])

fn void spreadsheet_render(AppState state)
	(browser) in state
	(sidebar_focused, browse_entries, browse_selected, browse_scroll_row, creating_file) in browser
	(new_file_name, new_file_cursor, browse_dir, is_git_repo, git_changes, sidebar_on_git, sidebar_on_root, git_selected, git_section_collapsed) in browser
	move (spreadsheet) in state
	move (spreadsheet_path, spreadsheet_rows, spreadsheet_sel_row, spreadsheet_sel_col, spreadsheet_scroll_row, spreadsheet_scroll_col, spreadsheet_editing, spreadsheet_edit_buffer, spreadsheet_modal_open, spreadsheet_round_places, spreadsheet_column_formulas, spreadsheet_column_highlights, spreadsheet_column_hidden, spreadsheet_view_cache) in spreadsheet
	(main_panel) in state
	(core) in main_panel
	(dirty) in core
	(notice) in state
	unsafe_macro_run use_spreadsheet_consts
	unsafe_macro_run use_ansi_codes

	unsafe_macro_run read_column_formula_edit
	bool tint_formula_column = spreadsheet_editing and is_column_formula_edit
	unsafe_macro_run setup_spreadsheet_view_layout
	unsafe_macro_run setup_spreadsheet_modal
	unsafe_macro_run setup_spreadsheet_sidebar_rows
	macro_run render_spreadsheet_rows
	macro_run render_spreadsheet_status_and_notice

	xt_flush_print(screen)

# What the cell being edited shows: the typed text plus a "_" cursor,
# keeping only the end of the text once it's wider than the column so the
# cursor stays in view.
fn string spreadsheet_edit_display(string edit_buffer, int col_width)
	const string CURSOR = "_"
	string shown = s_join([edit_buffer, CURSOR])
	int shown_count = s_char_count(shown)
	if shown_count > col_width
		int tail_start = shown_count - col_width
		shown = s_substring(shown, tail_start, shown_count)
	return shown

# Cuts a cell's text down to `col_width` characters, ending in "…" when
# anything was cut off.
fn string spreadsheet_fit_cell(string cell, int col_width)
	int cell_count = s_char_count(cell)
	if cell_count <= col_width
		return cell
	if col_width < 1
		return ""
	int text_start = 0
	int keep_count = col_width - 1
	string kept = s_substring(cell, text_start, keep_count)
	return s_join([kept, "…"])

# Splits `text` into lines of at most `width` characters, breaking between
# words where it can and mid-word only for a word longer than a whole line.
fn stringList spreadsheet_wrap_text(string text, int width)
	const string SPACE = " "
	stringList wrapped = empty
	string current = ""
	int current_count = 0
	stringList words = s_split(text, SPACE)
	for word in words
		string remaining = s_join([word])
		int word_count = s_char_count(remaining)
		for if word_count > width
			if current_count > 0
				wrapped at end = current
				current = ""
				current_count = 0
			int head_start = 0
			string head = s_substring(remaining, head_start, width)
			wrapped at end = head
			remaining = s_substring(remaining, width, word_count)
			word_count = word_count - width
		int joined_count = current_count + 1 + word_count
		if current_count is 0
			current = remaining
			current_count = word_count
		else if joined_count > width
			wrapped at end = current
			current = remaining
			current_count = word_count
		else
			current = s_join([current, SPACE, remaining])
			current_count = joined_count
	int wrapped_count = len(wrapped)
	if current_count > 0 or wrapped_count is 0
		wrapped at end = current
	return wrapped

# One horizontal border of the popup, `label` set into it near the left:
# "┌─ label ───┐" on top, "└─ label ───┘" on the bottom. Exactly
# inner_width + 4 characters, the same as each "│ text │" line.
fn string spreadsheet_modal_border(string label, int inner_width, bool is_top)
	string left_corner = "└─"
	string right_corner = "┘"
	if is_top
		left_corner = "┌─"
		right_corner = "┐"
	int label_room = inner_width - 1
	string fitted_label = spreadsheet_fit_cell(label, label_room)
	string label_part = s_join([" ", fitted_label, " "])
	int label_count = s_char_count(label_part)
	int fill_count = inner_width + 1 - label_count
	if fill_count < 0
		fill_count = 0
	string dash = "─"
	string fill = s_repeat(dash, fill_count)
	return s_join([left_corner, label_part, fill, right_corner])

# True if any of row_cells before col_idx is a number -- the cells a
# column formula fills.
fn bool spreadsheet_has_number_before(stringList row_cells, int col_idx)
	int cell_count = len(row_cells)
	int stop = m_min(col_idx, cell_count)
	for cell_idx in range(stop)
		string cell = row_cells at cell_idx
		string trimmed = s_trim(cell)
		if s_is_number(trimmed)
			return true
	return false

# The text color for a highlight level -- "1" very bad (red), "2" bad
# (orange), "3" average (yellow), "4" good (green), "5" very good (blue)
# -- or "" for none.
fn string spreadsheet_highlight_color(string level, string esc)
	string color_code = ""
	if level is "1"
		color_code = "196"
	else if level is "2"
		color_code = "208"
	else if level is "3"
		color_code = "226"
	else if level is "4"
		color_code = "46"
	else if level is "5"
		color_code = "39"
	if color_code is ""
		return ""
	return s_join([esc, "[38;5;", color_code, "m"])

# `text` cut or padded to exactly `width` characters.
fn string spreadsheet_fit_line(string text, int width)
	string fitted = text
	if s_char_count(text) > width
		int text_start = 0
		fitted = s_substring(text, text_start, width)
	return s_pad_right(fitted, width)

# "row 3, col 2" for the status line, or "settings" for the settings row.
fn string spreadsheet_position_text(int sel_row, int sel_col)
	if sel_row < 0
		return "settings"
	int display_row = sel_row + 1
	int display_col = sel_col + 1
	string row_text = c_int_to_string(display_row)
	string col_text = c_int_to_string(display_col)
	return s_join(["row ", row_text, ", col ", col_text])

# The settings row's text -- the label, the decimal places padded to their
# cell, and a note that a .csv doesn't keep it.
fn string spreadsheet_settings_text(string places_text, string spreadsheet_path)
	unsafe_macro_run use_spreadsheet_consts
	string places_cell = s_pad_right(places_text, SPREADSHEET_PLACES_WIDTH)
	string places_suffix = "] decimal places"
	if not spreadsheet_keeps_settings(spreadsheet_path)
		places_suffix = "] decimal places (not saved in a .csv)"
	return s_join([SPREADSHEET_SETTINGS_LABEL, places_cell, places_suffix])
