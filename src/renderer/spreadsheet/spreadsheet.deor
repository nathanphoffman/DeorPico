
# Spreadsheet view (opened for .csv files, see f_is_spreadsheet_ext) --
# renders the sidebar exactly like the normal editor view, and one
# spreadsheet_rows row per screen row in the content area, laid out in
# fixed-width cells (no per-column width computation yet), scrolled so the
# selected cell stays visible (see scroll_spreadsheet_to_selection). Owns a
# full self-contained render path rather than sharing render_buffer_rows'
# fused loop, same as the diff view does (see editor_render_diff in
# diff_view.deor) -- the two views only ever differ in what goes in the
# content column, and duplicating that column's handful of lines is
# cheaper than threading a third render mode through the already-fragile
# row-fusion loop.
unsafe_macro setup_spreadsheet_view_layout
	TermSize term_size = xt_size()
	(cols, rows) in term_size
	int content_width = spreadsheet_content_width(cols, rows, sidebar_focused)
	int sidebar_width = cols - content_width
	int visible_cols = spreadsheet_visible_columns(content_width)

	string screen = ANSI_HOME

# Sidebar column piece for the current row_offset -- identical to the
# normal editor/diff views (see render_sidebar_column in
# render_buffer_rows.deor).
macro render_spreadsheet_sidebar_column
	SidebarRowInput row_input = (browse_entries, git_changes, git_section_rows, root_section_rows, browse_dir, git_section_collapsed, idx, selected_idx, sidebar_width, sidebar_focused, is_top_row, is_bottom_row, creating_file, new_file_name, filter_active, filter_matches)
	screen = s_join([screen, sidebar_row_piece(row_input)])

# Content column piece for the current row_offset -- the cells of
# spreadsheet_rows at (spreadsheet_scroll_row + row_offset), starting from
# spreadsheet_scroll_col, each padded to SPREADSHEET_COLUMN_WIDTH between
# separators; blank once past the sheet's last row. Built as plain text
# first so truncating/padding to content_width can use len(), then the
# selected cell's span gets wrapped in reverse video afterward.
macro render_spreadsheet_row
	int separator_width = len(SPREADSHEET_SEPARATOR)
	int cell_stride = SPREADSHEET_COLUMN_WIDTH + separator_width
	int data_row = spreadsheet_scroll_row + row_offset

	string content = ""
	if data_row < spreadsheet_row_count
		stringList row_cells = spreadsheet_rows at data_row
		int cell_count = len(row_cells)

		# One extra column past what fully fits, so a partly visible cell
		# at the right edge still shows its start.
		int draw_count = spreadsheet_column_count_all - spreadsheet_scroll_col
		if draw_count > visible_cols + 1
			draw_count = visible_cols + 1

		content = s_join([SPREADSHEET_SEPARATOR])
		for draw_idx in range(draw_count)
			int col_idx = spreadsheet_scroll_col + draw_idx
			string cell_content = ""
			if col_idx < cell_count
				string raw_cell = row_cells at col_idx
				cell_content = format_cell(row_cells, raw_cell, col_idx)
			if len(cell_content) > SPREADSHEET_COLUMN_WIDTH
				cell_content = "ERROR"
			cell_content = s_pad_right(cell_content, SPREADSHEET_COLUMN_WIDTH)
			content = s_join([content, cell_content, SPREADSHEET_SEPARATOR])

	if len(content) > content_width
		int trunc_start = 0
		content = s_substring(content, trunc_start, content_width)
	content = s_pad_right(content, content_width)

	bool is_selected_row = data_row is spreadsheet_sel_row and data_row < spreadsheet_row_count
	if is_selected_row and spreadsheet_sel_col >= spreadsheet_scroll_col
		int sel_start = separator_width + (spreadsheet_sel_col - spreadsheet_scroll_col) * cell_stride
		int sel_stop = sel_start + SPREADSHEET_COLUMN_WIDTH
		if sel_stop > content_width
			sel_stop = content_width
		if sel_start < content_width
			int line_start = 0
			string before_sel = s_substring(content, line_start, sel_start)
			string sel_text = s_substring(content, sel_start, sel_stop)
			string after_sel = s_substring(content, sel_stop, content_width)
			content = s_join([before_sel, ANSI_REVERSE_ON, sel_text, ANSI_REVERSE_OFF, after_sel])

	screen = s_join([screen, content])

# Iterates every visible row, appending the sidebar column then the content
# column, same shape as render_buffer_rows' main loop.
macro render_spreadsheet_rows
	int view_rows = spreadsheet_view_rows(rows)

	int git_count = len(git_changes)
	int git_section_rows = sidebar_git_section_rows(is_git_repo, git_count, git_section_collapsed)
	int root_section_rows = sidebar_root_section_rows()
	int selected_idx = git_section_rows + root_section_rows + browse_selected
	if sidebar_on_git
		selected_idx = 1 + git_selected
	else if sidebar_on_root
		selected_idx = git_section_rows

	bool filter_active = false
	filterMatchList filter_matches = empty

	int spreadsheet_row_count = len(spreadsheet_rows)
	int spreadsheet_column_count_all = spreadsheet_column_count(spreadsheet_rows)

	for row_offset in range(view_rows)
		bool is_top_row = row_offset is 0
		bool is_bottom_row = row_offset is (view_rows - 1)
		int idx = browse_scroll_row + row_offset

		macro_run render_spreadsheet_sidebar_column
		macro_run render_spreadsheet_row

		screen = s_join([screen, ANSI_CRLF])

macro render_spreadsheet_status_and_notice
	int display_row = spreadsheet_sel_row + 1
	int display_col = spreadsheet_sel_col + 1
	string row_text = c_int_to_string(display_row)
	string col_text = c_int_to_string(display_col)
	string status_line = s_join(["-- ", spreadsheet_path, " (spreadsheet) -- row ", row_text, ", col ", col_text, " --"])
	if len(status_line) > cols
		int status_trunc_start = 0
		status_line = s_substring(status_line, status_trunc_start, cols)
	string status_padded = s_pad_right(status_line, cols)
	screen = s_join([screen, status_padded, ANSI_CRLF])

	string notice_text = notice
	if len(notice_text) > cols
		int notice_trunc_start = 0
		notice_text = s_substring(notice_text, notice_trunc_start, cols)
	string notice_padded = s_pad_right(notice_text, cols)
	screen = s_join([screen, notice_padded])

fn void spreadsheet_render(AppState state)
	(browser) in state
	(sidebar_focused, browse_entries, browse_selected, browse_scroll_row, creating_file) in browser
	(new_file_name, browse_dir, is_git_repo, git_changes, sidebar_on_git, sidebar_on_root, git_selected, git_section_collapsed) in browser
	(spreadsheet) in state
	(spreadsheet_path, spreadsheet_rows, spreadsheet_sel_row, spreadsheet_sel_col, spreadsheet_scroll_row, spreadsheet_scroll_col) in spreadsheet
	(notice) in state
	unsafe_macro_run use_consts
	unsafe_macro_run use_ansi_codes

	unsafe_macro_run setup_spreadsheet_view_layout
	macro_run render_spreadsheet_rows
	macro_run render_spreadsheet_status_and_notice

	xt_flush_print(screen)