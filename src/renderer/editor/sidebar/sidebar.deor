
import "src/consts.deor"
import "src/renderer/browser/browser.deor"
import "src/renderer/editor/layout.deor"

# Renders one row of the sidebar: the <GIT> section (header, "clean"
# placeholder, or a flat changed-file row), the <RECENT> section (header,
# then its files unless collapsed), the root row, then the Files tree
# (indentation, expand/collapse marker, "+" edit prefix, git-status color,
# selection highlight) -- reusing browser.deor's row-rendering helpers
# directly. `idx`/`selected_idx` are screen-row positions spanning the whole
# sidebar (see sidebar_git_section_rows), not raw list indices. Blank (just
# padding) once `idx` runs past the end of the Files tree.
#
# A macro rather than a fn on purpose: a fn would need every list below
# (browse_entries, git_changes, recent_paths, filter_matches) passed in,
# and that copies the whole list once per visible row per frame -- painfully
# slow in huge projects. A macro just reads the caller's variables in place.
# It needs these in scope: browse_entries, git_changes, git_section_rows,
# root_section_rows, browse_dir, git_section_collapsed, recent_paths,
# recent_section_rows, recent_section_collapsed, idx, selected_idx,
# sidebar_width, sidebar_focused, is_top_row, is_bottom_row, creating_file,
# new_file_name, new_file_cursor, filter_active, filter_matches.
# The caller declares `string sidebar_piece = ""` first; the result is
# assigned into it (a plain macro cannot leak a new variable).
macro sidebar_row_piece
	unsafe_macro_run compute_sidebar_row_layout

	if show_top_border or show_bottom_border
		unsafe_macro_run build_sidebar_border_row
		sidebar_piece = border_row_text
	else
		macro_run render_sidebar_body_row

# Each row case only ever *sets* `body`, which is then wrapped in the focus
# frame when the sidebar has keyboard focus.
macro render_sidebar_body_row
	string body = ""

	if filter_active
		macro_run render_sidebar_filter_row
	else if top_row_is_header
		macro_run render_sidebar_git_header_row
	else if has_git_section and idx < git_section_rows and git_count is 0
		macro_run render_sidebar_git_clean_row
	else if has_git_section and idx < git_section_rows
		macro_run render_sidebar_git_changed_row
	else if idx is git_section_rows
		macro_run render_sidebar_recent_header_row
	else if idx < rows_above_root
		macro_run render_sidebar_recent_file_row
	else if idx < rows_above_root + root_section_rows
		macro_run render_sidebar_root_row
	else
		macro_run render_sidebar_tree_row

	sidebar_piece = body

	if sidebar_focused
		SidebarBorderColors colors = use_sidebar_border_colors()
		(ansi_reset, ansi_sidebar_border_on) in colors
		string bar = "|"
		string colored_bar = s_join([ansi_sidebar_border_on, bar, ansi_reset])
		sidebar_piece = s_join([colored_bar, body, colored_bar])
