shape intList = list of int

struct WrapPosition
	int buffer_row
	int seg_index

# Input for wrap_step_forward_in_line -- how many visual rows the current
# line wraps into and which row is last, instead of the whole file, since
# handing `lines` to a function copies every line on every call.
struct WrapStepInput
	int step_seg_count
	int step_last_row

# Walks `line` once, tracking visible column: `\t` expands to the next
# `tab_width` stop (same rule as s_visual_col in rust_helper.deor), and ANSI
# escape sequences are skipped without counting toward the column (same
# skip block as render_visible_line). Because of that split, this walks a
# raw buffer line (tab branch fires, ANSI branch never does) and a
# highlighted display line (ANSI branch fires, tab branch never does --
# the syntax highlighter already expanded tabs to spaces) equally well, as long
# as both call sites pass the same `width`.
#
# Remembers the most recent whitespace visual-column seen since the last
# break. Once the segment would exceed `width` columns, breaks right after
# that remembered whitespace -- or, if none was seen (one long unbroken
# token), hard-breaks exactly at `width`, the same fallback today's
# truncation uses, just continued onto a new segment instead of dropped.
# Returns the visual-column offset each new segment starts at; an empty
# list means the line fits in a single segment (today's behavior).
fn intList wrap_break_visual_cols(string line, int width, int tab_width)
	# One pass over the characters with no allocation -- this used to build a
	# one-character string per character first, which made a very long line
	# (minified JSON, one-line data) take seconds per frame.
	rust
		{
			let mut breaks: Vec<i64> = Vec::new();
			let mut in_escape = false;
			let mut visible_cols: i64 = 0;
			let mut seg_start_col: i64 = 0;
			let mut last_ws_col: i64 = 0;
			let mut have_ws = false;
			for ch in line.chars() {
				if in_escape {
					if ch == 'm' { in_escape = false; }
					continue;
				}
				if ch == '\u{1b}' { in_escape = true; continue; }

				let mut col_width: i64 = 1;
				if ch == '\t' {
					let next_stop = (visible_cols / tab_width + 1) * tab_width;
					col_width = next_stop - visible_cols;
				}

				let current_is_ws = ch == ' ' || ch == '\t';
				let seg_cols = visible_cols + col_width - seg_start_col;
				if seg_cols > width {
					let mut break_col = seg_start_col + width;
					if have_ws && !current_is_ws {
						break_col = last_ws_col;
					}
					breaks.push(break_col);
					seg_start_col = break_col;
					have_ws = false;
				}

				if current_is_ws {
					last_ws_col = visible_cols + col_width;
					have_ws = true;
				}
				visible_cols += col_width;
			}
			breaks
		}

# Number of visual rows `line` wraps into, given `breaks` already computed
# by wrap_break_visual_cols for it -- one more than the number of break
# points.
fn int wrap_segment_count(intList breaks)
	return len(breaks) + 1

# Which segment (0-indexed) `visual_col` falls in, given `breaks` already
# computed by wrap_break_visual_cols for the same line.
fn int wrap_segment_index_for_col(intList breaks, int visual_col)
	int break_count = len(breaks)
	int seg_index = 0
	for if seg_index < break_count
		int break_col = breaks at seg_index
		if visual_col < break_col
			break
		seg_index = seg_index + 1
	return seg_index

# Visual column `seg_index` starts at, given `breaks` already computed by
# wrap_break_visual_cols for the same line -- 0 for the first segment.
# Clamps an out-of-range seg_index to the last real segment instead of
# indexing past the end of `breaks` -- callers can hand in a seg_index left
# over from a different line (e.g. a wheel scroll that only advanced the
# buffer row, see clamp_scroll in scroll.deor), and without this that stale
# value crashes here instead of just rendering the line's last segment.
fn int wrap_segment_start_col(intList breaks, int seg_index)
	if seg_index is 0
		return 0
	int break_count = len(breaks)
	int prev_index = seg_index - 1
	if prev_index >= break_count
		prev_index = break_count - 1
	if prev_index < 0
		return 0
	return breaks at prev_index

# Advances one visual row forward from `pos`, rolling into the next buffer
# line's first segment once the current line's segments are exhausted.
# Stays put at the last segment of the last line.
fn WrapPosition wrap_step_forward(WrapPosition pos, stringList lines, int width)
	unsafe_macro_run use_consts
	(buffer_row) in pos
	string step_line = lines at buffer_row
	intList step_breaks = wrap_break_visual_cols(step_line, width, TAB_WIDTH)
	int step_seg_count = wrap_segment_count(step_breaks)
	int step_last_row = len(lines) - 1
	WrapStepInput step_input = (step_seg_count, step_last_row)
	return wrap_step_forward_in_line(pos, step_input)

# wrap_step_forward without the whole file: callers that step in a loop
# (once per screen row) work out the current line's row count once per line
# (see load_step_seg_count) instead of for every step.
fn WrapPosition wrap_step_forward_in_line(WrapPosition pos, WrapStepInput step_input)
	(buffer_row, seg_index) in pos
	(step_seg_count, step_last_row) in step_input

	int next_seg = seg_index + 1
	if next_seg < step_seg_count
		seg_index = next_seg
		WrapPosition next_pos = (buffer_row, seg_index)
		return next_pos

	if buffer_row < step_last_row
		buffer_row = buffer_row + 1
		seg_index = 0
		WrapPosition next_pos = (buffer_row, seg_index)
		return next_pos

	return pos

# Inverse of wrap_step_forward -- steps one visual row back, rolling into
# the previous buffer line's last segment at a line boundary. Stays put at
# the first segment of the first line.
fn WrapPosition wrap_step_backward(WrapPosition pos, stringList lines, int width)
	unsafe_macro_run use_consts
	(buffer_row) in pos
	int prev_seg_count = 1
	int prev_row = buffer_row - 1
	if prev_row >= 0
		string prev_line = lines at prev_row
		intList prev_breaks = wrap_break_visual_cols(prev_line, width, TAB_WIDTH)
		prev_seg_count = wrap_segment_count(prev_breaks)
	return wrap_step_backward_in_line(pos, prev_seg_count)

# wrap_step_backward without the whole file -- prev_seg_count is how many
# visual rows the line above pos.buffer_row wraps into (unused at the top of
# the file).
fn WrapPosition wrap_step_backward_in_line(WrapPosition pos, int prev_seg_count)
	(buffer_row, seg_index) in pos

	if seg_index > 0
		seg_index = seg_index - 1
		WrapPosition prev_pos = (buffer_row, seg_index)
		return prev_pos

	if buffer_row > 0
		buffer_row = buffer_row - 1
		seg_index = prev_seg_count - 1
		WrapPosition prev_pos = (buffer_row, seg_index)
		return prev_pos

	return pos

# Total visual rows the whole document wraps into -- sum of every line's
# own segment count. An O(total lines) pass, cheap next to per-frame
# rendering, but the one place in the wrap module that walks the entire
# document rather than a bounded number of rows -- used by the scrollbar,
# which needs true proportions once lines can span multiple rows.
fn int wrap_total_visual_rows(stringList lines, int width)
	unsafe_macro_run use_consts
	int total_visual_rows = 0
	rust
		{
			for line in lines.iter() {
				total_visual_rows += wrap_break_visual_cols(line.clone(), width, TAB_WIDTH).len() as i64 + 1;
			}
		}
	return total_visual_rows

# Converts `pos` into its absolute visual-row index from the top of the
# document (sum of every earlier line's segment count, plus pos's own
# segment index) -- the inverse of wrap_position_for_visual_row. Assumes
# pos.buffer_row is a real, in-bounds line; callers scrolled into the
# EOF-padding band (see render_buffer_rows.deor) handle that band's
# "extended" rows themselves rather than passing an out-of-bounds pos here.
fn int wrap_visual_row_position(WrapPosition pos, stringList lines, int width)
	unsafe_macro_run use_consts
	(buffer_row, seg_index) in pos
	int total_visual_rows = 0
	rust
		{
			for line in lines.iter().take(buffer_row.max(0) as usize) {
				total_visual_rows += wrap_break_visual_cols(line.clone(), width, TAB_WIDTH).len() as i64 + 1;
			}
		}
	total_visual_rows = total_visual_rows + seg_index
	return total_visual_rows

# Inverse of wrap_visual_row_position -- finds which (buffer_row,
# seg_index) the document's `target_visual_row`'th visual row falls in.
# Clamps to the last segment of the last line if target_visual_row reaches
# or exceeds wrap_total_visual_rows, the same "stays put at the end"
# fallback wrap_step_forward uses.
fn WrapPosition wrap_position_for_visual_row(stringList lines, int target_visual_row, int width)
	unsafe_macro_run use_consts
	int total_line_count = len(lines)
	int buffer_row = 0
	int consumed_rows = 0
	for if buffer_row < total_line_count
		string line = lines at buffer_row
		intList breaks = wrap_break_visual_cols(line, width, TAB_WIDTH)
		int seg_count = wrap_segment_count(breaks)
		int next_consumed_rows = consumed_rows + seg_count
		if target_visual_row < next_consumed_rows
			int seg_index = target_visual_row - consumed_rows
			WrapPosition pos = (buffer_row, seg_index)
			return pos
		consumed_rows = next_consumed_rows
		buffer_row = buffer_row + 1

	buffer_row = total_line_count - 1
	string last_line = lines at buffer_row
	intList last_breaks = wrap_break_visual_cols(last_line, width, TAB_WIDTH)
	int seg_index = wrap_segment_count(last_breaks) - 1
	WrapPosition pos = (buffer_row, seg_index)
	return pos
