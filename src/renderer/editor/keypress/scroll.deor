# scroll_row going negative (e.g. wheeling up past the top of the document)
# -- scroll_wrap_seg is reset alongside it since a seg_index only means
# anything paired with a real buffer_row.
macro clamp_scroll_floor
	if scroll_row < 0
		scroll_row = 0
		scroll_wrap_seg = 0

# A wheel notch only ever moves scroll_row (see scroll_up_impl/
# scroll_down_impl below) -- scroll_wrap_seg stays whatever it was last set
# to by editor_scroll/scrollbar_jump_to_row, which can be a segment index
# that doesn't exist on the line scroll_row now points at (e.g. it was valid
# mid-way through a long wrapped line, then a wheel notch moved scroll_row
# onto a short line). Reclamping it here to the new line's actual segment
# count keeps it a valid pair with scroll_row, the same invariant
# scrollbar_jump_to_row already maintains -- otherwise render_buffer_rows/
# wrap_segment_start_col index past the end of that line's break list.
# Expects total_line_count/text_visible_columns already computed by the
# caller (see clamp_scroll).
macro reclamp_scroll_wrap_seg
	if scroll_wrap_seg < 0
		scroll_wrap_seg = 0
	else if scroll_row < total_line_count
		string scroll_line = lines at scroll_row
		intList scroll_breaks = wrap_break_visual_cols(scroll_line, text_visible_columns, TAB_WIDTH)
		int max_seg = wrap_segment_count(scroll_breaks) - 1
		if scroll_wrap_seg > max_seg
			scroll_wrap_seg = max_seg
	else
		scroll_wrap_seg = 0

# Bounds (scroll_row, scroll_wrap_seg) by a visual-row ceiling instead of a
# raw line-count one -- a single long unwrapped line (e.g. a long paragraph)
# can wrap into far more on-screen rows than a flat line-count cap accounts
# for, which let the wheel run out of "budget" while still visually stuck
# partway through such a line, well short of the document's real end. Mirrors
# clamp_diff_scroll, which already had to solve the same problem for the diff
# view. Expects total_line_count/view_rows/text_visible_columns already
# computed, and scroll_wrap_seg already valid for scroll_row's line (see
# reclamp_scroll_wrap_seg) -- both provided by the caller (see clamp_scroll).
#
# +EOF_PADDING_ROWS lets scrolling reach the grey band render_buffer_rows
# paints past the last line -- without this a long file's view always ends
# exactly on its last line and the padding (meant to keep text off the
# status bar) never becomes reachable.
macro clamp_scroll_to_wrapped_ceiling
	const int EOF_PADDING_ROWS = 5
	int total_visual_rows = wrap_total_visual_rows(lines, text_visible_columns)
	int max_scroll_visual_row = total_visual_rows - view_rows + EOF_PADDING_ROWS
	if max_scroll_visual_row < 0
		max_scroll_visual_row = 0

	int scroll_visual_row = total_visual_rows
	if scroll_row < total_line_count
		int buffer_row = scroll_row
		int seg_index = scroll_wrap_seg
		WrapPosition scroll_pos = (buffer_row, seg_index)
		scroll_visual_row = wrap_visual_row_position(scroll_pos, lines, text_visible_columns)
	else
		scroll_visual_row = total_visual_rows + (scroll_row - total_line_count)

	if scroll_visual_row > max_scroll_visual_row
		if max_scroll_visual_row >= total_visual_rows
			scroll_row = total_line_count + (max_scroll_visual_row - total_visual_rows)
			scroll_wrap_seg = 0
		else
			WrapPosition clamped_pos = wrap_position_for_visual_row(lines, max_scroll_visual_row, text_visible_columns)
			(buffer_row, seg_index) in clamped_pos
			scroll_row = buffer_row
			scroll_wrap_seg = seg_index

# Clamps scroll_row/scroll_wrap_seg for a plain wheel-driven scroll in the
# main buffer view -- uses the exact same EditorLayout view_rows as
# editor_scroll and the renderer (see layout.deor), so the wheel never
# scrolls further than the cursor-follow logic or the drawn screen itself
# would allow. Composed of three steps, each documented at its own
# definition above: floor scroll_row at 0, reclamp scroll_wrap_seg to the
# line scroll_row now points at, then clamp both to the document's true
# (wrap-aware) end.
macro clamp_scroll
	unsafe_macro_run use_consts
	macro_run clamp_scroll_floor

	int total_line_count = len(lines)
	TermSize size = xt_size()
	(cols, rows) in size

	EditorLayoutInput layout_input = (rows, cols, total_line_count, show_line_numbers, lint_output_visible, diff_lines, sidebar_focused, search_active)
	EditorLayout layout = compute_editor_layout(layout_input)
	(view_rows, text_visible_columns) in layout

	macro_run reclamp_scroll_wrap_seg
	macro_run clamp_scroll_to_wrapped_ceiling

# Shared by scroll_up/scroll_down to find this frame's actual sidebar_width
# (wider while sidebar_focused, see layout.deor) -- so a wheel scroll over
# the sidebar's columns is detected correctly even while it's widened.
unsafe_macro compute_scroll_sidebar_width
	int total_line_count = len(lines)
	TermSize size = xt_size()
	(cols, rows) in size
	EditorLayoutInput layout_input = (rows, cols, total_line_count, show_line_numbers, lint_output_visible, diff_lines, sidebar_focused, search_active)
	EditorLayout layout = compute_editor_layout(layout_input)
	(sidebar_width) in layout

# A wheel scroll over the sidebar's columns scrolls the Files tree instead of
# the text buffer (see sidebar_scroll_up/down) -- lets the tree be browsed
# without leaving the editor just to reach an entry below the fold. These
# also run while a git diff is open and the sidebar has keyboard focus (see
# handle_sidebar_focus_mode) -- handle_diff_mode's own mouse_scroll_up/down
# only fire once focus is off the sidebar, so without the `diffing` branch
# here a wheel scroll over the diff pane while the sidebar is focused moved
# the (currently invisible) text-buffer scroll_row instead of diff_scroll_row,
# and the diff view never appeared to move.
macro scroll_up_impl
	unsafe_macro_run use_consts
	unsafe_macro_run compute_scroll_sidebar_width
	if col < sidebar_width
		macro_run sidebar_scroll_up
	else if diffing
		macro_run diff_scroll_up_impl
	else
		scroll_row = scroll_row - SCROLL_WHEEL_AMOUNT
		macro_run clamp_scroll
	wheel_scrolled = true

macro scroll_down_impl
	unsafe_macro_run use_consts
	unsafe_macro_run compute_scroll_sidebar_width
	if col < sidebar_width
		macro_run sidebar_scroll_down
	else if diffing
		macro_run diff_scroll_down_impl
	else
		scroll_row = scroll_row + SCROLL_WHEEL_AMOUNT
		macro_run clamp_scroll
	wheel_scrolled = true
