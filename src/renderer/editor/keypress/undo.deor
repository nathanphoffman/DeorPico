# Snapshots the buffer just before a mutating action so it can be restored later.
# Call this FIRST, before the action actually changes `lines`/cursor. Starting a
# new edit always invalidates the old redo history, same as every other editor.
macro push_undo_snapshot
	full_len as len(lines)
	stringList saved_lines = l_string_take(lines, full_len)
	macro_run push_saved_lines_to_undo

# Pushes `saved_lines` (declared by the caller -- a copy of `lines` from
# before the change) as the next undo step. The spreadsheet uses this
# directly with a copy it took before handling a key (see
# spreadsheet_record_undo).
macro push_saved_lines_to_undo
	stringList point_lines = move saved_lines
	int point_row = cursor_row
	int point_col = cursor_col
	UndoPoint snapshot = move (point_lines, point_row, point_col)
	undo_history = undo_history_push(move undo_history, move snapshot)
	redo_history = new_undo_history()

macro do_undo_impl
	(history_has_top) in undo_history
	if history_has_top
		# The state being undone becomes the newest redo step.
		full_len as len(lines)
		stringList point_lines = l_string_take(lines, full_len)
		int point_row = cursor_row
		int point_col = cursor_col
		UndoPoint current_point = move (point_lines, point_row, point_col)
		redo_history = undo_history_push(move redo_history, move current_point)

		UndoPop undone = undo_history_pop(move undo_history)
		move (popped_history, popped_point) in undone
		undo_history = move popped_history
		move (point_lines, point_row, point_col) in popped_point
		lines = point_lines
		cursor_row = point_row
		cursor_col = point_col
		dirty = true
		notice = "Undo"
		error = false

macro do_redo_impl
	(history_has_top) in redo_history
	if history_has_top
		full_len as len(lines)
		stringList point_lines = l_string_take(lines, full_len)
		int point_row = cursor_row
		int point_col = cursor_col
		UndoPoint current_point = move (point_lines, point_row, point_col)
		undo_history = undo_history_push(move undo_history, move current_point)

		UndoPop redone = undo_history_pop(move redo_history)
		move (popped_history, popped_point) in redone
		redo_history = move popped_history
		move (point_lines, point_row, point_col) in popped_point
		lines = point_lines
		cursor_row = point_row
		cursor_col = point_col
		dirty = true
		notice = "Redo"
		error = false

# Called when switching to a different file (e.g. via the browser) so undo
# history from the old file can't bleed into the new one.
macro reset_undo_history
	undo_history = new_undo_history()
	redo_history = new_undo_history()
