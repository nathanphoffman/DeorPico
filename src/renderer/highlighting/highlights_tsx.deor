macro highlights_tsx
	# block comments
	macro_run shared_highlighting_comment_block

	# line comments
	macro_run shared_highlighting_comment_slashes

	# double/single/template-literal strings -- template ${} interpolation
	# isn't separately colored, the whole literal is just one string token.
	#
	# Deliberately NO regex-literal rule (/pattern/) here, same reasoning as
	# highlights_typescript -- it can't be told apart from division "/".
	macro_run shared_highlighting_string_double
	macro_run shared_highlighting_string_single
	macro_run shared_highlighting_string_backtick

	# JSX tag names: "<" or "</" immediately followed by a tag/component
	# name (dotted for namespaced components like <Foo.Bar>). xs_add_tag
	# (rather than xs_add_keyword) also turns on tag scoping: a match opens
	# an attribute scope that, once the tag's closing ">" is found, enters a
	# text scope for its children where ordinary code rules don't apply --
	# that's what keeps quotes/apostrophes/capitalized words in JSX text
	# (e.g. "Hi" in <Link>Hi World</Link>) from being misread as code.
	# xs_add_tag guards entry from ordinary code with a required
	# "expression can start here" character so generic-looking "<Foo" type
	# usages like Array<string> aren't mistaken for a tag.
	# The "|>" alternative matches fragments (<> and </>); the tokenizer
	# hands the ">" back so the tag scope still sees its own close.
	macro_run shared_highlighting_jsx_tag

	# lets a bare "{" inside JSX text (e.g. {this.props.name}) resume full
	# code scanning until its matching "}", instead of staying inert
	macro_run shared_highlighting_jsx_expr

	# JSX attribute names (className=, onClick=): identifier tight against
	# "=" with no space -- the "=" is swallowed into the match for the same
	# lookahead reason as above
	macro_run shared_highlighting_attr_name

	# call sites: name immediately followed by "(" -- registered before the
	# keyword/type rules below so conventional camelCase/PascalCase call
	# sites win the tokenizer's first-atom-registered tiebreak (same
	# reasoning as highlights_csharp's call_pattern)
	macro_run shared_highlighting_call_js
	macro_run shared_highlighting_ts_keywords

	# builtin primitive/utility types
	macro_run shared_highlighting_ts_builtin_types

	# PascalCase identifiers (React components, classes, interfaces, type
	# aliases, generics), wherever used outside a JSX tag
	macro_run shared_highlighting_type_pascal

	# numeric literals, underscores allowed as separators
	macro_run shared_highlighting_number
