macro highlights_go
	# block comments
	macro_run shared_highlighting_comment_block

	# line comments
	macro_run shared_highlighting_comment_slashes

	# raw strings (backtick-delimited) -- no escape sequences at all
	name as "string"
	start as "`"
	stop as "`"
	BoundedSpec rstr_spec = (name, start, stop)
	rstr_escapable as false
	highlighter = xs_add_bounded(highlighter, rstr_spec, rstr_escapable)

	# interpreted strings
	macro_run shared_highlighting_string_double

	# call sites
	macro_run shared_highlighting_call

	kw_name as "keyword"
	kw_pattern as "\\b(break|case|chan|const|continue|default|defer|else|fallthrough|for|func|go|goto|if|import|interface|map|package|range|return|select|struct|switch|type|var)\\b"
	highlighter = xs_add_keyword(highlighter, kw_name, kw_pattern)

	# builtin primitive types
	builtin_name as "type"
	builtin_pattern as "\\b(any|bool|byte|complex64|complex128|error|float32|float64|int|int8|int16|int32|int64|rune|string|uint|uint8|uint16|uint32|uint64|uintptr)\\b"
	highlighter = xs_add_keyword(highlighter, builtin_name, builtin_pattern)

	# PascalCase (exported) identifiers, wherever used
	macro_run shared_highlighting_type_pascal

	# numeric literals, underscores allowed as separators
	macro_run shared_highlighting_number
