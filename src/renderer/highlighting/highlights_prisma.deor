# attributes: @id, @@index, and dotted native types like @db.VarChar
macro prisma_highlighting_attribute
	attr_name as "macro_name"
	attr_pattern as "@@?[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*)*"
	highlighter = xs_add_keyword(highlighter, attr_name, attr_pattern)

# block keywords and literals -- must run before the field-name rule so "model" wins ties
macro prisma_highlighting_keywords_and_literals
	kw_name as "keyword"
	kw_pattern as "\\b(datasource|generator|model|enum|type|view|true|false|null)\\b"
	highlighter = xs_add_keyword(highlighter, kw_name, kw_pattern)

# field names: the first identifier on a line inside a block
macro prisma_highlighting_field_name_at_line_start
	field_name as "function"
	field_pattern as "^\\s*[A-Za-z_][A-Za-z0-9_]*"
	highlighter = xs_add_keyword(highlighter, field_name, field_pattern)

macro highlights_prisma
	macro_run shared_highlighting_comment_slashes
	macro_run shared_highlighting_string_double
	macro_run prisma_highlighting_attribute
	macro_run shared_highlighting_call
	macro_run prisma_highlighting_keywords_and_literals
	macro_run shared_highlighting_type_pascal
	macro_run prisma_highlighting_field_name_at_line_start
	macro_run shared_highlighting_number_plain
