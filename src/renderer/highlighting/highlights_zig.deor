# builtin functions (@import, @intCast, @as, ...)
macro zig_highlighting_builtin_fn
	attr_name as "keyword"
	attr_pattern as "@[A-Za-z_][A-Za-z0-9_]*"
	highlighter = xs_add_keyword(highlighter, attr_name, attr_pattern)

# Zig keywords
macro zig_highlighting_keywords
	kw_name as "keyword"
	kw_pattern as "\\b(addrspace|align|allowzero|and|anyframe|anytype|asm|async|await|break|callconv|catch|comptime|const|continue|defer|else|enum|errdefer|error|export|extern|fn|for|if|inline|linksection|noalias|noinline|nosuspend|opaque|or|orelse|packed|pub|resume|return|struct|suspend|switch|test|threadlocal|try|union|unreachable|usingnamespace|var|volatile|while|true|false|null|undefined)\\b"
	highlighter = xs_add_keyword(highlighter, kw_name, kw_pattern)

# builtin primitive types (including arbitrary-width iN / uN)
macro zig_highlighting_builtin_types
	builtin_name as "type"
	builtin_pattern as "\\b([iu][0-9]+|isize|usize|c_char|c_short|c_ushort|c_int|c_uint|c_long|c_ulong|c_longlong|c_ulonglong|c_longdouble|f16|f32|f64|f80|f128|bool|anyopaque|void|noreturn|type|anyerror|comptime_int|comptime_float)\\b"
	highlighter = xs_add_keyword(highlighter, builtin_name, builtin_pattern)

# numeric literals: hex/binary/octal, decimals with _ separators, exponents
macro zig_highlighting_number
	num_name as "number"
	num_pattern as "\\b(0x[0-9a-fA-F_]+|0b[01_]+|0o[0-7_]+|\\d[\\d_]*(\\.\\d[\\d_]*)?([eE][+-]?\\d+)?)\\b"
	highlighter = xs_add_keyword(highlighter, num_name, num_pattern)

# No block comments in Zig. Single quotes are character literals ('x', '\n').
macro highlights_zig
	macro_run shared_highlighting_comment_slashes
	macro_run shared_highlighting_string_double
	macro_run shared_highlighting_string_single
	macro_run zig_highlighting_builtin_fn
	macro_run shared_highlighting_call
	macro_run zig_highlighting_keywords
	macro_run zig_highlighting_builtin_types
	macro_run zig_highlighting_number
