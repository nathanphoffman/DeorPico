# YAML frontmatter ("--- ... ---") scanned with the yaml rules -- first row only, a later "---" is a rule line
macro markdown_highlighting_yaml_frontmatter_on_first_row
	name as "macro_name"
	start as "^---\\s*$"
	stop as "^---\\s*$"
	BoundedSpec yaml_fm_spec = (name, start, stop)
	yaml_fm_first_row_only as true
	highlighter = xs_sub_begin(highlighter, yaml_fm_spec, yaml_fm_first_row_only)
	macro_run highlights_yaml
	highlighter = xs_sub_end(highlighter)

# TOML frontmatter ("+++ ... +++") scanned with the toml rules -- first row only
macro markdown_highlighting_toml_frontmatter_on_first_row
	name as "macro_name"
	start as "^\\+\\+\\+\\s*$"
	stop as "^\\+\\+\\+\\s*$"
	BoundedSpec toml_fm_spec = (name, start, stop)
	toml_fm_first_row_only as true
	highlighter = xs_sub_begin(highlighter, toml_fm_spec, toml_fm_first_row_only)
	macro_run highlights_toml
	highlighter = xs_sub_end(highlighter)

# ``` fenced code blocks -- must run before the inline-code rule to win ties
macro markdown_highlighting_fenced_code_block
	name as "block"
	start as "```"
	stop as "```"
	BoundedSpec fence_spec = (name, start, stop)
	fence_escapable as false
	highlighter = xs_add_bounded(highlighter, fence_spec, fence_escapable)

# `inline code`
macro markdown_highlighting_inline_code
	name as "block"
	start as "`"
	stop as "`"
	BoundedSpec code_spec = (name, start, stop)
	code_escapable as false
	highlighter = xs_add_bounded(highlighter, code_spec, code_escapable)

# headings: 1 to 6 "#" at the start of a line
macro markdown_highlighting_heading
	heading_name as "heading"
	heading_pattern as "^#{1,6} .*"
	highlighter = xs_add_keyword(highlighter, heading_name, heading_pattern)

# blockquotes: ">" at the start of a line
macro markdown_highlighting_blockquote
	quote_name as "quote"
	quote_pattern as "^>\\s?.*"
	highlighter = xs_add_keyword(highlighter, quote_name, quote_pattern)

# list markers (-, *, +, 1.) -- must run before italic so a leading "*" isn't read as emphasis
macro markdown_highlighting_list_marker
	list_name as "list"
	list_pattern as "^\\s*([-*+]|\\d+\\.) "
	highlighter = xs_add_keyword(highlighter, list_name, list_pattern)

# images ![alt](url) -- must run before the link rule, which matches one character later
macro markdown_highlighting_image
	image_name as "image"
	image_pattern as "!\\[[^\\]]*\\]\\([^)]*\\)"
	highlighter = xs_add_keyword(highlighter, image_name, image_pattern)

# links [text](url)
macro markdown_highlighting_link
	link_name as "link"
	link_pattern as "\\[[^\\]]*\\]\\([^)]*\\)"
	highlighter = xs_add_keyword(highlighter, link_name, link_pattern)

# **bold** and __bold__ -- must run before italic to win ties
macro markdown_highlighting_bold
	bold_name as "bold"
	bold_pattern as "(\\*\\*[^*]+\\*\\*|__[^_]+__)"
	highlighter = xs_add_keyword(highlighter, bold_name, bold_pattern)

# *italic* and _italic_
macro markdown_highlighting_italic
	italic_name as "italic"
	italic_pattern as "(\\*[^*]+\\*|_[^_]+_)"
	highlighter = xs_add_keyword(highlighter, italic_name, italic_pattern)

# ~~strikethrough~~
macro markdown_highlighting_strikethrough
	strike_name as "strikethrough"
	strike_pattern as "~~[^~]+~~"
	highlighter = xs_add_keyword(highlighter, strike_name, strike_pattern)

# inline math ($...$)
macro markdown_highlighting_inline_math
	math_name as "math"
	math_pattern as "\\$[^$]+\\$"
	highlighter = xs_add_keyword(highlighter, math_name, math_pattern)

macro highlights_markdown
	macro_run markdown_highlighting_yaml_frontmatter_on_first_row
	macro_run markdown_highlighting_toml_frontmatter_on_first_row
	macro_run markdown_highlighting_fenced_code_block
	macro_run markdown_highlighting_inline_code
	macro_run markdown_highlighting_heading
	macro_run markdown_highlighting_blockquote
	macro_run markdown_highlighting_list_marker
	macro_run markdown_highlighting_image
	macro_run markdown_highlighting_link
	macro_run markdown_highlighting_bold
	macro_run markdown_highlighting_italic
	macro_run markdown_highlighting_strikethrough
	macro_run markdown_highlighting_inline_math
