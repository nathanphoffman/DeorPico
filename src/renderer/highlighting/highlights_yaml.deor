macro highlights_yaml
	# document markers: "---" opens a document, "..." ends one. Multi-document
	# streams (kubernetes manifests, docker-compose overlays) are the common
	# case. When this grammar is running as a markdown file's frontmatter
	# sub-grammar the closing "---" is the region terminator instead, and the
	# tokenizer gives the terminator precedence -- see hl_tokenize_line.
	doc_name as "macro_name"
	doc_pattern as "^(---|\\.\\.\\.)\\s*$"
	highlighter = xs_add_keyword(highlighter, doc_name, doc_pattern)

	# comments
	comment_name as "comment"
	comment_pattern as "#.*"
	highlighter = xs_add_keyword(highlighter, comment_name, comment_pattern)

	# anchors (&name), aliases (*name), and tags (!!str, !CustomTag)
	anchor_name as "type"
	anchor_pattern as "&[A-Za-z0-9_-]+"
	highlighter = xs_add_keyword(highlighter, anchor_name, anchor_pattern)

	alias_name as "type"
	alias_pattern as "\\*[A-Za-z0-9_-]+"
	highlighter = xs_add_keyword(highlighter, alias_name, alias_pattern)

	tag_name as "type"
	tag_pattern as "!!?[A-Za-z0-9_/]+"
	highlighter = xs_add_keyword(highlighter, tag_name, tag_pattern)

	# mapping keys -- quoted or bare, tight against ":", anchored to the
	# start of the line (optionally after a "- " list-item marker) so a
	# ":" inside a value (e.g. a URL or a time) never misreads as a key.
	# Trailing ":" is swallowed into the match since the regex crate has no
	# lookahead (same trick as the JSON/TOML key rules). Registered before
	# the plain string rules below so a quoted key still wins the
	# tokenizer's first-atom-registered tiebreak at its opening quote.
	key_name as "function"
	key_pattern as "^\\s*(-\\s+)?(\"[^\"]*\"|'[^']*'|[A-Za-z0-9_.<-]+)\\s*:"
	highlighter = xs_add_keyword(highlighter, key_name, key_pattern)

	# keys inside a flow mapping -- the compact inline form,
	# "- { tag: x, note: \"y\" }". These are keys only because they follow a
	# "{" or a "," rather than because of where they sit in the line, so the
	# rule above (anchored to the start of the line) can never see them. The
	# regex crate has no lookbehind, so the "{"/"," is matched but left out of
	# capture group 1, which is the only part xs_add_keyword_group colors.
	# Registered before the string rules below so a quoted flow key still wins
	# the tokenizer's first-atom-registered tiebreak at its opening quote.
	flow_key_name as "function"
	flow_key_pattern as "[{,]\\s*((?:\"[^\"]*\"|'[^']*'|[A-Za-z0-9_.<-]+)\\s*:)"
	highlighter = xs_add_keyword_group(highlighter, flow_key_name, flow_key_pattern)

	# double-quoted strings (backslash-escapable)
	name as "string"
	start as "\""
	stop as "\""
	BoundedSpec dstr_spec = (name, start, stop)
	dstr_escapable as true
	highlighter = xs_add_bounded(highlighter, dstr_spec, dstr_escapable)

	# single-quoted strings -- YAML escapes an embedded ' by doubling it
	# ('') rather than with a backslash, so this is not escapable, same as
	# TOML's literal strings.
	name as "string"
	start as "'"
	stop as "'"
	BoundedSpec sstr_spec = (name, start, stop)
	sstr_escapable as false
	highlighter = xs_add_bounded(highlighter, sstr_spec, sstr_escapable)

	# booleans and null
	kw_name as "keyword"
	kw_pattern as "\\b(true|false|null|True|False|Null|TRUE|FALSE|NULL|yes|no|Yes|No|YES|NO)\\b"
	highlighter = xs_add_keyword(highlighter, kw_name, kw_pattern)

	# numeric literals, underscores allowed as separators
	num_name as "number"
	num_pattern as "[+-]?\\b\\d[\\d_]*(\\.[\\d_]+)?([eE][+-]?\\d+)?\\b"
	highlighter = xs_add_keyword(highlighter, num_name, num_pattern)
