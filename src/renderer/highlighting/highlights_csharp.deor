# C# keywords, including contextual ones
macro csharp_highlighting_keywords
	kw_name as "keyword"
	kw_pattern as "\\b(abstract|as|base|break|case|catch|checked|class|const|continue|default|delegate|do|else|enum|event|explicit|extern|finally|fixed|for|foreach|goto|if|implicit|in|interface|internal|is|lock|namespace|new|null|operator|out|override|params|private|protected|public|readonly|ref|return|sealed|sizeof|stackalloc|static|struct|switch|this|throw|try|typeof|unchecked|unsafe|using|virtual|volatile|while|async|await|var|get|set|value|yield|partial|where|select|from|let|orderby|group|into|join|equals|by|ascending|descending|nameof|when|add|remove|global|alias|dynamic|unmanaged|with|record|init|required|scoped|and|or|not|managed|notnull)\\b"
	highlighter = xs_add_keyword(highlighter, kw_name, kw_pattern)

# builtin primitive types, plus true/false
macro csharp_highlighting_builtin_types_and_booleans
	builtin_name as "type"
	builtin_pattern as "\\b(bool|byte|char|decimal|double|float|int|long|object|nint|nuint|sbyte|short|string|uint|ulong|ushort|void|true|false)\\b"
	highlighter = xs_add_keyword(highlighter, builtin_name, builtin_pattern)

# hex (0x), binary (0b) and decimal literals with underscores, an optional exponent and f/d/m/u/l suffixes
macro csharp_highlighting_number_with_type_suffix
	num_name as "number"
	num_pattern as "\\b(0[xX][0-9a-fA-F_]+|0[bB][01_]+|\\d[\\d_]*(\\.[\\d_]+)?([eE][+-]?\\d+)?)[fFdDmMuUlL]*\\b"
	highlighter = xs_add_keyword(highlighter, num_name, num_pattern)

# attributes: [Serializable], [assembly: Foo] -- PascalCase only, so indexers like arr[i] stay plain
macro csharp_highlighting_attribute
	attr_name as "macro_name"
	attr_pattern as "\\[(assembly:|module:|return:)?[A-Z][A-Za-z0-9_.]*"
	highlighter = xs_add_keyword(highlighter, attr_name, attr_pattern)

# preprocessor directives (#region, #if, #nullable ...) to end of line
macro csharp_highlighting_preprocessor
	pre_name as "macro_name"
	pre_pattern as "#[a-z]+.*"
	highlighter = xs_add_keyword(highlighter, pre_name, pre_pattern)

# Function calls are registered before PascalCase types so PascalCase method names read as calls
macro highlights_csharp
	macro_run shared_highlighting_comment_block
	macro_run shared_highlighting_comment_slashes
	macro_run csharp_highlighting_strings
	macro_run csharp_highlighting_preprocessor
	macro_run csharp_highlighting_attribute
	macro_run shared_highlighting_call
	macro_run csharp_highlighting_keywords
	macro_run csharp_highlighting_builtin_types_and_booleans
	macro_run shared_highlighting_type_pascal
	macro_run csharp_highlighting_number_with_type_suffix
