# '''...''' -- must run before the plain single-quote rule to win ties
macro python_highlighting_string_triple_single
	name as "string"
	start as "'''"
	stop as "'''"
	BoundedSpec ststr_spec = (name, start, stop)
	ststr_escapable as true
	highlighter = xs_add_bounded(highlighter, ststr_spec, ststr_escapable)

# Python keywords
macro python_highlighting_keywords
	kw_name as "keyword"
	kw_pattern as "\\b(and|as|assert|async|await|break|class|continue|def|del|elif|else|except|finally|for|from|global|if|import|in|is|lambda|nonlocal|not|or|pass|raise|return|try|while|with|yield|match|case)\\b"
	highlighter = xs_add_keyword(highlighter, kw_name, kw_pattern)

# builtin types and constants (int, str, None, True, self, ...)
macro python_highlighting_builtin_types_and_constants
	builtin_name as "type"
	builtin_pattern as "\\b(int|float|str|bool|list|dict|set|tuple|bytes|complex|frozenset|object|None|True|False|self|cls)\\b"
	highlighter = xs_add_keyword(highlighter, builtin_name, builtin_pattern)

macro highlights_python
	macro_run shared_highlighting_comment_hash
	macro_run shared_highlighting_string_triple_double
	macro_run python_highlighting_string_triple_single
	macro_run shared_highlighting_string_double
	macro_run shared_highlighting_string_single
	macro_run shared_highlighting_decorator
	macro_run shared_highlighting_call
	macro_run python_highlighting_keywords
	macro_run python_highlighting_builtin_types_and_constants
	macro_run shared_highlighting_type_pascal
	macro_run shared_highlighting_number
