# Rules that are identical across several languages, one macro per rule.
# Each highlights_<language> macro macro_runs the ones it needs, in the
# order it wants them registered -- order matters, since the tokenizer keeps
# whichever rule was registered first when two match at the same position.
# Every macro here expects `highlighter` to already exist in the caller.

# "..." with backslash escapes
macro shared_highlighting_string_double
	name as "string"
	start as "\""
	stop as "\""
	BoundedSpec str_spec = (name, start, stop)
	str_escapable as true
	highlighter = xs_add_bounded(highlighter, str_spec, str_escapable)

# "..." with no escapes (a backslash is just a character)
macro shared_highlighting_string_double_raw
	name as "string"
	start as "\""
	stop as "\""
	BoundedSpec dstr_spec = (name, start, stop)
	dstr_escapable as false
	highlighter = xs_add_bounded(highlighter, dstr_spec, dstr_escapable)

# '...' with backslash escapes
macro shared_highlighting_string_single
	name as "string"
	start as "'"
	stop as "'"
	BoundedSpec sstr_spec = (name, start, stop)
	sstr_escapable as true
	highlighter = xs_add_bounded(highlighter, sstr_spec, sstr_escapable)

# '...' with no escapes
macro shared_highlighting_string_single_raw
	name as "string"
	start as "'"
	stop as "'"
	BoundedSpec sstr_spec = (name, start, stop)
	sstr_escapable as false
	highlighter = xs_add_bounded(highlighter, sstr_spec, sstr_escapable)

# `...` template literals -- ${} interpolation isn't separately colored
macro shared_highlighting_string_backtick
	name as "string"
	start as "`"
	stop as "`"
	BoundedSpec tstr_spec = (name, start, stop)
	tstr_escapable as true
	highlighter = xs_add_bounded(highlighter, tstr_spec, tstr_escapable)

# """...""" -- register before shared_highlighting_string_double so it wins the
# tokenizer's first-atom-registered tiebreak at the same opening quote
macro shared_highlighting_string_triple_double
	name as "string"
	start as "\"\"\""
	stop as "\"\"\""
	BoundedSpec dtstr_spec = (name, start, stop)
	dtstr_escapable as true
	highlighter = xs_add_bounded(highlighter, dtstr_spec, dtstr_escapable)

# /* ... */
macro shared_highlighting_comment_block
	name as "comment"
	start as "/\\*"
	stop as "\\*/"
	BoundedSpec bc_spec = (name, start, stop)
	bc_escapable as false
	highlighter = xs_add_bounded(highlighter, bc_spec, bc_escapable)

# // to end of line
macro shared_highlighting_comment_slashes
	comment_name as "comment"
	comment_pattern as "//.*"
	highlighter = xs_add_keyword(highlighter, comment_name, comment_pattern)

# # to end of line
macro shared_highlighting_comment_hash
	comment_name as "comment"
	comment_pattern as "#.*"
	highlighter = xs_add_keyword(highlighter, comment_name, comment_pattern)

# <!-- ... --> -- text-reachable, so it still matches inside tag text
macro shared_highlighting_comment_html
	name as "comment"
	start as "<!--"
	stop as "-->"
	BoundedSpec html_bc_spec = (name, start, stop)
	html_bc_escapable as false
	highlighter = xs_add_bounded_text(highlighter, html_bc_spec, html_bc_escapable)

# PascalCase identifiers, colored as types
macro shared_highlighting_type_pascal
	struct_name as "type"
	struct_pattern as "\\b[A-Z][A-Za-z0-9_]*\\b"
	highlighter = xs_add_keyword(highlighter, struct_name, struct_pattern)

# call sites: name immediately followed by "(" -- the "(" is part of the match
# since the regex crate has no lookahead
macro shared_highlighting_call
	call_name as "function"
	call_pattern as "\\b[A-Za-z_][A-Za-z0-9_]*\\("
	highlighter = xs_add_keyword(highlighter, call_name, call_pattern)

# same as shared_highlighting_call, but "$" is allowed in the name (JS/TS)
macro shared_highlighting_call_js
	call_name as "function"
	call_pattern as "\\b[A-Za-z_$][A-Za-z0-9_$]*\\("
	highlighter = xs_add_keyword(highlighter, call_name, call_pattern)

# numeric literals, underscores allowed as separators
macro shared_highlighting_number
	num_name as "number"
	num_pattern as "\\b\\d[\\d_]*(\\.[\\d_]+)?\\b"
	highlighter = xs_add_keyword(highlighter, num_name, num_pattern)

# numeric literals, no underscore separators
macro shared_highlighting_number_plain
	num_name as "number"
	num_pattern as "\\b\\d+(\\.\\d+)?\\b"
	highlighter = xs_add_keyword(highlighter, num_name, num_pattern)

# attribute names tight against "=" (className=, onClick=) -- the "=" is
# swallowed into the match since the regex crate has no lookahead
macro shared_highlighting_attr_name
	attr_name as "function"
	attr_pattern as "\\b[a-zA-Z_][a-zA-Z0-9_-]*="
	highlighter = xs_add_keyword(highlighter, attr_name, attr_pattern)

# @decorator / @Annotation
macro shared_highlighting_decorator
	anno_name as "macro_name"
	anno_pattern as "@[A-Za-z_][A-Za-z0-9_.]*"
	highlighter = xs_add_keyword(highlighter, anno_name, anno_pattern)

# entities (&amp; &#169; ...)
macro shared_highlighting_html_entity
	entity_name as "macro_name"
	entity_pattern as "&[A-Za-z#0-9]+;"
	highlighter = xs_add_keyword(highlighter, entity_name, entity_pattern)

# JSX tag names ("<Foo", "</Foo", dotted "<Foo.Bar"), plus the fragment forms
# "<>" and "</>". xs_add_tag also turns on tag scoping -- see the callers.
macro shared_highlighting_jsx_tag
	tag_name as "type"
	tag_pattern as "</?(?:[A-Za-z][A-Za-z0-9_.]*|>)"
	highlighter = xs_add_tag(highlighter, tag_name, tag_pattern)

# lets a bare "{" inside JSX text resume full code scanning until its matching "}"
macro shared_highlighting_jsx_expr
	highlighter = xs_enable_jsx_expr(highlighter)

# TypeScript keywords
macro shared_highlighting_ts_keywords
	kw_name as "keyword"
	kw_pattern as "\\b(abstract|as|asserts|async|await|break|case|catch|class|const|continue|debugger|declare|default|delete|do|else|enum|export|extends|false|finally|for|from|function|get|if|implements|import|in|infer|instanceof|interface|is|keyof|let|module|namespace|new|null|of|out|override|private|protected|public|readonly|return|satisfies|set|static|super|switch|this|throw|true|try|type|typeof|undefined|unique|var|void|while|with|yield)\\b"
	highlighter = xs_add_keyword(highlighter, kw_name, kw_pattern)

# TypeScript builtin primitive/utility types
macro shared_highlighting_ts_builtin_types
	builtin_name as "type"
	builtin_pattern as "\\b(string|number|boolean|any|unknown|never|object|symbol|bigint)\\b"
	highlighter = xs_add_keyword(highlighter, builtin_name, builtin_pattern)
