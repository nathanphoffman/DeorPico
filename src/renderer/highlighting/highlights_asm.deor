# ; to end of line (NASM/MASM/GAS-with-semicolons)
macro asm_highlighting_comment_semicolon
	comment_name as "comment"
	comment_pattern as ";.*"
	highlighter = xs_add_keyword(highlighter, comment_name, comment_pattern)

# labels: a name ending in ":" at the start of a line
macro asm_highlighting_label_at_line_start
	label_name as "function"
	label_pattern as "^[A-Za-z_.][A-Za-z0-9_]*:"
	highlighter = xs_add_keyword(highlighter, label_name, label_pattern)

# x86 registers, case-insensitive
macro asm_highlighting_x86_registers
	reg_name as "type"
	reg_pattern as "(?i)\\b(e?[abcd]x|e?[sd]i|e?[sb]p|r[0-9]+[dwb]?|r[abcd]x|rsi|rdi|rsp|rbp|[abcd][lh])\\b"
	highlighter = xs_add_keyword(highlighter, reg_name, reg_pattern)

# common x86 mnemonics and assembler directives, case-insensitive
macro asm_highlighting_x86_mnemonics_and_directives
	kw_name as "keyword"
	kw_pattern as "(?i)\\b(mov|add|sub|mul|imul|div|idiv|inc|dec|push|pop|call|ret|jmp|je|jne|jg|jl|jge|jle|jz|jnz|cmp|test|lea|nop|and|or|xor|not|shl|shr|int|syscall|section|global|extern|db|dw|dd|dq|equ|times|resb|resw|resd)\\b"
	highlighter = xs_add_keyword(highlighter, kw_name, kw_pattern)

# hex literals (0x1F)
macro asm_highlighting_hex_number
	hex_name as "number"
	hex_pattern as "\\b0[xX][0-9a-fA-F]+\\b"
	highlighter = xs_add_keyword(highlighter, hex_name, hex_pattern)

# decimal literals, or Intel-style hex with a trailing h (0FFh)
macro asm_highlighting_number_with_optional_h_suffix
	num_name as "number"
	num_pattern as "\\b\\d[\\da-fA-F]*[hH]?\\b"
	highlighter = xs_add_keyword(highlighter, num_name, num_pattern)

macro highlights_asm
	macro_run asm_highlighting_comment_semicolon
	macro_run shared_highlighting_string_double
	macro_run asm_highlighting_label_at_line_start
	macro_run asm_highlighting_x86_registers
	macro_run asm_highlighting_x86_mnemonics_and_directives
	macro_run asm_highlighting_hex_number
	macro_run asm_highlighting_number_with_optional_h_suffix
