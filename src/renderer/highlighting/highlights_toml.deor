# table headers: [section] and [[array of tables]] at the start of a line
macro toml_highlighting_table_header_at_line_start
	table_name as "type"
	table_pattern as "^\\s*\\[\\[?[^\\]]*\\]\\]?"
	highlighter = xs_add_keyword(highlighter, table_name, table_pattern)

# '''...''' multi-line literal strings, no escapes -- must run before the plain single-quote rule
macro toml_highlighting_string_triple_single_literal
	name as "string"
	start as "'''"
	stop as "'''"
	BoundedSpec mlstr_spec = (name, start, stop)
	mlstr_escapable as false
	highlighter = xs_add_bounded(highlighter, mlstr_spec, mlstr_escapable)

# keys up to their "=" (bare or quoted) -- must run before the string rules so quoted keys win ties
macro toml_highlighting_key_before_equals
	key_name as "function"
	key_pattern as "(\"[^\"]*\"|'[^']*'|[A-Za-z0-9_-]+)\\s*="
	highlighter = xs_add_keyword(highlighter, key_name, key_pattern)

# the literals true and false
macro toml_highlighting_booleans
	kw_name as "keyword"
	kw_pattern as "\\b(true|false)\\b"
	highlighter = xs_add_keyword(highlighter, kw_name, kw_pattern)

# dates and datetimes (RFC 3339, or a local date/time)
macro toml_highlighting_date_and_time
	date_name as "number"
	date_pattern as "\\b\\d{4}-\\d{2}-\\d{2}([Tt ]\\d{2}:\\d{2}:\\d{2}(\\.\\d+)?([Zz]|[+-]\\d{2}:\\d{2})?)?\\b"
	highlighter = xs_add_keyword(highlighter, date_name, date_pattern)

# hex, octal and binary literals
macro toml_highlighting_hex_octal_binary_number
	radix_name as "number"
	radix_pattern as "\\b0[xX][0-9a-fA-F_]+\\b|\\b0[oO][0-7_]+\\b|\\b0[bB][01_]+\\b"
	highlighter = xs_add_keyword(highlighter, radix_name, radix_pattern)

# decimal/float literals with optional sign, underscores and exponent
macro toml_highlighting_number_with_sign_and_exponent
	num_name as "number"
	num_pattern as "[+-]?\\b\\d[\\d_]*(\\.[\\d_]+)?([eE][+-]?\\d+)?\\b"
	highlighter = xs_add_keyword(highlighter, num_name, num_pattern)

macro highlights_toml
	macro_run shared_highlighting_comment_hash
	macro_run toml_highlighting_table_header_at_line_start
	macro_run shared_highlighting_string_triple_double
	macro_run toml_highlighting_string_triple_single_literal
	macro_run toml_highlighting_key_before_equals
	macro_run shared_highlighting_string_double
	macro_run shared_highlighting_string_single_raw
	macro_run toml_highlighting_booleans
	macro_run toml_highlighting_date_and_time
	macro_run toml_highlighting_hex_octal_binary_number
	macro_run toml_highlighting_number_with_sign_and_exponent
