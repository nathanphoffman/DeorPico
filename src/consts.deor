
# User-configurable numbers (see config.deor / .dpico.example), read once at
# startup. Each is the config key and its default.
unsafe_macro use_consts
	page_key as "page_scroll_lines"
	const int DEFAULT_PAGE_SCROLL_LINES = 30
	page_default as DEFAULT_PAGE_SCROLL_LINES
	int cfg_page_scroll_lines = config_int(page_key, page_default)

	# Must match the tab width the syntax highlighter expands tabs to when producing
	# highlighted lines for display -- used to convert a raw cursor_col
	# (one tab = one character) into the on-screen column (one tab = several).
	tab_key as "tab_width"
	const int DEFAULT_TAB_WIDTH = 4
	tab_default as DEFAULT_TAB_WIDTH
	int cfg_tab_width = config_int(tab_key, tab_default)
	space as " "
	string cfg_tab_string = s_repeat(space, cfg_tab_width)

	arrow_x_key as "ctrl_arrow_columns"
	const int DEFAULT_CTRL_ARROW_COLUMNS = 15
	arrow_x_default as DEFAULT_CTRL_ARROW_COLUMNS
	int cfg_ctrl_arrow_columns = config_int(arrow_x_key, arrow_x_default)
	arrow_y_key as "ctrl_arrow_lines"
	const int DEFAULT_CTRL_ARROW_LINES = 8
	arrow_y_default as DEFAULT_CTRL_ARROW_LINES
	int cfg_ctrl_arrow_lines = config_int(arrow_y_key, arrow_y_default)

	wheel_key as "scroll_wheel_lines"
	const int DEFAULT_SCROLL_WHEEL_LINES = 3
	wheel_default as DEFAULT_SCROLL_WHEEL_LINES
	int cfg_scroll_wheel_lines = config_int(wheel_key, wheel_default)

	# Height of the ctrl+e raw lint output popup -- longer output is
	# cut off rather than making the popup scrollable.
	popup_key as "lint_popup_height"
	const int DEFAULT_LINT_POPUP_HEIGHT = 10
	popup_default as DEFAULT_LINT_POPUP_HEIGHT
	int cfg_lint_popup_height = config_int(popup_key, popup_default)

	# Width of the persistent Files-tree sidebar (see sidebar.deor) --
	# always claims exactly this many columns so the text buffer's own
	# width is predictable frame to frame.
	sidebar_key as "sidebar_width"
	const int DEFAULT_SIDEBAR_WIDTH = 30
	sidebar_default as DEFAULT_SIDEBAR_WIDTH
	int cfg_sidebar_width = config_int(sidebar_key, sidebar_default)

	# Width the sidebar widens to while it has keyboard focus (F1) -- gives
	# long file/directory names more room to display without truncation.
	focused_key as "sidebar_width_focused"
	const int DEFAULT_SIDEBAR_WIDTH_FOCUSED = 46
	focused_default as DEFAULT_SIDEBAR_WIDTH_FOCUSED
	int cfg_sidebar_width_focused = config_int(focused_key, focused_default)

	# One column reserved at the right edge of the text area for the
	# vertical scrollbar (see scrollbar.deor).
	const int SCROLLBAR_WIDTH = 1

# Files bigger than this (in bytes) aren't loaded -- the viewer just says the
# file is too big. Renaming, moving and deleting still work from the sidebar.
fn int max_open_file_bytes()
	mb_key as "max_file_mb"
	const int DEFAULT_MAX_FILE_MB = 25
	mb_default as DEFAULT_MAX_FILE_MB

	return config_int(mb_key, mb_default) * bytes_per_mb()

# Bytes in a megabyte, shared by the open-size limit and the too-large notice.
fn int bytes_per_mb()
	const int BYTES_PER_MB = 1048576

	return BYTES_PER_MB

# Most files the filter lists from one directory (and the number the
# "folder(s) over N files truncated" notice reports).
fn int filter_per_dir_cap()
	const int FILTER_PER_DIR_CAP = 50

	return FILTER_PER_DIR_CAP

# Shared by editor_scroll and editor_render, which must agree exactly on how
# many rows are reserved for chrome (status/notice, the git-diff minimap,
# the lint output popup, the Ctrl+F search bar) -- any mismatch lets the
# cursor scroll past what's actually drawn and the cursor/selection render a
# line off from reality.
fn int editor_reserved_rows(bool has_minimap, bool lint_output_visible, bool search_active)
	unsafe_macro_run use_consts
	int reserved_rows = 2

	if has_minimap
		reserved_rows = reserved_rows + 1

	if lint_output_visible
		reserved_rows = reserved_rows + cfg_lint_popup_height

	if search_active
		reserved_rows = reserved_rows + 1

	return reserved_rows

# The one shared "how many buffer rows fit on screen" formula -- every
# render path and every scroll-clamp (cursor-follow, mouse wheel, paging,
# in both the main editor and the git-diff view) must call this instead of
# recomputing rows - reserved_rows by hand, or they drift out of sync (the
# wheel-scroll and diff-view clamps used to each hardcode their own,
# slightly wrong, reserved-row count). Takes reserved_rows already computed
# (see editor_reserved_rows) rather than the individual chrome flags --
# functions cap out at 3 parameters, and rows plus all of has_minimap/
# lint_output_visible/search_active would be 4.
fn int editor_view_rows(int rows, int reserved_rows)
	int view_rows = rows - reserved_rows

	if view_rows < 1
		view_rows = 1

	return view_rows

# How many screen rows the sidebar's <GIT> section occupies at the top of the
# tree: 0 if this isn't a git repo (section hidden entirely), 1 (just the
# header) if it's collapsed, 2 (header + "clean" placeholder) if it's
# expanded but nothing's changed, or 1 (header) + git_count otherwise.
# Shared by the sidebar's renderer and its nav/scroll/mouse macros, which
# must agree exactly on this or the highlight and scroll position drift
# from what's actually drawn.
fn int sidebar_git_section_rows(bool is_git_repo, int git_count, bool git_collapsed)
	if not is_git_repo
		return 0

	if git_collapsed
		return 1

	if git_count is 0
		return 2

	return 1 + git_count

# How many screen rows the sidebar's <RECENT> section occupies, between the
# <GIT> section and the root row: just its header while collapsed, else the
# header plus one row per recent file. Shared by the renderer and the nav/
# scroll/mouse macros, same reasoning as sidebar_git_section_rows.
fn int sidebar_recent_section_rows(int recent_count, bool recent_collapsed)
	if recent_collapsed
		return 1

	return 1 + recent_count

# The sidebar's root-directory row, pinned directly below the <RECENT>
# section -- always exactly one
# row. Gives ':' filter and ^F create-file something to target even when the
# Files tree itself is completely empty (a brand new directory with nothing
# in it yet). Shared by the sidebar's renderer and its nav/scroll/mouse
# macros, same reasoning as sidebar_git_section_rows.
fn int sidebar_root_section_rows()
	return 1
