# Taking AppState apart and putting it back together by `move` -- the
# alternative, `(main_panel) in state`, copies every line of the file and the
# whole undo history, which adds up when it happens on every key and every
# frame.

# Declares every AppState field as a local (see events.deor for the same
# list). Takes `state` apart: don't use `state` again until
# repack_app_state has put it back.
unsafe_macro unpack_app_state
	move (browser, main_panel, commit_prompt, done, notice, error) in state
	move (core, diff, selection, undo, search, filter, lint) in main_panel
	move (buffer_content, buffer_cursor, buffer_view) in core
	move (filename, lines, synced_content, dirty, too_large) in buffer_content
	move (cursor_row, cursor_col) in buffer_cursor
	move (scroll_row, scroll_wrap_seg, wheel_scrolled, scrollbar_dragging, show_line_numbers) in buffer_view
	move (sidebar_tree, sidebar_git, sidebar_history, sidebar_recent, sidebar_interaction, sidebar_editing) in browser
	move (browse_entries, browse_selected, browse_scroll_row, browse_dir, sidebar_focused) in sidebar_tree
	move (is_git_repo, git_changes, git_selected, git_section_collapsed, git_status_map) in sidebar_git
	move (git_history_level, git_history_commit, git_live_changes) in sidebar_history
	move (recent_paths, recent_section_collapsed, recent_selected) in sidebar_recent
	move (sidebar_on_git, sidebar_on_root, sidebar_on_recent, sidebar_locked, pending_delete_path, pending_discard_path) in sidebar_interaction
	move (creating_file, new_file_name, new_file_cursor, create_parent_dir, renaming_file, rename_original_entry) in sidebar_editing

# The reverse of unpack_app_state: rebuilds `state` from the locals.
macro repack_app_state
	BufferContent buffer_content = move (filename, lines, synced_content, dirty, too_large)
	BufferCursor buffer_cursor = move (cursor_row, cursor_col)
	BufferView buffer_view = move (scroll_row, scroll_wrap_seg, wheel_scrolled, scrollbar_dragging, show_line_numbers)
	BufferState core = move (buffer_content, buffer_cursor, buffer_view)
	SidebarTree sidebar_tree = move (browse_entries, browse_selected, browse_scroll_row, browse_dir, sidebar_focused)
	SidebarGit sidebar_git = move (is_git_repo, git_changes, git_selected, git_section_collapsed, git_status_map)
	SidebarHistory sidebar_history = move (git_history_level, git_history_commit, git_live_changes)
	SidebarRecent sidebar_recent = move (recent_paths, recent_section_collapsed, recent_selected)
	SidebarInteraction sidebar_interaction = move (sidebar_on_git, sidebar_on_root, sidebar_on_recent, sidebar_locked, pending_delete_path, pending_discard_path)
	SidebarEditing sidebar_editing = move (creating_file, new_file_name, new_file_cursor, create_parent_dir, renaming_file, rename_original_entry)
	SidebarState browser = move (sidebar_tree, sidebar_git, sidebar_history, sidebar_recent, sidebar_interaction, sidebar_editing)
	EditorState main_panel = move (core, diff, selection, undo, search, filter, lint)
	AppState repacked_state = move (browser, main_panel, commit_prompt, done, notice, error)
	state = repacked_state

# After editor_render: puts back the visible rows' real text and the real
# undo history that render_frame set aside (see RenderStash).
fn AppState restore_after_render(AppState state, RenderStash stash)
	move (raw_window, window_start, saved_undo) in stash
	move (browser, main_panel, commit_prompt, done, notice, error) in state
	move (core, diff, selection, search, filter, lint) in main_panel
	move (buffer_content, buffer_cursor, buffer_view) in core
	move (filename, lines, synced_content, dirty, too_large) in buffer_content
	move (cursor_row, cursor_col) in buffer_cursor
	move (scroll_row, scroll_wrap_seg, wheel_scrolled, scrollbar_dragging, show_line_numbers) in buffer_view

	# Re-declared through a local copy -- the transpiler doesn't make an
	# unpacked variable mutable on an indexed write alone.
	stringList lines_holder = move lines
	stringList lines = move lines_holder
	int window_len = len(raw_window)

	for offset in range(window_len)
		int row = window_start + offset
		string raw_line = raw_window at offset
		lines at row = raw_line

	UndoState undo = saved_undo
	BufferContent buffer_content = move (filename, lines, synced_content, dirty, too_large)
	BufferCursor buffer_cursor = move (cursor_row, cursor_col)
	BufferView buffer_view = move (scroll_row, scroll_wrap_seg, wheel_scrolled, scrollbar_dragging, show_line_numbers)
	BufferState core = move (buffer_content, buffer_cursor, buffer_view)
	EditorState main_panel = move (core, diff, selection, undo, search, filter, lint)
	AppState next_state = move (browser, main_panel, commit_prompt, done, notice, error)

	return next_state
