
# Spreadsheet-only constants -- kept apart from the editor's use_consts so
# everything spreadsheet-specific lives under src/spreadsheet/.
unsafe_macro use_spreadsheet_consts
	# Columns auto-size to their widest cell (see spreadsheet_column_widths),
	# kept within these bounds -- a cell wider than the max is cut off with
	# "…" (Ctrl+click / ^O shows it in full).
	const int SPREADSHEET_MIN_COLUMN_WIDTH = 3
	const int SPREADSHEET_MAX_COLUMN_WIDTH = 30

	# Drawn before/after every cell -- shared by spreadsheet_render and the
	# spreadsheet mouse handler so a click maps onto the cell actually drawn.
	const string SPREADSHEET_SEPARATOR = " | "

	# Widest the full-cell-text popup gets (border included).
	const int SPREADSHEET_MODAL_MAX_WIDTH = 70

	# Decimal places formula results are shown with (see
	# spreadsheet_round_places_from_lines) -- a .dpv can set its own on a
	# "#round=N" first line, from 0 up to the max.
	const int SPREADSHEET_DEFAULT_ROUND_PLACES = 2
	const int SPREADSHEET_MAX_ROUND_PLACES = 10
	const string SPREADSHEET_ROUND_PREFIX = "#round="

	# The settings row's text before the decimal places, and the width of
	# the editable cell they sit in (see render_spreadsheet_settings_row).
	const string SPREADSHEET_SETTINGS_LABEL = " Round results to ["
	const int SPREADSHEET_PLACES_WIDTH = 3

	# A .dpv's one formula per column, as a CSV row ("#formulas=,,=c1*2")
	# -- see column_formulas.deor.
	const string SPREADSHEET_FORMULAS_PREFIX = "#formulas="

	# A .dpv's highlighted columns, one value per column as a CSV row
	# ("#highlight=,high,low") -- see column_highlights.deor. Alt+H cycles
	# a column through high-is-good, high-is-bad and off.
	const string SPREADSHEET_HIGHLIGHT_PREFIX = "#highlight="
	const string SPREADSHEET_HIGHLIGHT_HIGH_GOOD = "high"
	const string SPREADSHEET_HIGHLIGHT_HIGH_BAD = "low"

	# A .dpv's hidden columns, one mark per column as a CSV row
	# ("#hidden=,hidden") -- see column_hiding.deor. The separator drawn
	# where hidden columns sit is the same width as SPREADSHEET_SEPARATOR,
	# so clicks still map onto the cells drawn.
	const string SPREADSHEET_HIDDEN_PREFIX = "#hidden="
	const string SPREADSHEET_HIDDEN_MARK = "hidden"
	const string SPREADSHEET_HIDDEN_SEPARATOR = " ‖ "
