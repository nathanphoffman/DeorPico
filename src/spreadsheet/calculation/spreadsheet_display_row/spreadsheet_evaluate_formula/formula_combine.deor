
# Does every * and / first, keeping track of the + and - to apply after
# (normal math order) -- running_values/running_ops are what's left.
macro do_multiplication_and_division_first
	int first_idx = 0
	float first_value = term_values at first_idx
	running_values at end = first_value
	int operator_count = len(term_ops)
	for operator_idx in range(operator_count)
		macro_run apply_multiply_divide_or_save_add_subtract

# Then the remaining + and - from left to right, into `total`.
macro do_addition_and_subtraction_left_to_right
	int first_idx = 0
	total = running_values at first_idx
	int sum_count = len(running_ops)
	for sum_idx in range(sum_count)
		macro_run add_or_subtract_next_saved_value

# Works out the formula's result, or #DIV/0.
fn FormulaResult formula_combine(FormulaTerms terms)
	(term_values, term_ops) in terms
	string formula_error = ""
	floatList running_values = empty
	stringList running_ops = empty
	macro_run do_multiplication_and_division_first
	float total = 0.0
	if formula_error is ""
		macro_run do_addition_and_subtraction_left_to_right
	float result_value = total
	return (result_value, formula_error)
