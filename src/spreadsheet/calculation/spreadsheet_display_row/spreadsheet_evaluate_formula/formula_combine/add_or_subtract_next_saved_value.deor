
# One saved + or - and the value after it, applied to the running total.
macro add_or_subtract_next_saved_value
	string sum_operator = running_ops at sum_idx
	int value_idx = sum_idx + 1
	float next_value = running_values at value_idx
	if sum_operator is "+"
		total = total + next_value
	else
		total = total - next_value
