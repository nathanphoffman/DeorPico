
# Expecting a number: "+" / "-" before it are signs ("=-c1", "=c1*-2"),
# any other operator here is an error, a `(` or `|` starts a group (see
# collect_token_into_open_group), anything else must be `c`, `cN`, `n`,
# `N` or a number.
macro read_token_as_sign_or_number
	if token is "-"
		sign = 0.0 - sign
	else if token is "(" or token is "|"
		macro_run open_group
	else if formula_is_operator(token) and token is not "+"
		formula_error = "#ERR"
	else if token is not "+"
		macro_run add_signed_number_to_terms

macro open_group
	stringList no_tokens = empty
	stringList no_openers = empty
	group_tokens = no_tokens
	group_openers = no_openers
	group_openers at end = token
	group_expecting_operand = true

# Looks up the token's value (or why it can't be used), saves it with the
# sign collected before it, and moves on to expecting an operator.
macro add_signed_number_to_terms
	string operand_error = formula_operand_error(token, scope)
	if operand_error is not ""
		formula_error = operand_error
	else
		float operand_value = formula_operand_value(token, scope)
		term_values at end = operand_value
		term_signs at end = sign
		sign = 1.0
		expecting_operand = false
