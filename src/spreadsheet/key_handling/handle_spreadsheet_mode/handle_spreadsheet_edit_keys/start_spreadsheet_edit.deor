
# Enter starts with the cell's text -- or, below the header of a column
# with a formula, that formula (editing any of its cells edits it).
macro start_spreadsheet_edit_with_cell_text
	string initial_text = spreadsheet_cell_value(spreadsheet_rows, spreadsheet_sel_row, spreadsheet_sel_col)
	string column_formula = spreadsheet_column_formula(spreadsheet_column_formulas, spreadsheet_sel_col)
	if spreadsheet_sel_row < 0
		initial_text = c_int_to_string(spreadsheet_round_places)
	else if spreadsheet_sel_row > 0 and column_formula is not ""
		initial_text = column_formula
	macro_run start_spreadsheet_edit

macro start_spreadsheet_edit_replacing_cell
	string initial_text = ""
	macro_run start_spreadsheet_edit
	macro_run edit_spreadsheet_buffer

macro clear_selected_spreadsheet_cell
	string initial_text = ""
	macro_run start_spreadsheet_edit
	macro_run commit_spreadsheet_edit

# Starts editing the selected cell with `initial_text` (declared by the
# caller) already typed in. A sheet with no rows has no cell to edit, but
# the settings row above it can still be.
macro start_spreadsheet_edit
	int row_count = len(spreadsheet_rows)
	if row_count > 0 or spreadsheet_sel_row < 0
		spreadsheet_editing = true
		spreadsheet_edit_buffer = initial_text
