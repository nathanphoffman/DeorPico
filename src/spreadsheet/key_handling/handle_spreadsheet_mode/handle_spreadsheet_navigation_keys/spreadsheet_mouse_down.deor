
# Selects the cell under a click (spreadsheet_owns_key only routes clicks
# right of the sidebar here) and takes keyboard focus off the sidebar.
# Ctrl+click also opens the full-text popup for that cell (term.deor
# flags a ctrl-held click with chr "ctrl").
macro spreadsheet_mouse_down
	unsafe_macro_run locate_spreadsheet_click
	sidebar_focused = false
	if click_on_sheet
		spreadsheet_sel_row = clicked_row
		spreadsheet_sel_col = clicked_col
		if chr is "ctrl" and clicked_row >= 0
			spreadsheet_modal_open = true

# Works out which cell a click landed on. Leaks clicked_row,
# clicked_col and click_on_sheet (false for a click on the status/notice
# rows or below the last data row) to the caller. Screen row 0 is the
# settings row (clicked_row -1); sheet rows start below it.
unsafe_macro locate_spreadsheet_click
	TermSize term_size = xt_size()
	(cols, rows) in term_size
	int clicked_row = spreadsheet_scroll_row + row - 1
	if row is 0
		clicked_row = 0 - 1
	int clicked_col = 0
	macro_run locate_clicked_column
	int view_rows = spreadsheet_view_rows(rows)
	int row_count = len(spreadsheet_rows)
	bool click_on_sheet = row <= view_rows and clicked_row < row_count

# `col` is the raw terminal column, so the sidebar's width comes off first.
macro locate_clicked_column
	int sidebar_width = spreadsheet_sidebar_width(cols, rows, sidebar_focused)
	int content_col = col - sidebar_width
	intList column_widths = sv_column_widths(spreadsheet_view_cache)
	clicked_col = spreadsheet_column_at_x(column_widths, spreadsheet_scroll_col, content_col)
