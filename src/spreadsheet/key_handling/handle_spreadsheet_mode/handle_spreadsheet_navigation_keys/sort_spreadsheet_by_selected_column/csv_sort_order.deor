
# Puts row `row_idx` into one of csv_sort_order's three groups by its cell
# in column `col_idx` as shown (a formula sorts by its result): empty, a
# number (keyed by its value) or text (keyed by its lowercase form).
macro add_row_to_sort_group
	string raw_cell = spreadsheet_cell_value(display_rows, row_idx, col_idx)
	string cell = s_trim(raw_cell)
	if cell is ""
		empty_indices at end = row_idx
	else if s_is_number(cell)
		macro_run add_row_to_number_group
	else
		macro_run add_row_to_text_group

macro add_row_to_number_group
	float number_key = c_string_to_float(cell)
	number_indices at end = row_idx
	number_keys at end = number_key

macro add_row_to_text_group
	string text_key = s_to_lower(cell)
	text_indices at end = row_idx
	text_keys at end = text_key

# Joins the sorted groups after the header: numbers then text ascending,
# text then numbers descending, and empty cells always last.
macro append_sort_groups_in_order
	intList first_group = sorted_numbers
	intList second_group = sorted_text
	if descending
		first_group = sorted_text
		second_group = sorted_numbers
	macro_run append_groups_then_empty_cells

macro append_groups_then_empty_cells
	for row_idx in first_group
		order at end = row_idx
	for row_idx in second_group
		order at end = row_idx
	for row_idx in empty_indices
		order at end = row_idx

# Row indices of `display_rows` (from spreadsheet_display_rows, unrounded)
# in sorted order by column `col_idx`, with the
# header (index 0) always first. Numbers compare numerically, text
# case-insensitively. The sorts are stable (see l_sort_indices_by_*), so
# sorting by one column then another keeps ties in the previous order.
fn intList csv_sort_order(csvRowList display_rows, int col_idx, bool descending)
	intList number_indices = empty
	floatList number_keys = empty
	intList text_indices = empty
	stringList text_keys = empty
	intList empty_indices = empty
	int row_count = len(display_rows)
	int start = 1
	for row_idx in range(start, row_count)
		macro_run add_row_to_sort_group

	intList sorted_numbers = l_sort_indices_by_float(number_indices, number_keys, descending)
	intList sorted_text = l_sort_indices_by_string(text_indices, text_keys, descending)

	intList order = empty
	order at end = 0
	macro_run append_sort_groups_in_order
	return order
