
# Scrolls just far enough that the selected cell is on screen.
macro scroll_spreadsheet_to_selection
	macro_run scroll_spreadsheet_rows_to_selection
	macro_run scroll_spreadsheet_columns_to_selection

# The settings row (-1) is always on screen, so selecting it scrolls back
# to the header.
macro scroll_spreadsheet_rows_to_selection
	TermSize term_size = xt_size()
	(rows) in term_size
	int view_rows = spreadsheet_view_rows(rows)
	int first_row = 0
	int target_row = m_max(spreadsheet_sel_row, first_row)
	if target_row < spreadsheet_scroll_row
		spreadsheet_scroll_row = target_row
	if target_row > spreadsheet_scroll_row + view_rows - 1
		spreadsheet_scroll_row = target_row - view_rows + 1

# Columns are different widths, so this steps the first drawn column right
# one at a time until the selected cell's right edge fits (or it's the
# first column drawn, for a cell wider than the whole screen).
macro scroll_spreadsheet_columns_to_selection
	TermSize term_size = xt_size()
	(cols, rows) in term_size
	int content_width = spreadsheet_content_width(cols, rows, sidebar_focused)
	csvRowList display_rows = spreadsheet_display_rows(spreadsheet_rows, spreadsheet_round_places, spreadsheet_column_formulas)
	intList column_widths = spreadsheet_column_widths(display_rows)
	int column_count = len(column_widths)

	if spreadsheet_sel_col < spreadsheet_scroll_col
		spreadsheet_scroll_col = spreadsheet_sel_col
	if spreadsheet_sel_col < column_count
		int sel_width = column_widths at spreadsheet_sel_col
		for if spreadsheet_scroll_col < spreadsheet_sel_col
			int sel_left_x = spreadsheet_cell_left_x(column_widths, spreadsheet_scroll_col, spreadsheet_sel_col)
			if sel_left_x + sel_width <= content_width
				break
			spreadsheet_scroll_col = spreadsheet_scroll_col + 1
