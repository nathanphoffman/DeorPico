
# main()'s key dispatch: the spreadsheet handles the key itself when it
# owns it (see spreadsheet_owns_key), otherwise the normal editor handler
# does -- after any half-typed cell edit is committed, so e.g. ^S saves
# what was typed. Any change the sheet makes becomes an undo step in the
# editor's history (see spreadsheet_undo.deor) -- recorded before the
# editor handler runs, so ^Z mid-edit undoes the just-committed edit.
# The sheet's view cache is rebuilt if the key changed the sheet -- by the
# sheet's own handler, or here after the editor handler (undo/redo, ^T,
# opening a file, a commit before ^S, ...).
macro spreadsheet_main_main
	stringList lines_before = spreadsheet_lines_before_key(state)
	if spreadsheet_owns_key(state, key)
		state = spreadsheet_handle_key(state, key, lines_before)
		state = spreadsheet_record_undo(state, lines_before)
	else
		string view_settings_before = spreadsheet_view_settings(state)
		state = spreadsheet_commit_pending_edit(state, key)
		state = spreadsheet_record_undo(state, lines_before)
		state = editor_handle_key_for_events(state, key)
		state = spreadsheet_after_undo(state, key)
		state = spreadsheet_refresh_view_cache(move state, lines_before, view_settings_before)

# main()'s key dispatch for a file that isn't a spreadsheet: just the editor
# handler -- the spreadsheet hooks above are all no-ops for it, so skipping
# them saves copying the whole app state several times per key. The one
# exception is the key opening a spreadsheet file (sidebar Enter, ^T, ...),
# which needs the sheet's view cache built, same as at the end of
# spreadsheet_main_main.
macro spreadsheet_after_text_key
	(spreadsheet) in state
	(spreadsheet_active) in spreadsheet
	if spreadsheet_active
		stringList no_lines_before = empty
		string no_view_settings = ""
		state = spreadsheet_refresh_view_cache(move state, no_lines_before, no_view_settings)
