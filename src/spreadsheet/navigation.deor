
# Every key spreadsheet_handle_key receives. While the full-text popup is
# open, any key or click just closes it -- except the mouse_up/mouse_drag
# that finish the very Ctrl+click that opened it.
macro handle_spreadsheet_mode
	if spreadsheet_modal_open
		if kind is not "mouse_up" and kind is not "mouse_drag"
			spreadsheet_modal_open = false
	else
		macro_run handle_spreadsheet_action

# Edits the selected cell or moves the selection. Kinds not listed here
# (cut/paste/undo, ...) are dropped on purpose: they'd act on the text
# buffer behind the sheet.
macro handle_spreadsheet_action
	# Mid-edit, typing keys change the edit text; any other key commits the
	# edit first and then still does its normal move below (Enter moves
	# down, Tab right, a click selects, ...), like a regular spreadsheet.
	if spreadsheet_editing
		if kind is "char" or kind is "paste_text" or kind is "backspace" or kind is "escape"
			macro_run edit_spreadsheet_buffer
		else
			macro_run commit_spreadsheet_edit
	else if kind is "enter"
		string initial_text = spreadsheet_cell_value(spreadsheet_rows, spreadsheet_sel_row, spreadsheet_sel_col)
		macro_run start_spreadsheet_edit
	else if kind is "char" or kind is "paste_text"
		# Typing over a selected cell replaces its contents.
		string initial_text = ""
		macro_run start_spreadsheet_edit
		macro_run edit_spreadsheet_buffer
	else if kind is "backspace" or kind is "delete"
		string initial_text = ""
		macro_run start_spreadsheet_edit
		macro_run commit_spreadsheet_edit

	if not spreadsheet_editing
		macro_run move_spreadsheet_selection

	macro_run clamp_spreadsheet_selection

	# The wheel scrolls the sheet on its own without dragging the selection
	# along, same as the text editor -- everything else (key moves, clicks)
	# pulls the view back to wherever the selected cell is.
	if kind is "mouse_scroll_up" or kind is "mouse_scroll_down"
		macro_run clamp_spreadsheet_scroll
	else
		macro_run scroll_spreadsheet_to_selection

# Selection moves -- only once no edit is in progress (see
# handle_spreadsheet_mode).
macro move_spreadsheet_selection
	unsafe_macro_run use_consts
	TermSize term_size = xt_size()
	(rows) in term_size
	int view_rows = spreadsheet_view_rows(rows)

	if kind is "down" and shift
		bool sort_descending = false
		macro_run sort_spreadsheet_by_selected_column
	else if kind is "up" and shift
		bool sort_descending = true
		macro_run sort_spreadsheet_by_selected_column
	else if kind is "up"
		spreadsheet_sel_row = spreadsheet_sel_row - 1
	else if kind is "down" or kind is "enter"
		spreadsheet_sel_row = spreadsheet_sel_row + 1
	else if kind is "left" or kind is "shift_tab"
		spreadsheet_sel_col = spreadsheet_sel_col - 1
	else if kind is "right" or kind is "tab"
		spreadsheet_sel_col = spreadsheet_sel_col + 1
	else if kind is "page_up"
		spreadsheet_sel_row = spreadsheet_sel_row - view_rows
	else if kind is "page_down"
		spreadsheet_sel_row = spreadsheet_sel_row + view_rows
	else if kind is "home"
		spreadsheet_sel_col = 0
	else if kind is "open_cell"
		int row_count = len(spreadsheet_rows)
		if row_count > 0
			spreadsheet_modal_open = true
	else if kind is "mouse_down"
		macro_run spreadsheet_mouse_down
	else if kind is "mouse_scroll_up"
		spreadsheet_scroll_row = spreadsheet_scroll_row - SCROLL_WHEEL_AMOUNT
	else if kind is "mouse_scroll_down"
		spreadsheet_scroll_row = spreadsheet_scroll_row + SCROLL_WHEEL_AMOUNT

# Keeps the selected cell inside the sheet -- rows can have different cell
# counts, so the column is bounded by the widest row rather than the
# selected row itself (short rows just draw empty cells past their end).
macro clamp_spreadsheet_selection
	int row_count = len(spreadsheet_rows)
	int column_count = spreadsheet_column_count(spreadsheet_rows)
	if spreadsheet_sel_row > row_count - 1
		spreadsheet_sel_row = row_count - 1
	if spreadsheet_sel_row < 0
		spreadsheet_sel_row = 0
	if spreadsheet_sel_col > column_count - 1
		spreadsheet_sel_col = column_count - 1
	if spreadsheet_sel_col < 0
		spreadsheet_sel_col = 0

# Keeps a wheel scroll between the top of the sheet and its last row
# sitting at the bottom of the screen.
macro clamp_spreadsheet_scroll
	TermSize term_size = xt_size()
	(rows) in term_size
	int view_rows = spreadsheet_view_rows(rows)
	int row_count = len(spreadsheet_rows)
	int max_scroll_row = row_count - view_rows
	if spreadsheet_scroll_row > max_scroll_row
		spreadsheet_scroll_row = max_scroll_row
	if spreadsheet_scroll_row < 0
		spreadsheet_scroll_row = 0

# Scrolls just far enough that the selected cell is on screen, both
# vertically (rows) and horizontally (whole columns).
macro scroll_spreadsheet_to_selection
	TermSize term_size = xt_size()
	(cols, rows) in term_size
	int view_rows = spreadsheet_view_rows(rows)
	int content_width = spreadsheet_content_width(cols, rows, sidebar_focused)
	intList column_widths = spreadsheet_column_widths(spreadsheet_rows)

	if spreadsheet_sel_row < spreadsheet_scroll_row
		spreadsheet_scroll_row = spreadsheet_sel_row
	if spreadsheet_sel_row > spreadsheet_scroll_row + view_rows - 1
		spreadsheet_scroll_row = spreadsheet_sel_row - view_rows + 1

	# Columns are different widths, so step the first drawn column right
	# one at a time until the selected cell's right edge fits (or it's the
	# first column drawn, for a cell wider than the whole screen).
	if spreadsheet_sel_col < spreadsheet_scroll_col
		spreadsheet_scroll_col = spreadsheet_sel_col
	int column_count = len(column_widths)
	if spreadsheet_sel_col < column_count
		int sel_width = column_widths at spreadsheet_sel_col
		for if spreadsheet_scroll_col < spreadsheet_sel_col
			int sel_left_x = spreadsheet_cell_left_x(column_widths, spreadsheet_scroll_col, spreadsheet_sel_col)
			if sel_left_x + sel_width <= content_width
				break
			spreadsheet_scroll_col = spreadsheet_scroll_col + 1
