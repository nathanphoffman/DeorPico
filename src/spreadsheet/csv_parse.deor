
# Reading .csv files into spreadsheet_rows.

# One character inside a quoted cell: a lone quote closes the cell's
# quoting, a doubled quote ("") is a literal " (skip_next steps over the
# second one), anything else -- commas included -- is part of the cell.
macro csv_read_quoted_char
	if chr is QUOTE
		macro_run csv_end_quotes_or_read_doubled_quote
	else
		current = s_join([current, chr])

macro csv_end_quotes_or_read_doubled_quote
	int next_idx = idx + 1
	string next_chr = ""
	if next_idx < char_count
		next_chr = line_chars at next_idx
	if next_chr is QUOTE
		current = s_join([current, QUOTE])
		skip_next = true
	else
		in_quotes = false

# One character outside quotes: a quote starts a quoted section, a comma
# ends the current cell, anything else is part of the cell.
macro csv_read_unquoted_char
	if chr is QUOTE
		in_quotes = true
	else if chr is COMMA
		cells at end = current
		current = ""
	else
		current = s_join([current, chr])

# Which file extensions open into the spreadsheet view instead of the
# normal text editor -- checked both at launch (state_init.deor) and on
# every mid-session file open (load_file_into_buffer in browser/keypress/browse_open.deor).
# .dpv ("deor pico values") is DeorPico's own spreadsheet format -- for now
# it's read and written exactly like .csv.
fn bool f_is_spreadsheet_ext(string ext)
	if ext is "csv" or ext is "dpv"
		return true
	return false

# Parses the text buffer's lines, one line per row -- parsing `lines`
# rather than re-reading the file keeps spreadsheet_rows lined up 1:1 with
# `lines`, which commit_spreadsheet_edit relies on to rewrite just the
# edited row's line. See csv_split_line for how each line is split into
# cells. A quoted field spanning multiple lines isn't supported yet (each
# line is still parsed on its own).
fn csvRowList csv_parse_lines(stringList lines)
	csvRowList rows = empty
	for line in lines
		stringList cells = csv_split_line(line)
		rows at end = cells
	return rows

# Splits one CSV line into cells: commas separate cells unless inside
# double quotes, the quotes themselves are dropped, and a doubled quote
# ("") inside a quoted cell is a literal " character.
fn stringList csv_split_line(string line)
	const string QUOTE = "\""
	const string COMMA = ","
	stringList line_chars = s_chars(line)
	int char_count = len(line_chars)

	stringList cells = empty
	string current = ""
	bool in_quotes = false
	bool skip_next = false
	for idx in range(char_count)
		if skip_next
			skip_next = false
		else
			string chr = line_chars at idx
			if in_quotes
				macro_run csv_read_quoted_char
			else
				macro_run csv_read_unquoted_char
	cells at end = current
	return cells

# The reverse of csv_split_line -- joins cells back into one CSV line,
# quoting only the cells that need it (see csv_quote_cell).
fn string csv_join_row(stringList cells)
	const string COMMA = ","
	stringList quoted_cells = empty
	for cell in cells
		string quoted_cell = csv_quote_cell(cell)
		quoted_cells at end = quoted_cell
	return s_join_with(quoted_cells, COMMA)

# Wraps a cell in double quotes (doubling any quotes inside it) when it
# contains a comma or a quote -- otherwise it's written as-is.
fn string csv_quote_cell(string cell)
	const string QUOTE = "\""
	const string DOUBLED_QUOTE = "\"\""
	const string COMMA = ","
	if s_contains(cell, COMMA) or s_contains(cell, QUOTE)
		string escaped = s_replace(cell, QUOTE, DOUBLED_QUOTE)
		return s_join([QUOTE, escaped, QUOTE])
	return cell
