
# Typing into the selected cell. Editing never writes to disk by itself:
# a commit rewrites that row's line in the text buffer's `lines` and marks
# it dirty, so ^S, ^Del, the unsaved-changes gate and the ^T text view all
# keep working exactly as they do for normal text edits.

# Mid-edit, typing keys change the edit text and any other key commits it
# (and then still does its normal move -- see handle_spreadsheet_action).
# Otherwise, a few keys start an edit.
macro handle_spreadsheet_edit_keys
	if spreadsheet_editing
		macro_run continue_spreadsheet_edit
	else
		macro_run start_spreadsheet_edit_for_key

macro continue_spreadsheet_edit
	if kind is "char" or kind is "paste_text" or kind is "backspace" or kind is "escape"
		macro_run edit_spreadsheet_buffer
	else
		macro_run commit_spreadsheet_edit

# Enter edits the cell's current text, typing replaces it, and
# Backspace/Delete clear it straight away.
macro start_spreadsheet_edit_for_key
	if kind is "enter"
		macro_run start_spreadsheet_edit_with_cell_text
	else if kind is "char" or kind is "paste_text"
		macro_run start_spreadsheet_edit_replacing_cell
	else if kind is "backspace" or kind is "delete"
		macro_run clear_selected_spreadsheet_cell

macro start_spreadsheet_edit_with_cell_text
	string initial_text = spreadsheet_cell_value(spreadsheet_rows, spreadsheet_sel_row, spreadsheet_sel_col)
	macro_run start_spreadsheet_edit

macro start_spreadsheet_edit_replacing_cell
	string initial_text = ""
	macro_run start_spreadsheet_edit
	macro_run edit_spreadsheet_buffer

macro clear_selected_spreadsheet_cell
	string initial_text = ""
	macro_run start_spreadsheet_edit
	macro_run commit_spreadsheet_edit

# Starts editing the selected cell with `initial_text` (declared by the
# caller) already typed in. A sheet with no rows has no cell to edit.
macro start_spreadsheet_edit
	int row_count = len(spreadsheet_rows)
	if row_count > 0
		spreadsheet_editing = true
		spreadsheet_edit_buffer = initial_text

# Keys that change the text being typed.
macro edit_spreadsheet_buffer
	if kind is "char"
		spreadsheet_edit_buffer = s_join([spreadsheet_edit_buffer, chr])
	else if kind is "paste_text"
		macro_run append_paste_to_spreadsheet_edit
	else if kind is "backspace"
		macro_run remove_last_spreadsheet_edit_char
	else if kind is "escape"
		macro_run cancel_spreadsheet_edit

# A cell is one line -- pasted line breaks become spaces.
macro append_paste_to_spreadsheet_edit
	const string NEWLINE = "\n"
	const string SPACE = " "
	string pasted = s_replace(chr, NEWLINE, SPACE)
	spreadsheet_edit_buffer = s_join([spreadsheet_edit_buffer, pasted])

macro remove_last_spreadsheet_edit_char
	int keep_count = s_char_count(spreadsheet_edit_buffer) - 1
	if keep_count >= 0
		int buffer_start = 0
		spreadsheet_edit_buffer = s_substring(spreadsheet_edit_buffer, buffer_start, keep_count)

macro cancel_spreadsheet_edit
	spreadsheet_editing = false
	spreadsheet_edit_buffer = ""

# Ends the edit, writing the typed text into the selected cell -- skipped
# (and the buffer stays not-dirty) if the text didn't actually change.
macro commit_spreadsheet_edit
	if spreadsheet_editing
		spreadsheet_editing = false
		string old_value = spreadsheet_cell_value(spreadsheet_rows, spreadsheet_sel_row, spreadsheet_sel_col)
		bool changed = spreadsheet_edit_buffer is not old_value
		int line_count = len(lines)
		if changed and spreadsheet_sel_row < line_count
			macro_run write_edit_into_selected_cell
		spreadsheet_edit_buffer = ""

# Puts the typed text into the selected row's cells, then swaps that row
# into the sheet and its line into `lines`.
macro write_edit_into_selected_cell
	stringList row_cells = spreadsheet_rows at spreadsheet_sel_row
	macro_run pad_row_to_selected_column
	row_cells at spreadsheet_sel_col = spreadsheet_edit_buffer
	macro_run replace_selected_spreadsheet_row

# A row shorter than the selected column gets empty cells added up to it.
macro pad_row_to_selected_column
	int start = len(row_cells)
	int stop = spreadsheet_sel_col + 1
	for in range(start, stop)
		row_cells at end = ""

# Rewrites just the selected row's line in `lines` -- untouched rows keep
# their original formatting. Goes through local copies assigned back,
# since an `at` write alone doesn't make the transpiler declare the
# unpacked spreadsheet_rows/lines mutable.
macro replace_selected_spreadsheet_row
	string row_line = csv_join_row(row_cells)
	csvRowList updated_rows = move spreadsheet_rows
	updated_rows at spreadsheet_sel_row = row_cells
	spreadsheet_rows = move updated_rows
	stringList updated_lines = move lines
	updated_lines at spreadsheet_sel_row = row_line
	lines = move updated_lines
	dirty = true

# The text in one cell, or "" past the end of the sheet or of a short row.
fn string spreadsheet_cell_value(csvRowList rows, int row_idx, int col_idx)
	int row_count = len(rows)
	if row_idx < 0 or row_idx >= row_count
		return ""
	stringList row_cells = rows at row_idx
	int cell_count = len(row_cells)
	if col_idx < 0 or col_idx >= cell_count
		return ""
	return row_cells at col_idx
