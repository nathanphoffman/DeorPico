
# Screen-size math shared by the spreadsheet renderer, its key/scroll
# macros and its mouse handling, so they all agree on what's drawn.

# Cell count of the widest row -- how many columns the sheet has.
fn int spreadsheet_column_count(csvRowList rows)
	int widest = 0
	for row_cells in rows
		int cell_count = len(row_cells)
		if cell_count > widest
			widest = cell_count
	return widest

# Screen rows available for sheet rows -- the spreadsheet view has no
# minimap, lint popup or search bar, just the status and notice lines.
fn int spreadsheet_view_rows(int rows)
	bool has_minimap = false
	bool lint_output_visible = false
	bool search_active = false
	int reserved_rows = editor_reserved_rows(has_minimap, lint_output_visible, search_active)
	return editor_view_rows(rows, reserved_rows)

# Screen columns right of the sidebar -- shared by the renderer and the
# scroll/mouse macros so they agree on what's actually drawn.
fn int spreadsheet_content_width(int cols, int rows, bool sidebar_focused)
	bool show_line_numbers = false
	bool lint_output_visible = false
	bool search_active = false
	int total_line_count = 0
	stringList diff_lines = empty
	EditorLayoutInput layout_input = (rows, cols, total_line_count, show_line_numbers, lint_output_visible, diff_lines, sidebar_focused, search_active)
	EditorLayout layout = compute_editor_layout(layout_input)
	(sidebar_width) in layout
	int content_width = cols - sidebar_width
	if content_width < 1
		content_width = 1
	return content_width

# Screen columns the sidebar takes in the spreadsheet view -- a click at a
# column below this lands in the sidebar, at or above it in the sheet.
fn int spreadsheet_sidebar_width(int cols, int rows, bool sidebar_focused)
	int content_width = spreadsheet_content_width(cols, rows, sidebar_focused)
	return cols - content_width

# Each column's on-screen width: its widest cell (header included),
# clamped to SPREADSHEET_MIN/MAX_COLUMN_WIDTH.
fn intList spreadsheet_column_widths(csvRowList rows)
	unsafe_macro_run use_spreadsheet_consts
	int column_count = spreadsheet_column_count(rows)
	intList widths = empty
	for in range(column_count)
		widths at end = SPREADSHEET_MIN_COLUMN_WIDTH
	for row_cells in rows
		int cell_count = len(row_cells)
		for col_idx in range(cell_count)
			string cell = row_cells at col_idx
			int cell_width = s_char_count(cell)
			int current_width = widths at col_idx
			if cell_width > current_width
				if cell_width > SPREADSHEET_MAX_COLUMN_WIDTH
					cell_width = SPREADSHEET_MAX_COLUMN_WIDTH
				widths at col_idx = cell_width
	return widths

# Content-area x where column `col_idx`'s text starts, with `scroll_col`
# as the first column drawn. Each column is drawn as SEPARATOR + cell, so
# the first one starts right after the leading separator.
fn int spreadsheet_cell_left_x(intList widths, int scroll_col, int col_idx)
	unsafe_macro_run use_spreadsheet_consts
	int separator_width = s_char_count(SPREADSHEET_SEPARATOR)
	int left_x = separator_width
	for walk_col in range(scroll_col, col_idx)
		int walk_width = widths at walk_col
		left_x = left_x + walk_width + separator_width
	return left_x

# The column under content-area x `content_x` -- a click on a separator
# counts toward the cell to its left, and anything past the last column
# resolves to the last column.
fn int spreadsheet_column_at_x(intList widths, int scroll_col, int content_x)
	unsafe_macro_run use_spreadsheet_consts
	int separator_width = s_char_count(SPREADSHEET_SEPARATOR)
	int column_count = len(widths)
	int right_x = separator_width
	for col_idx in range(scroll_col, column_count)
		int col_width = widths at col_idx
		right_x = right_x + col_width + separator_width
		if content_x < right_x
			return col_idx
	return column_count - 1
